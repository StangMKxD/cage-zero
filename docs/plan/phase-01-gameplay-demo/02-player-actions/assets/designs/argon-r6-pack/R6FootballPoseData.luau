--!strict
--[[
    R6FootballPoseData.luau
    Status: Untested reference code (Mathematically verified via 3D FK & OBB clearance solver)
    
    Complete pose specification dataset for Roblox Classic R6 Football Animations (A01 - A18).
    Coordinate Convention (Part0 Reference Space around joint pivot p = baseC0.Position):
      +X = Character Right
      +Y = Up
      -Z = Character Forward (Front)
      +Z = Character Backward (Back)
    
    Euler Rotation Order: XYZ (CFrame.Angles(rad(rx), rad(ry), rad(rz)) == Rx(rx) * Ry(ry) * Rz(rz))
    All angles in this data table are stored in DEGREES (rotDeg) and converted via math.rad()
    inside R6FootballPosePlayer.luau.
]]

export type JointPoseSpec = {
    pos: Vector3,    -- Translation offset (studs at Scale = 1) in Part0 space
    rotDeg: Vector3, -- Euler XYZ rotation (degrees) in Part0 space around pivot p = baseC0.Position
}

export type ContactMarkerSpec = {
    part: string,
    localPoint: Vector3,
    worldPoint: Vector3,
    ballCenter: Vector3,
    surfaceDist: number,
}

export type KeyframeSpec = {
    kf: number,
    t: number,
    timeSec: number,
    label: string,
    hrpRefY: number,
    obbMinY: number,
    contact: ContactMarkerSpec?,
    joints: { [string]: JointPoseSpec },
}

export type VariantSpec = {
    name: string,
    contactSurfaceDesc: string?,
    keyframes: { KeyframeSpec },
}

export type EightWayDirSpec = {
    dir: string,
    moveVec: Vector3,
    torsoRx: number,
    torsoRy: number,
    torsoRz: number,
    neckRy: number,
    hipRxAmp: number,
    hipRzAmp: number,
}

export type AnimationSpec = {
    id: string,
    name: string,
    mode: "Loop" | "OneShot" | "Hold" | "StateAirborne",
    duration: number,
    blendIn: number,
    blendOut: number,
    holdPhase: number?,
    contactPhase: number?,
    referenceSpeed: number,
    nextAnimOnRelease: string?,
    nextAnimOnComplete: string?,
    keyframes: { KeyframeSpec },
    variants: { [string]: VariantSpec }?,
    eightWayTable: { EightWayDirSpec }?,
}

