export type ReferenceFrame = { time: number, travel: Vector3, rotations: { CFrame } }
local frames: { ReferenceFrame } = {}
local times: { number } = {}
for line in DATA:gmatch("[^\r\n]+") do
	local values: { number } = {}
	for token in line:gmatch("%S+") do
		local number = tonumber(token)
		assert(number ~= nil, "Invalid NPCMotion number")
		table.insert(values, number)
	end
	assert(#values == 4 + #PARTS * 3, "NPCMotion frame stride mismatch")
	local rotations: { CFrame } = {}
	for index = 1, #PARTS do
		local offset = 5 + (index - 1) * 3
		table.insert(rotations, CFrame.Angles(values[offset], values[offset + 1], values[offset + 2]))
	end
	assert(#frames == 0 or values[1] > frames[#frames].time, "NPCMotion times must increase")
	table.insert(frames, { time = values[1], travel = Vector3.new(values[2], values[3], values[4]), rotations = table.freeze(rotations) })
	table.insert(times, values[1])
end
assert(#frames == 91 and frames[1].time == 0 and frames[#frames].time == 3, "NPCMotion jump incomplete")
return table.freeze({ Parts = table.freeze(PARTS), Frames = table.freeze(frames), Times = table.freeze(times) })
