local function build(): KeyframeSequence
 local seq=Instance.new("KeyframeSequence");seq.Name=data.name;seq.Loop=true;seq.Priority=Enum.AnimationPriority.Movement
 for _,frame in data.frames do
  local key=Instance.new("Keyframe");key.Time=frame.time
  local root=Instance.new("Pose");root.Name="HumanoidRootPart";root.Weight=0;root.Parent=key
  local poses={}
  for i,name in data.parts do
   local pose=Instance.new("Pose");pose.Name=name;pose.Weight=1
   pose.CFrame=CFrame.new(table.unpack(frame.poses[i]));pose.EasingStyle=Enum.PoseEasingStyle.Cubic;pose.EasingDirection=Enum.PoseEasingDirection.InOut
   pose.Parent=if data.parents[i]==0 then root else poses[data.parents[i]];poses[i]=pose
  end
  for _,marker in data.markers do if math.abs(marker.time-key.Time)<0.0001 then local m=Instance.new("KeyframeMarker");m.Name=marker.name or "FootPlant";m.Value=marker.value or marker.foot or "";m.Parent=key end end
  key.Parent=seq
 end
 return seq
end
return table.freeze({Build=build,Name=data.name,Duration=data.duration})
