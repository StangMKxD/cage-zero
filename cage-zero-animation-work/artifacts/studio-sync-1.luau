1 -0.129\n2.9667 0.0279 -0.1437 -4.9409 -0.06 0.0933 0.0122 -0.7688 0.0861 0.0574 0.6181 -0.2736 0.1204 0.8812 -0.6477 -0.3326 1.2011 0.0129 -0.3104 -0.1071 -0.8252 0.0419 0.5913 0.5002 0.7004 0.6707 -0.1973 0.3519 -0.2302 0.6478 0.0085 0.6069 0.1524 0.0288 -1.0551 -0.0223 -0.1891 0.4868 0.2301 -0.0348 0.8124 -0.2955 0.2475 -0.9873 0.3236 0.0783 0.1743 -0.3328 -0.1153\n3 0.0285 -0.1517 -4.9425 -0.0579 0.0915 0.0045 -0.7645 0.0807 0.0627 0.6061 -0.2685 0.1154 0.8685 -0.6445 -0.3409 1.1906 0.0145 -0.3108 -0.1114 -0.8278 0.0607 0.5997 0.4982 0.6908 0.6553 -0.195 0.349 -0.2352 0.6564 0.012 0.594 0.1594 0.0301 -1.0383 -0.0245 -0.1854 0.4793 0.2247 -0.0326 0.8094 -0.2876 0.2491 -0.9896 0.3044 0.0774 0.1983 -0.3417 -0.1067\n]]\n\nexport type ReferenceFrame = { time: number, travel: Vector3, rotations: { CFrame } }\nlocal frames: { ReferenceFrame } = {}\nlocal times: { number } = {}\nfor line in DATA:gmatch(\"[^\\r\\n]+\") do\n\tlocal values: { number } = {}\n\tfor token in line:gmatch(\"%S+\") do\n\t\tlocal number = tonumber(token)\n\t\tassert(number ~= nil, \"Invalid NPCMotion number\")\n\t\ttable.insert(values, number)\n\tend\n\tassert(#values == 4 + #PARTS * 3, \"NPCMotion frame stride mismatch\")\n\tlocal rotations: { CFrame } = {}\n\tfor index = 1, #PARTS do\n\t\tlocal offset = 5 + (index - 1) * 3\n\t\ttable.insert(rotations, CFrame.Angles(values[offset], values[offset + 1], values[offset + 2]))\n\tend\n\tassert(#frames == 0 or values[1] > frames[#frames].time, \"NPCMotion times must increase\")\n\ttable.insert(frames, { time = values[1], travel = Vector3.new(values[2], values[3], values[4]), rotations = table.freeze(rotations) })\n\ttable.insert(times, values[1])\nend\nassert(#frames == 91 and frames[1].time == 0 and frames[#frames].time == 3, \"NPCMotion jump incomplete\")\nreturn table.freeze({ Parts = table.freeze(PARTS), Frames = table.freeze(frames), Times = table.freeze(times) })\n"},{"disk":"src/client/character/JumpClipData.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","JumpClipData"],"className":"ModuleScript","content":"--!strict\n-- Two non-looped clips from the Owner reference: flight and actual touchdown/recovery.\nlocal Shared = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Shared\")\nlocal Timing = require(Shared.JumpAnimationTiming)\nlocal Support = require(Shared.R15PoseSupport)\nlocal Reference = require(script.Parent.JumpReferenceData)\nlocal PARENTS = {0,1,2,2,4,5,2,7,8,1,10,11,1,13,14}\nlocal Data = {}\n\nfunction Data.PoseAt(time: number, grounded: boolean)\n\tlocal frames = Reference.Frames\n\tlocal i = math.clamp(math.floor(time*30)+1,1,#frames-1)\n\twhile i>1 and frames[i].time>time do i-=1 end\n\twhile i<#frames-1 and frames[i+1].time<time do i+=1 end\n\tlocal a,b = frames[i],frames[i+1]\n\tlocal alpha = math.clamp((time-a.time)/(b.time-a.time),0,1)\n\tlocal pose = {}\n\tfor j,name in Reference.Parts do\n\t\tlocal x,y,z = a.rotations[j]:Lerp(b.rotations[j],alpha):ToEulerAnglesXYZ()\n\t\t-- Owner refinement: hands stay near the waist rather than reaching overhead.\n\t\tif name==\"LeftUpperArm\" or name==\"RightUpperArm\" then\n\t\t\tx=math.clamp(x,-math.rad(8),math.rad(8))\n\t\t\ty=math.clamp(y,-math.rad(10),math.rad(10))\n\t\t\tz=if name==\"LeftUpperArm\" then -math.rad(12) else math.rad(12)\n\t\telseif name==\"LeftLowerArm\" or name==\"RightLowerArm\" then\n\t\t\tx=math.clamp(x,math.rad(25),math.rad(40))\n\t\t\ty=math.clamp(y,-math.rad(8),math.rad(8))\n\t\t\tz=math.clamp(z,-math.rad(8),math.rad(8))\n\t\tend\n\t\tpose[name] = {r=Vector3.new(math.deg(x),math.deg(y),math.deg(z))}\n\tend\n\t-- Real Humanoid flight owns root height/travel; landing support only changes the pose.\n\tpose.LowerTorso.p = Vector3.zero\n\treturn if grounded then Support.Ground(pose) else pose\nend\n\nfunction Data.Build(key: string): KeyframeSequence?\n\tif key~=\"Jump\" and key~=\"Land\" then return nil end\n\tlocal landing = key==\"Land\"\n\tlocal start = if landing then Timing.LandingStart else 0\n\tlocal finish = if landing then Timing.LandingEnd else Timing.LandingStart\n\tlocal seq = Instance.new(\"KeyframeSequence\")\n\tseq.Name = if landing then \"RF02_Land_Ready_R15_v01\" else \"RF02_Jump_Ready_R15_v01\"\n\tseq.Priority = Enum.AnimationPriority.Action\n\tseq.Loop = false\n\tfor _,sample in Reference.Frames do\n\t\tif sample.time<start or sample.time>finish then continue end\n\t\tlocal kf = Instance.new(\"Keyframe\")\n\t\tkf.Time = sample.time-start\n\t\tlocal root = Instance.new(\"Pose\")\n\t\troot.Name = \"HumanoidRootPart\"\n\t\troot.Weight = 0\n\t\troot.Parent = kf\n\t\tlocal pose = Data.PoseAt(sample.time,landing)\n\t\tlocal nodes = {}\n\t\tfor i,name in Reference.Parts do\n\t\t\tlocal p = Instance.new(\"Pose\")\n\t\t\tp.Name = name\n\t\t\tp.Weight = 1\n\t\t\tp.EasingStyle = Enum.PoseEasingStyle.Linear\n\t\t\tlocal s = pose[name]\n\t\t\tp.CFrame = CFrame.new(s.p or Vector3.zero)*CFrame.Angles(math.rad(s.r.X),math.rad(s.r.Y),math.rad(s.r.Z))\n\t\t\tp.Parent = if PARENTS[i]==0 then root else nodes[PARENTS[i]]\n\t\t\tnodes[i] = p\n\t\tend\n\t\tlocal markerName = if landing and sample.time==start then \"Touchdown\"\n\t\t\telseif not landing and sample.time==Timing.Apex then \"Apex\" else nil\n\t\tif markerName then\n\t\t\tlocal marker = Instance.new(\"KeyframeMarker\")\n\t\t\tmarker.Name = markerName\n\t\t\tmarker.Parent = kf\n\t\tend\n\t\tkf.Parent = seq\n\tend\n\treturn seq\nend\n\nreturn table.freeze(Data)\n"},{"disk":"src/client/character/R15LocomotionHelper.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","R15LocomotionHelper"],"className":"ModuleScript","content":"--!strict\n-- src/client/character/R15LocomotionHelper.luau\n-- Locomotion & Animation Track Orchestrator for R15 Characters\n-- Manages five canonical clips: Idle, Walk, Run, Jump, and Land.\n-- Governed by RF02-IDLE-RUNTIME Contract (Latest Owner Scope Lock 2026-10-26).\n\nlocal KeyframeSequenceProvider = game:GetService(\"KeyframeSequenceProvider\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\", 10) :: Folder?\nassert(Shared ~= nil, \"[R15LocomotionHelper] Shared folder missing in ReplicatedStorage\")\nlocal configs = Shared:WaitForChild(\"configs\", 10) :: Folder?\nassert(configs ~= nil, \"[R15LocomotionHelper] configs folder missing in Shared\")\nlocal LocomotionConfigsModule = configs:WaitForChild(\"R15LocomotionConfigs\", 10) :: ModuleScript?\nassert(LocomotionConfigsModule ~= nil, \"[R15LocomotionHelper] R15LocomotionConfigs missing\")\nlocal LocomotionConfigs = require(LocomotionConfigsModule)\n\ntype ClipNameKey = \"Idle\" | \"Walk\" | \"Run\" | \"Jump\" | \"Land\"\n\nexport type TrackCache = {\n\tIdle: AnimationTrack?,\n\tWalk: AnimationTrack?,\n\tRun: AnimationTrack?,\n\tJump: AnimationTrack?,\n\tLand: AnimationTrack?,\n}\n\nexport type RegistrationSources = {\n\tIdle: string,\n\tWalk: string,\n\tRun: string,\n\tJump: string,\n\tLand: string,\n}\n\nlocal cachedStudioTempIds: { [ClipNameKey]: string } = {}\nlocal warnedProductionMissing: { [ClipNameKey]: boolean } = {}\n\nlocal JumpClipData = require(script.Parent:WaitForChild(\"JumpClipData\"))\nlocal R15LocomotionHelper = {}\nlocal JogForwardClipData = require(script.Parent:WaitForChild(\"JogForwardClipData\"))\nlocal FastRunClipData = require(script.Parent:WaitForChild(\"FastRunClipData\"))\n\nlocal function validateClip(clip: Instance, spec: any): (boolean, string?)\n\tif not clip:IsA(\"KeyframeSequence\") then\n\t\treturn false, \"Clip is not a KeyframeSequence\"\n\tend\n\tif clip.Name ~= spec.ClipName then\n\t\treturn false, \"Clip name mismatch: expected \" .. spec.ClipName .. \", got \" .. clip.Name\n\tend\n\tif clip.Loop ~= spec.ExpectedLoop then\n\t\treturn false, \"Clip Loop mismatch: expected \" .. tostring(spec.ExpectedLoop) .. \", got \" .. tostring(clip.Loop)\n\tend\n\tif clip.Priority ~= spec.ExpectedPriority then\n\t\treturn false, \"Clip Priority mismatch: expected \" .. spec.ExpectedPriority.Name .. \", got \" .. clip.Priority.Name\n\tend\n\n\tlocal keyframes = clip:GetKeyframes()\n\tif #keyframes ~= spec.ExpectedKeyframeCount then\n\t\treturn false, string.format(\"Keyframe count mismatch: expected %d, got %d\", spec.ExpectedKeyframeCount, #keyframes)\n\tend\n\n\tlocal minTime = math.huge\n\tlocal maxTime = -math.huge\n\tfor _, kf in ipairs(keyframes) do\n\t\tif kf.Time < minTime then\n\t\t\tminTime = kf.Time\n\t\tend\n\t\tif kf.Time > maxTime then\n\t\t\tmaxTime = kf.Time\n\t\tend\n\tend\n\tlocal duration = maxTime - minTime\n\tif math.abs(duration - spec.ExpectedDuration) > spec.DurationTolerance then\n\t\treturn false, string.format(\"Duration mismatch: expected %.2f, got %.2f\", spec.ExpectedDuration, duration)\n\tend\n\n\tlocal firstKf = keyframes[1]\n\tlocal drivenJoints = 0\n\tfor _, desc in ipairs(firstKf:GetDescendants()) do\n\t\tif desc:IsA(\"Pose\") and desc.Name ~= \"HumanoidRootPart\" then\n\t\t\tdrivenJoints += 1\n\t\tend\n\tend\n\tif drivenJoints ~= spec.ExpectedDrivenJoints then\n\t\treturn false, string.format(\"Driven joints mismatch: expected %d, got %d\", spec.ExpectedDrivenJoints, drivenJoints)\n\tend\n\n\treturn true, nil\nend\n\nlocal function resolveAnimation(key: ClipNameKey): (Animation?, string)\n\tlocal publishedId = LocomotionConfigs.PublishedIds[key]\n\tif publishedId and #publishedId > 0 then\n\t\tlocal anim = Instance.new(\"Animation\")\n\t\tanim.Name = \"R15_\" .. key .. \"_Published\"\n\t\tanim.AnimationId = publishedId\n\t\treturn anim, \"PUBLISHED\"\n\tend\n\n\tif not LocomotionConfigs.IsStudioFallbackAllowed() then\n\t\tif not warnedProductionMissing[key] then\n\t\t\twarn(\"[R15LocomotionHelper] Published AnimationId for \" .. key .. \" is missing. Falling back to native animation in production.\")\n\t\t\twarnedProductionMissing[key] = true\n\t\tend\n\t\treturn nil, \"PRODUCTION_NATIVE_FALLBACK\"\n\tend\n\n\tif cachedStudioTempIds[key] then\n\t\tlocal anim = Instance.new(\"Animation\")\n\t\tanim.Name = \"R15_\" .. key .. \"_StudioFallback\"\n\t\tanim.AnimationId = cachedStudioTempIds[key]\n\t\treturn anim, \"STUDIO_FALLBACK\"\n\tend\n\n\tlocal previewRigs = workspace:FindFirstChild(\"PreviewRigs\")\n\tlocal previewRig = previewRigs and previewRigs:FindFirstChild(\"PreviewRig_R15_Boy_Height30\")\n\tlocal animSaves = previewRig and previewRig:FindFirstChild(\"AnimSaves\")\n\tlocal spec = LocomotionConfigs.Clips[key]\n\tlocal authored = if key == \"Walk\" then JogForwardClipData.Build()\n\t\telseif key == \"Run\" then FastRunClipData.Build() else JumpClipData.Build(key)\n\tlocal clip = authored or (animSaves and animSaves:FindFirstChild(spec.ClipName))\n\n\tif not clip then\n\t\twarn(\"[R15LocomotionHelper] Studio fallback clip not found for \" .. key .. \" (\" .. spec.ClipName .. \")\")\n\t\treturn nil, \"CLIP_NOT_FOUND\"\n\tend\n\n\tlocal isValid, err = validateClip(clip, spec)\n\tif not isValid then\n\t\tif authored then authored:Destroy() end\n\t\twarn(\"[R15LocomotionHelper] Clip validation failed for \" .. key .. \":\", err)\n\t\treturn nil, \"CLIP_VALIDATION_FAILED\"\n\tend\n\n\tlocal ok, tempId = pcall(function()\n\t\treturn KeyframeSequenceProvider:RegisterKeyframeSequence(clip :: KeyframeSequence)\n\tend)\n\n\tif authored then authored:Destroy() end\n\n\tif not ok or not tempId or typeof(tempId) ~= \"string\" or #tempId == 0 then\n\t\twarn(\"[R15LocomotionHelper] Failed to register Studio KeyframeSequence for \" .. key .. \":\", tempId)\n\t\treturn nil, \"REGISTRATION_FAILED\"\n\tend\n\n\tcachedStudioTempIds[key] = tempId\n\tlocal anim = Instance.new(\"Animation\")\n\tanim.Name = \"R15_\" .. key .. \"_StudioFallback\"\n\tanim.AnimationId = tempId\n\treturn anim, \"STUDIO_FALLBACK\"\nend\n\nfunction R15LocomotionHelper.LoadTracks(animator: Animator): (TrackCache, RegistrationSources, { Animation })\n\tlocal tracks: TrackCache = {\n\t\tIdle = nil,\n\t\tWalk = nil,\n\t\tRun = nil,\n\t\tJump = nil,\n\t\tLand = nil,\n\t}\n\tlocal sources: RegistrationSources = {\n\t\tIdle = \"NONE\",\n\t\tWalk = \"NONE\",\n\t\tRun = \"NONE\",\n\t\tJump = \"NONE\",\n\t\tLand = \"NONE\",\n\t}\n\tlocal animInstances: { Animation } = {}\n\n\tlocal keys: { ClipNameKey } = { \"Idle\", \"Walk\", \"Run\", \"Jump\", \"Land\" }\n\tfor _, key in ipairs(keys) do\n\t\tlocal anim, src = resolveAnimation(key)\n\t\tsources[key] = src\n\t\tif anim then\n\t\t\ttable.insert(animInstances, anim)\n\t\t\tlocal spec = LocomotionConfigs.Clips[key]\n\t\t\tlocal ok, track = pcall(function()\n\t\t\t\treturn animator:LoadAnimation(anim)\n\t\t\tend)\n\t\t\tif ok and track then\n\t\t\t\ttrack.Priority = spec.ExpectedPriority\n\t\t\t\ttrack.Looped = spec.ExpectedLoop\n\t\t\t\ttracks[key] = track\n\t\t\telse\n\t\t\t\twarn(\"[R15LocomotionHelper] Failed to load \" .. key .. \" track onto Animator:\", track)\n\t\t\t\tsources[key] = \"LOAD_FAILED\"\n\t\t\tend\n\t\tend\n\tend\n\n\treturn tracks, sources, animInstances\nend\n\nfunction R15LocomotionHelper.CleanupTracks(tracks: TrackCache, animInstances: { Animation })\n\tfor _, track in pairs(tracks) do\n\t\tif track then\n\t\t\tpcall(function()\n\t\t\t\ttrack:Stop(0)\n\t\t\t\ttrack:Destroy()\n\t\t\tend)\n\t\tend\n\tend\n\tfor _, anim in ipairs(animInstances) do\n\t\tpcall(function()\n\t\t\tanim:Destroy()\n\t\tend)\n\tend\n\ttable.clear(animInstances)\nend\n\nreturn table.freeze(R15LocomotionHelper)\n\n--[====[\nPrevious resolver retained at Owner request:\n\tlocal authored = JumpClipData.Build(key)\n]====]\n\n--[====[\nPrevious Jog-only Run trial resolver retained:\n\tlocal authored = if key == \"Run\" then JogForwardClipData.Build() else JumpClipData.Build(key)\n]====]\n"},{"disk":"src/client/character/R15AnimationController.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","R15AnimationController"],"className":"ModuleScript","content":"--!strict\n-- src/client/character/R15AnimationController.luau\n-- Client R15 Animation & Character Lifecycle Controller\n-- Tracks native R15 Animator and Humanoid lifecycle with strict generation and invalidation gates (RF-F22).\n-- Orchestrates full canonical locomotion suite: Idle, Walk, Run, Jump, and Land.\n-- Governed by RF02-IDLE-RUNTIME Contract (Round 1 & Owner Scope Lock 2026-10-26).\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\", 10) :: Folder?\nassert(Shared ~= nil, \"[R15AnimationController] Shared folder missing in ReplicatedStorage\")\nlocal configs = Shared:WaitForChild(\"configs\", 10) :: Folder?\nassert(configs ~= nil, \"[R15AnimationController] configs folder missing in Shared\")\nlocal LocomotionConfigsModule = configs:WaitForChild(\"R15LocomotionConfigs\", 10) :: ModuleScript?\nassert(LocomotionConfigsModule ~= nil, \"[R15AnimationController] R15LocomotionConfigs missing\")\nlocal LocomotionConfigs = require(LocomotionConfigsModule)\n\nlocal JumpConfigsModule = configs:WaitForChild(\"JumpConfigs\", 10) :: ModuleScript?\nlocal JumpConfigs = if JumpConfigsModule then require(JumpConfigsModule) else { JUMP_POWER = 72, EXPECTED_APEX_HEIGHT = 13.2 }\n\nlocal JumpTiming = require(Shared:WaitForChild(\"JumpAnimationTiming\"))\nlocal LocomotionHelper = require(script.Parent:WaitForChild(\"R15LocomotionHelper\"))\n\nlocal isInitialized = false\nlocal currentCharacter: Model? = nil\nlocal currentHumanoid: Humanoid? = nil\nlocal currentAnimator: Animator? = nil\n\nlocal currentTracks: LocomotionHelper.TrackCache = {\n\tIdle = nil,\n\tWalk = nil,\n\tRun = nil,\n\tJump = nil,\n\tLand = nil,\n}\nlocal currentRegistrationSources: LocomotionHelper.RegistrationSources = {\n\tIdle = \"NONE\",\n\tWalk = \"NONE\",\n\tRun = \"NONE\",\n\tJump = \"NONE\",\n\tLand = \"NONE\",\n}\nlocal currentAnimInstances: { Animation } = {}\n\nlocal characterGeneration: number = 0\nlocal activeConnections: { RBXScriptConnection } = {}\nlocal currentRunningSpeed: number = 0\nlocal wasAirborne: boolean = false\nlocal passiveFall = false\nlocal jumpSourceTime = JumpTiming.PushOff\nlocal landingStartedAt = 0\n\nlocal R15AnimationController = {}\n\nlocal function cleanupConnections()\n\tfor _, conn in ipairs(activeConnections) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(activeConnections)\nend\n\nlocal function cleanupAllTracks()\n\tLocomotionHelper.CleanupTracks(currentTracks, currentAnimInstances)\n\tcurrentTracks = {\n\t\tIdle = nil,\n\t\tWalk = nil,\n\t\tRun = nil,\n\t\tJump = nil,\n\t\tLand = nil,\n\t}\n\tcurrentRegistrationSources = {\n\t\tIdle = \"NONE\",\n\t\tWalk = \"NONE\",\n\t\tRun = \"NONE\",\n\t\tJump = \"NONE\",\n\t\tLand = \"NONE\",\n\t}\n\twasAirborne = false\n\tcurrentRunningSpeed = 0\nend\n\nlocal function invalidateCharacterState()\n\tcleanupConnections()\n\tcleanupAllTracks()\n\tcurrentCharacter = nil\n\tcurrentHumanoid = nil\n\tcurrentAnimator = nil\nend\n\nlocal function onCharacterRemoving(character: Model)\n\tif character == currentCharacter then\n\t\tinvalidateCharacterState()\n\tend\nend\n\nlocal function isAirborneState(state: Enum.HumanoidStateType): boolean\n\treturn state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall\nend\n\nlocal function isDisablingState(state: Enum.HumanoidStateType): boolean\n\treturn state == Enum.HumanoidStateType.Climbing\n\t\tor state == Enum.HumanoidStateType.Swimming\n\t\tor state == Enum.HumanoidStateType.Seated\n\t\tor state == Enum.HumanoidStateType.Dead\n\t\tor state == Enum.HumanoidStateType.Physics\n\t\tor state == Enum.HumanoidStateType.PlatformStanding\nend\n\nlocal function updateLocomotionPlayback(thisGen: number)\n\tif characterGeneration ~= thisGen or not currentHumanoid or currentHumanoid.Health <= 0 then\n\t\treturn\n\tend\n\n\tlocal state = currentHumanoid:GetState()\n\n\t-- 1. Disabling states: Climbing, swimming, seated, dead, ragdoll/physics\n\tif isDisablingState(state) then\n\t\twasAirborne = false\n\t\tfor _, track in pairs(currentTracks) do\n\t\t\tif track and track.IsPlaying then\n\t\t\t\ttrack:Stop(LocomotionConfigs.Playback.IdleFadeTime)\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\n\t-- Flight pose is sampled from actual vertical velocity; Freefall includes the rising arc.\n if isAirborneState(state) or (wasAirborne and currentHumanoid.FloorMaterial == Enum.Material.Air) then\n  local entering = not wasAirborne\n  wasAirborne = true\n  for _, key in {\"Idle\",\"Walk\",\"Run\",\"Land\"} do\n   local tr = currentTracks[key]\n   if tr and tr.IsPlaying then tr:Stop(if key == \"Land\" then 0.02 else 0.08) end\n  end\n  local jump = currentTracks.Jump\n  if entering then\n   local root = currentHumanoid.RootPart\n   passiveFall = state == Enum.HumanoidStateType.Freefall and (not root or root.AssemblyLinearVelocity.Y <= JumpConfigs.LEDGE_FALL_MAX_INITIAL_VY)\n   jumpSourceTime = if passiveFall then JumpTiming.DescentHold else JumpTiming.PushOff\n  end\n  if jump and not jump.IsPlaying then\n   jump:Play(LocomotionConfigs.Playback.JumpFadeTime,1,0)\n   jump.TimePosition = jumpSourceTime\n  end\n  return\n end\n\n\t-- 3. Grounded states: Running or Landed\n\tif wasAirborne then\n\t\t-- Just made ground contact after being airborne!\n\t\twasAirborne = false\n\t\tlandingStartedAt = os.clock()\n\t\tif currentCharacter then currentCharacter:SetAttribute(\"JumpAnimationPhase\",\"Land\") end\n\n\t\t-- Stop jump flight pose immediately\n\t\tif currentTracks.Jump and currentTracks.Jump.IsPlaying then\n\t\t\tcurrentTracks.Jump:Stop(0.05)\n\t\tend\n\n\t\t-- Play separate authored Land recovery track once (Action priority)\n\t\tif currentTracks.Land and not currentTracks.Land.IsPlaying then\n\t\t\tcurrentTracks.Land:Play(LocomotionConfigs.Playback.LandFadeTime)\n\t\tend\n\tend\n\n\t-- Base Ground Locomotion Selection (Idle / Walk / Run)\n\tlocal rootPart = currentHumanoid.RootPart\n\tlocal horizVel = if rootPart then Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z).Magnitude else 0\n\tlocal isMoving = (currentHumanoid.MoveDirection.Magnitude > LocomotionConfigs.Playback.MoveDirectionThreshold)\n\t\tor (currentRunningSpeed > LocomotionConfigs.Playback.SpeedStationaryThreshold)\n\t\tor (horizVel > 1.0)\n\n\tif not isMoving then\n\t\t-- Grounded & Stationary: Play Idle, Stop Walk and Run\n\t\tif currentTracks.Walk and currentTracks.Walk.IsPlaying then\n\t\t\tcurrentTracks.Walk:Stop(LocomotionConfigs.Playback.WalkFadeTime)\n\t\tend\n\t\tif currentTracks.Run and currentTracks.Run.IsPlaying then\n\t\t\tcurrentTracks.Run:Stop(LocomotionConfigs.Playback.RunFadeTime)\n\t\tend\n\t\tif currentTracks.Idle and not currentTracks.Idle.IsPlaying then\n\t\t\tcurrentTracks.Idle:Play(LocomotionConfigs.Playback.IdleFadeTime)\n\t\tend\n\telse\n\t\t-- Grounded & Moving: Stop Idle and interrupt Land recovery overlay\n\t\tif currentTracks.Idle and currentTracks.Idle.IsPlaying then\n\t\t\tcurrentTracks.Idle:Stop(LocomotionConfigs.Playback.IdleFadeTime)\n\t\tend\n\t\tif currentTracks.Land and currentTracks.Land.IsPlaying and os.clock()-landingStartedAt >= JumpTiming.LandingMoveBlendAfter then\n\t\t\tcurrentTracks.Land:Stop(LocomotionConfigs.Playback.LandFadeTime)\n\t\tend\n\n\t\tlocal isSprinting = false\n\t\tlocal char = currentCharacter\n\t\tif char and char:GetAttribute(\"IsSprinting\") == true then\n\t\t\tisSprinting = true\n\t\telseif currentHumanoid.WalkSpeed >= LocomotionConfigs.Playback.SprintSpeedThreshold then\n\t\t\tisSprinting = true\n\t\tend\n\n\t\tif isSprinting then\n\t\t\t-- Moving at Sprint speed: Play Run, Stop Walk\n\t\t\tif currentTracks.Walk and currentTracks.Walk.IsPlaying then\n\t\t\t\tcurrentTracks.Walk:Stop(LocomotionConfigs.Playback.WalkFadeTime)\n\t\t\tend\n\t\t\tif currentTracks.Run and not currentTracks.Run.IsPlaying then\n\t\t\t\tcurrentTracks.Run:Play(LocomotionConfigs.Playback.RunFadeTime)\n\t\t\tend\n\t\telse\n\t\t\t-- Moving at normal Walk speed: Play Walk, Stop Run\n\t\t\tif currentTracks.Run and currentTracks.Run.IsPlaying then\n\t\t\t\tcurrentTracks.Run:Stop(LocomotionConfigs.Playback.RunFadeTime)\n\t\t\tend\n\t\t\tif currentTracks.Walk and not currentTracks.Walk.IsPlaying then\n\t\t\t\tcurrentTracks.Walk:Play(LocomotionConfigs.Playback.WalkFadeTime)\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function onCharacterAdded(character: Model)\n\tlocal localPlayer = Players.LocalPlayer\n\tif not localPlayer then\n\t\treturn\n\tend\n\n\t-- Edge Case (3): Reject mismatched or non-current character BEFORE generation increment or invalidation!\n\tif localPlayer.Character ~= character or not character:IsDescendantOf(game) then\n\t\treturn\n\tend\n\n\tcharacterGeneration += 1\n\tlocal thisGen = characterGeneration\n\n\t-- Invalidate previous character state immediately upon new character arriving\n\tinvalidateCharacterState()\n\tcurrentCharacter = character\n\n\t-- Yield to find Humanoid within bounded timeout\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\n\t-- Post-yield generation and hierarchy verification (RF-F22)\n\tif characterGeneration ~= thisGen\n\t\tor localPlayer.Character ~= character\n\t\tor not character:IsDescendantOf(game)\n\t\tor not humanoid\n\t\tor not humanoid:IsDescendantOf(character) then\n\t\treturn\n\tend\n\n\t-- Yield to find Animator within bounded timeout\n\tlocal animator = humanoid:WaitForChild(\"Animator\", 10) :: Animator?\n\n\t-- Post-yield generation and hierarchy verification (RF-F22)\n\tif characterGeneration ~= thisGen\n\t\tor localPlayer.Character ~= character\n\t\tor not character:IsDescendantOf(game)\n\t\tor not humanoid:IsDescendantOf(character)\n\t\tor not animator\n\t\tor not animator:IsDescendantOf(humanoid) then\n\t\treturn\n\tend\n\n\t-- Successfully validated both Humanoid and Animator for this active generation\n\tcurrentHumanoid = humanoid\n\tcurrentAnimator = animator\n\n\t-- Configure native locomotion responsiveness with higher jump configuration\n\thumanoid.UseJumpPower = true\n\thumanoid.JumpPower = JumpConfigs.JUMP_POWER\n\thumanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)\n\n\t-- Load all five canonical locomotion animation tracks via helper\n\tlocal tracks, sources, animInstances = LocomotionHelper.LoadTracks(animator)\n\n\t-- Post-LoadTracks generation verification (RF-F22 hardening)\n\tif characterGeneration ~= thisGen\n\t\tor localPlayer.Character ~= character\n\t\tor not character:IsDescendantOf(game) then\n\t\tLocomotionHelper.CleanupTracks(tracks, animInstances)\n\t\treturn\n\tend\n\n\tcurrentTracks = tracks\n\tcurrentRegistrationSources = sources\n\tcurrentAnimInstances = animInstances\n\n\t-- Invalidate on Humanoid death (RF-F22)\n\tlocal diedConn = humanoid.Died:Connect(function()\n\t\tif characterGeneration == thisGen then\n\t\t\tcleanupAllTracks()\n\t\t\tcurrentAnimator = nil\n\t\t\tcurrentHumanoid = nil\n\t\tend\n\tend)\n\ttable.insert(activeConnections, diedConn)\n\n\t-- Event-driven locomotion and state observers (No render-loop polling)\n\t-- Established BEFORE initial evaluation to ensure no state transition is dropped\n\tlocal moveDirConn = humanoid:GetPropertyChangedSignal(\"MoveDirection\"):Connect(function()\n\t\tif characterGeneration == thisGen then\n\t\t\tupdateLocomotionPlayback(thisGen)\n\t\tend\n\tend)\n\ttable.insert(activeConnections, moveDirConn)\n\n\tlocal speedConn = humanoid:GetPropertyChangedSignal(\"WalkSpeed\"):Connect(function()\n\t\tif characterGeneration == thisGen then\n\t\t\tupdateLocomotionPlayback(thisGen)\n\t\tend\n\tend)\n\ttable.insert(activeConnections, speedConn)\n\n\tlocal runningConn = humanoid.Running:Connect(function(speed: number)\n\t\tif characterGeneration == thisGen then\n\t\t\tcurrentRunningSpeed = speed\n\t\t\tupdateLocomotionPlayback(thisGen)\n\t\tend\n\tend)\n\ttable.insert(activeConnections, runningConn)\n\n\tlocal stateConn = humanoid.StateChanged:Connect(function(_oldState, _newState)\n\t\tif characterGeneration == thisGen then\n\t\t\tupdateLocomotionPlayback(thisGen)\n\t\tend\n\tend)\n\ttable.insert(activeConnections, stateConn)\n\t-- Landed/Running may arrive transiently before actual support is reported.\n\tlocal floorConn = humanoid:GetPropertyChangedSignal(\"FloorMaterial\"):Connect(function()\n\t\tif characterGeneration == thisGen then updateLocomotionPlayback(thisGen) end\n\tend)\n\ttable.insert(activeConnections, floorConn)\n\n\tlocal sprintAttrConn = character:GetAttributeChangedSignal(\"IsSprinting\"):Connect(function()\n\t\tif characterGeneration == thisGen then\n\t\t\tupdateLocomotionPlayback(thisGen)\n\t\tend\n\tend)\n\ttable.insert(activeConnections, sprintAttrConn)\n\n\n -- Apply track timing before Animator evaluates joints (official PreAnimation guidance).\n local animationConn = RunService.PreAnimation:Connect(function()\n  if characterGeneration ~= thisGen or not currentHumanoid or currentHumanoid.Health <= 0 then return end\n  local root = currentHumanoid.RootPart\n  local jump = currentTracks.Jump\n  if wasAirborne and root and jump and jump.IsPlaying then\n   local time,phase = JumpTiming.Sample(root.AssemblyLinearVelocity.Y,JumpConfigs.JUMP_POWER,passiveFall)\n   jumpSourceTime = math.max(jumpSourceTime,time)\n   jump:AdjustSpeed(0)\n   jump.TimePosition = math.min(jumpSourceTime,JumpTiming.DescentHold)\n   character:SetAttribute(\"JumpAnimationSourceTime\",jumpSourceTime)\n   character:SetAttribute(\"JumpAnimationPhase\",phase)\n  elseif currentTracks.Land and currentTracks.Land.IsPlaying and root\n   and os.clock()-landingStartedAt >= JumpTiming.LandingMoveBlendAfter\n   and (currentHumanoid.MoveDirection.Magnitude > 0.01 or Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude > 1) then\n   currentTracks.Land:Stop(LocomotionConfigs.Playback.LandFadeTime)\n  end\n end)\n table.insert(activeConnections,animationConn)\n\n\t-- Initial locomotion evaluation after all observers are active\n\tupdateLocomotionPlayback(thisGen)\nend\n\nfunction R15AnimationController.Init(_timeoutBudget: number?)\n\tif isInitialized then\n\t\treturn\n\tend\n\tisInitialized = true\n\n\tlocal localPlayer = Players.LocalPlayer\n\tassert(localPlayer ~= nil, \"[R15AnimationController] LocalPlayer required for initialization\")\n\n\tlocalPlayer.CharacterAdded:Connect(onCharacterAdded)\n\tlocalPlayer.CharacterRemoving:Connect(onCharacterRemoving)\n\n\ttask.spawn(function()\n\t\tlocal deadline = os.clock() + 10.0\n\t\twhile (not localPlayer.Character or not localPlayer.Character:IsDescendantOf(game)) and os.clock() < deadline do\n\t\t\ttask.wait()\n\t\tend\n\t\tif localPlayer.Character and localPlayer.Character:IsDescendantOf(game) then\n\t\t\tonCharacterAdded(localPlayer.Character)\n\t\tend\n\tend)\nend\n\nfunction R15AnimationController.GetAnimator(): Animator?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentAnimator\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.GetHumanoid(): Humanoid?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentHumanoid\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.GetCharacter(): Model?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentCharacter\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.GetGeneration(): number\n\treturn characterGeneration\nend\n\n-- Idle APIs\nfunction R15AnimationController.GetIdleTrack(): AnimationTrack?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentTracks.Idle\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.IsIdlePlaying(): boolean\n\tif currentTracks.Idle then\n\t\treturn currentTracks.Idle.IsPlaying\n\tend\n\treturn false\nend\n\nfunction R15AnimationController.GetIdleRegistrationSource(): string\n\treturn currentRegistrationSources.Idle\nend\n\n-- Walk APIs\nfunction R15AnimationController.GetWalkTrack(): AnimationTrack?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentTracks.Walk\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.IsWalkPlaying(): boolean\n\tif currentTracks.Walk then\n\t\treturn currentTracks.Walk.IsPlaying\n\tend\n\treturn false\nend\n\nfunction R15AnimationController.GetWalkRegistrationSource(): string\n\treturn currentRegistrationSources.Walk\nend\n\n-- Run APIs\nfunction R15AnimationController.GetRunTrack(): AnimationTrack?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentTracks.Run\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.IsRunPlaying(): boolean\n\tif currentTracks.Run then\n\t\treturn currentTracks.Run.IsPlaying\n\tend\n\treturn false\nend\n\nfunction R15AnimationController.GetRunRegistrationSource(): string\n\treturn currentRegistrationSources.Run\nend\n\n-- Jump APIs\nfunction R15AnimationController.GetJumpTrack(): AnimationTrack?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentTracks.Jump\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.IsJumpPlaying(): boolean\n\tif currentTracks.Jump then\n\t\treturn currentTracks.Jump.IsPlaying\n\tend\n\treturn false\nend\n\nfunction R15AnimationController.GetJumpRegistrationSource(): string\n\treturn currentRegistrationSources.Jump\nend\n\n-- Land APIs\nfunction R15AnimationController.GetLandTrack(): AnimationTrack?\n\tif R15AnimationController.IsR15Ready() then\n\t\treturn currentTracks.Land\n\tend\n\treturn nil\nend\n\nfunction R15AnimationController.IsLandPlaying(): boolean\n\tif currentTracks.Land then\n\t\treturn currentTracks.Land.IsPlaying\n\tend\n\treturn false\nend\n\nfunction R15AnimationController.GetLandRegistrationSource(): string\n\treturn currentRegistrationSources.Land\nend\n\nfunction R15AnimationController.WasAirborne(): boolean\n\treturn wasAirborne\nend\n\nfunction R15AnimationController.IsR15Ready(): boolean\n\tlocal localPlayer = Players.LocalPlayer\n\tif not localPlayer then\n\t\treturn false\n\tend\n\n\tlocal char = currentCharacter\n\tlocal hum = currentHumanoid\n\tlocal anim = currentAnimator\n\n\tif not char or not hum or not anim then\n\t\treturn false\n\tend\n\n\t-- Strict validity checks (RF-F22):\n\t-- 1. Character matches LocalPlayer.Character and is descendant of game/Workspace\n\t-- 2. Humanoid is descendant of Character, is alive (Health > 0), and is RigType R15\n\t-- 3. Animator is descendant of Humanoid\n\tif char ~= localPlayer.Character or not char:IsDescendantOf(game) then\n\t\treturn false\n\tend\n\n\tif not hum:IsDescendantOf(char) or hum.RigType ~= Enum.HumanoidRigType.R15 or hum.Health <= 0 then\n\t\treturn false\n\tend\n\n\tif not anim:IsDescendantOf(hum) then\n\t\treturn false\n\tend\n\n\treturn true\nend\n\nreturn table.freeze(R15AnimationController)\n"},{"disk":"src/shared/configs/R15LocomotionConfigs.luau","studioPath":["ReplicatedStorage","Shared","configs","R15LocomotionConfigs"],"className":"ModuleScript","content":"--!strict\n-- src/shared/configs/R15LocomotionConfigs.luau\n-- Authoritative Consolidated Configuration for R15 Locomotion Animation Runtime\n-- Covers canonical Idle, Walk, Run, Jump, and Land clips.\n-- Governed by RF02-IDLE-RUNTIME Contract (Latest Owner Scope Lock 2026-10-26).\n\nlocal RunService = game:GetService(\"RunService\")\n\nexport type ClipSpec = {\n\tClipName: string,\n\tExpectedKeyframeCount: number,\n\tExpectedDuration: number,\n\tDurationTolerance: number,\n\tExpectedLoop: boolean,\n\tExpectedPriority: Enum.AnimationPriority,\n\tExpectedDrivenJoints: number,\n}\n\nexport type JumpLandmarkSpec = {\n\tDipStart: number,\n\tDipEnd: number,\n\tPushOff: number,\n\tRise: number,\n\tApex: number,\n\tDescentHold: number,\n\tTouchdown: number,\n}\n\nlocal R15LocomotionConfigs = {}\n\nR15LocomotionConfigs.STUDIO_FALLBACK_ENABLED = true\nR15LocomotionConfigs.PREVIEW_RIG_PATH = \"Workspace.PreviewRigs.PreviewRig_R15_Boy_Height30\"\nR15LocomotionConfigs.ANIMSAVES_CONTAINER = \"AnimSaves\"\n\n-- Published Animation IDs: MUST remain nil until officially published to Roblox asset store.\n-- Native animations serve as fallback in production.\nR15LocomotionConfigs.PublishedIds = {\n\tIdle = nil :: string?,\n\tWalk = nil :: string?,\n\tRun = nil :: string?,\n\tJump = nil :: string?,\n\tLand = nil :: string?,\n}\n\nR15LocomotionConfigs.Clips = table.freeze({\n\tIdle = table.freeze({\n\t\tClipName = \"RF02_Idle_Ready_R15_v01\",\n\t\tExpectedKeyframeCount = 9,\n\t\tExpectedDuration = 4.80,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Idle,\n\t\tExpectedDrivenJoints = 15,\n\t}) :: ClipSpec,\n\n\tWalk = table.freeze({\n\t\tClipName = \"RF02_JogForwardMixamo_R15_v01\",\n\t\tExpectedKeyframeCount = 26,\n\t\tExpectedDuration = 25 / 30,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t}) :: ClipSpec,\n\n\tRun = table.freeze({\n\t\tClipName = \"RF02_FastRunMixamo_R15_v01\",\n\t\tExpectedKeyframeCount = 17,\n\t\tExpectedDuration = 16 / 30,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t}) :: ClipSpec,\n\n\tJump = table.freeze({\n\t\tClipName = \"RF02_Jump_Ready_R15_v01\",\n\t\tExpectedKeyframeCount = 46,\n\t\tExpectedDuration = 1.50,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t}) :: ClipSpec,\n\n\tLand = table.freeze({\n\t\tClipName = \"RF02_Land_Ready_R15_v01\",\n\t\tExpectedKeyframeCount = 46,\n\t\tExpectedDuration = 1.50,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t}) :: ClipSpec,\n})\n\n-- Landmark phases of the Owner jump.md split flight sequence\nR15LocomotionConfigs.JumpLandmarks = table.freeze({\n\tDipStart = 0.2,\n\tDipEnd = 0.6,\n\tPushOff = 0.9,\n\tRise = 1.1,\n\tApex = 1.2667,\n\tDescentHold = 1.4667,\n\tTouchdown = 1.5,\n}) :: Jum