local entries = HttpService:JSONDecode([===[[{"disk":"src/shared/configs/DribbleActionConfigs.luau","studioPath":["ReplicatedStorage","Shared","configs","DribbleActionConfigs"],"className":"ModuleScript","content":"--!strict\n-- Owner-approved G hold / discrete ball-lock cuts / R15 dribble animation runtime bindings.\n-- Governed by RF02-DRIBBLE-ANIMATION-INTEGRATION Contract (2026-10-27).\n\nlocal RunService = game:GetService(\"RunService\")\n\nexport type DribbleClipSpec = {\n\tClipName: string,\n\tExpectedKeyframeCount: number,\n\tExpectedDuration: number,\n\tDurationTolerance: number,\n\tExpectedLoop: boolean,\n\tExpectedPriority: Enum.AnimationPriority,\n\tExpectedDrivenJoints: number,\n\tExpectedMarkerCount: number,\n\tControlReleaseTime: number?,\n}\n\nlocal DribbleActionConfigs = {}\n\nDribbleActionConfigs.GOAL_SPEED = 8.0\nDribbleActionConfigs.GOAL_BALL_DISTANCE = 1.95\nDribbleActionConfigs.GOAL_CARRIER_SEPARATION = 1.85\nDribbleActionConfigs.GOAL_INTENT_TIMEOUT = 0.5\nDribbleActionConfigs.INTENT_INTERVAL = 0.1\nDribbleActionConfigs.CUT_REVERSE_ANGLE_DEG = 120\nDribbleActionConfigs.CUT_MOUSE_STEER_DIAG_FRONT_DEG = 34\nDribbleActionConfigs.CUT_MOUSE_STEER_DIAG_BACK_DEG = 88\nDribbleActionConfigs.CUT_MAX_DURATION = 1.2\nDribbleActionConfigs.CUT_FADE_SEC = 0.15\nDribbleActionConfigs.CUT_FADE_OUT_SEC = 0.18\nDribbleActionConfigs.CUT_COOLDOWN_SEC = 0.20\nDribbleActionConfigs.REVERSE_INPUT_GRACE_SEC = 0.25\n\n-- Cuts keep the carrier moving at full normal speed along the locked cut direction until the animation finishes.\nDribbleActionConfigs.CUT_MOVE_SPEED_FACTOR = 1.0\nDribbleActionConfigs.CUT_MOVE_SPEED_FACTOR_REVERSE = 1.0\nDribbleActionConfigs.CUT_SPEED_RECOVERY_PER_SEC = 8.0\n-- Server-side: ball stays on the pre-cut line during wind-up, then slides linearly along the diagonal line once the boot strikes it (TouchL/TouchR).\nDribbleActionConfigs.CUT_BALL_INTENT_GRACE_SEC = 0.08\nDribbleActionConfigs.CUT_BALL_STRIKE_PHASE = 0.36\nDribbleActionConfigs.CUT_BALL_LEAD_WALK = 0.0\nDribbleActionConfigs.CUT_BALL_LEAD_SPRINT = 0.90\nDribbleActionConfigs.CUT_BALL_LEAD_GOAL = 0.0\nDribbleActionConfigs.CUT_LINEAR_TRACK_GAIN = 9.5\nDribbleActionConfigs.CUT_LINEAR_MAX_REL_SPEED = 28.0\n\nDribbleActionConfigs.STUDIO_FALLBACK_ENABLED = true\nDribbleActionConfigs.PREVIEW_RIG_PATH = \"Workspace.PreviewRigs.PreviewRig_R15_Boy_Height30\"\nDribbleActionConfigs.ANIMSAVES_CONTAINER = \"AnimSaves\"\nDribbleActionConfigs.LOOP_FADE_SEC = 0.18\nDribbleActionConfigs.WALK_BASE_SPEED = 16.0\nDribbleActionConfigs.RUN_BASE_SPEED = 32.0\nDribbleActionConfigs.GOAL_BASE_SPEED = 8.0\n\n-- Marker-driven forward touch coordination (bounded, server-validated)\nDribbleActionConfigs.TOUCH_INTENT_COOLDOWN_SEC = 0.08\nDribbleActionConfigs.TOUCH_PULSE_DURATION_SEC = 0.24\nDribbleActionConfigs.TOUCH_PULSE_BOOST_WALK = 0.38\nDribbleActionConfigs.TOUCH_PULSE_BOOST_RUN = 0.62\nDribbleActionConfigs.TOUCH_PULSE_BOOST_CUT = 0.72\nDribbleActionConfigs.TOUCH_PULSE_BOOST_GOAL = 0.18\n-- Orbit / radial speed multiplier when an animation foot-touch marker strikes the ball\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_WALK = 1.65\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_RUN = 2.05\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_CUT = 2.45\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_GOAL = 1.35\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_WALK = 4.5\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_RUN = 8.5\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_CUT = 11.5\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_GOAL = 1.2\n\n-- Published asset IDs remain nil until officially published; Studio uses validated local KeyframeSequences.\nDribbleActionConfigs.PublishedIds = table.freeze({\n\tWalkDribble = nil :: string?,\n\tRunDribble = nil :: string?,\n\tGModeLoop = nil :: string?,\n\tGoalForward = nil :: string?,\n\tGoalBackward = nil :: string?,\n\tGoalLeft = nil :: string?,\n\tGoalRight = nil :: string?,\n\tFrontLeft = nil :: string?,\n\tFrontRight = nil :: string?,\n\tBackLeft = nil :: string?,\n\tBackRight = nil :: string?,\n\tReverseLeft = nil :: string?,\n\tReverseRight = nil :: string?,\n\tGoalReverse = nil :: string?,\n})\n\nDribbleActionConfigs.ApprovedCutAnimations = table.freeze({\n\tFrontLeft = \"RF02_CutDiagFrontLeft_AW_R15_v01\",\n\tFrontRight = \"RF02_CutDiagFrontRight_WD_R15_v01\",\n\tBackLeft = \"RF02_CutDiagBackLeft_AS_R15_v01\",\n\tBackRight = \"RF02_CutDiagBackRight_SD_R15_v01\",\n\tReverseLeft = \"RF02_CutReverse_WS_R15_v01\",\n\tReverseRight = \"RF02_CutReverse_WS_R15_v01\",\n\tGoalReverse = \"RF02_GMode_SoleDragBack_WS_R15_v01\",\n})\n\nDribbleActionConfigs.Clips = table.freeze({\n\tWalkDribble = table.freeze({\n\t\tClipName = \"RF02_WalkDribble_R15_v01\",\n\t\tExpectedKeyframeCount = 209,\n\t\tExpectedDuration = 1.04,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n\n\tRunDribble = table.freeze({\n\t\tClipName = \"RF02_RunDribble_R15_v01\",\n\t\tExpectedKeyframeCount = 145,\n\t\tExpectedDuration = 0.72,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n\n\tGModeLoop = table.freeze({\n\t\tClipName = \"RF02_GMode_SlowControlLoop_R15_v01\",\n\t\tExpectedKeyframeCount = 225,\n\t\tExpectedDuration = 1.12,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n\n\tFrontLeft = table.freeze({\n\t\tClipName = \"RF02_CutDiagFrontLeft_AW_R15_v01\",\n\t\tExpectedKeyframeCount = 137,\n\t\tExpectedDuration = 0.68,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 4,\n\t\tControlReleaseTime = 0.56,\n\t}) :: DribbleClipSpec,\n\n\tFrontRight = table.freeze({\n\t\tClipName = \"RF02_CutDiagFrontRight_WD_R15_v01\",\n\t\tExpectedKeyframeCount = 137,\n\t\tExpectedDuration = 0.68,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 4,\n\t\tControlReleaseTime = 0.56,\n\t}) :: DribbleClipSpec,\n\n\tBackLeft = table.freeze({\n\t\tClipName = \"RF02_CutDiagBackLeft_AS_R15_v01\",\n\t\tExpectedKeyframeCount = 153,\n\t\tExpectedDuration = 0.76,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t\tControlReleaseTime = 0.64,\n\t}) :: DribbleClipSpec,\n\n\tBackRight = table.freeze({\n\t\tClipName = \"RF02_CutDiagBackRight_SD_R15_v01\",\n\t\tExpectedKeyframeCount = 153,\n\t\tExpectedDuration = 0.76,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t\tControlReleaseTime = 0.64,\n\t}) :: DribbleClipSpec,\n\n\tReverseLeft = table.freeze({\n\t\tClipName = \"RF02_CutReverse_WS_R15_v01\",\n\t\tExpectedKeyframeCount = 165,\n\t\tExpectedDuration = 0.82,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t\tControlReleaseTime = 0.68,\n\t}) :: DribbleClipSpec,\n\n\tReverseRight = table.freeze({\n\t\tClipName = \"RF02_CutReverse_WS_R15_v01\",\n\t\tExpectedKeyframeCount = 165,\n\t\tExpectedDuration = 0.82,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t\tControlReleaseTime = 0.68,\n\t}) :: DribbleClipSpec,\n\n\tGoalReverse = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleDragBack_WS_R15_v01\",\n\t\tExpectedKeyframeCount = 149,\n\t\tExpectedDuration = 0.74,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t\tControlReleaseTime = 0.62,\n\t}) :: DribbleClipSpec,\n\n\tGoalForward = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollForward_W_R15_v01\",\n\t\tExpectedKeyframeCount = 129,\n\t\tExpectedDuration = 0.64,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 4,\n\t}) :: DribbleClipSpec,\n\n\tGoalBackward = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollBackward_S_R15_v01\",\n\t\tExpectedKeyframeCount = 129,\n\t\tExpectedDuration = 0.64,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 4,\n\t}) :: DribbleClipSpec,\n\n\tGoalLeft = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollLeft_A_R15_v01\",\n\t\tExpectedKeyframeCount = 193,\n\t\tExpectedDuration = 0.96,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n\n\tGoalRight = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollRight_D_R15_v01\",\n\t\tExpectedKeyframeCount = 193,\n\t\tExpectedDuration = 0.96,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n})\n\nlocal recognizedClipNames: { [string]: boolean } = {\n\tRF02_WalkDribble_R15_v01 = true,\n\tRF02_RunDribble_R15_v01 = true,\n\tRF02_CutDiagFrontLeft_AW_R15_v01 = true,\n\tRF02_CutDiagFrontRight_WD_R15_v01 = true,\n\tRF02_CutDiagBackLeft_AS_R15_v01 = true,\n\tRF02_CutDiagBackRight_SD_R15_v01 = true,\n\tRF02_CutReverse_WS_R15_v01 = true,\n\tRF02_GMode_SlowControlLoop_R15_v01 = true,\n\tRF02_GMode_SoleDragBack_WS_R15_v01 = true,\n\tRF02_GMode_SoleRollForward_W_R15_v01 = true,\n\tRF02_GMode_SoleRollBackward_S_R15_v01 = true,\n\tRF02_GMode_SoleRollLeft_A_R15_v01 = true,\n\tRF02_GMode_SoleRollRight_D_R15_v01 = true,\n}\n\nfunction DribbleActionConfigs.IsRecognizedClipName(clipName: string): boolean\n\treturn recognizedClipNames[clipName] == true\nend\n\nfunction DribbleActionConfigs.IsGoalModeClipName(clipName: string): boolean\n\treturn clipName == \"RF02_GMode_SlowControlLoop_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleDragBack_WS_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollForward_W_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollBackward_S_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollLeft_A_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollRight_D_R15_v01\"\nend\n\nfunction DribbleActionConfigs.IsStudioFallbackAllowed(): boolean\n\treturn DribbleActionConfigs.STUDIO_FALLBACK_ENABLED and RunService:IsStudio()\nend\n\nreturn table.freeze(DribbleActionConfigs)\n"},{"disk":"src/shared/DribbleGeometryHelper.luau","studioPath":["ReplicatedStorage","Shared","DribbleGeometryHelper"],"className":"ModuleScript","content":"--!strict\n-- src/shared/DribbleGeometryHelper.luau\n-- Continuous front-foot control + joint body/cage clearance + jump self-lob\n-- Governed by RF02-DRIBBLE-RECEIVE (2026-10-27 Authoritative Grill Final).\n-- Pure functions over Vector3; the ONLY authority is the server BallService caller.\n-- Assumptions (not measured rig bounds): carrier = upright cylinder radius CARRIER_BODY_RADIUS, ball = sphere BALL_COLLISION_RADIUS.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Constants = require(Shared:WaitForChild(\"Constants\"))\nlocal DribbleConfigs = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"DribbleConfigs\"))\n\nlocal DribbleGeometryHelper = {}\n\nlocal EPS = 1e-4\n\nlocal function horiz(v: Vector3): Vector3\n\treturn Vector3.new(v.X, 0, v.Z)\nend\n\nlocal function safeUnit(v: Vector3, fallback: Vector3): Vector3\n\tlocal m = v.Magnitude\n\tif m > EPS and m == m then\n\t\treturn v / m\n\tend\n\treturn fallback\nend\n\nlocal function clampMag(v: Vector3, maxMag: number): Vector3\n\tlocal m = v.Magnitude\n\tif m > maxMag and m > EPS then\n\t\treturn v * (maxMag / m)\n\tend\n\treturn v\nend\n\n-- Ball-center limits inside the cage box (cage physics itself is untouched).\nlocal function cageLimits(): (number, number)\n\tlocal r = DribbleConfigs.BALL_COLLISION_RADIUS\n\treturn Constants.ARENA_HALF_WIDTH_X - r, Constants.ARENA_HALF_LENGTH_Z - r\nend\n\nlocal function insideCage(x: number, z: number): boolean\n\tlocal mx, mz = cageLimits()\n\treturn math.abs(x) <= mx + 1e-6 and math.abs(z) <= mz + 1e-6\nend\n\nfunction DribbleGeometryHelper.GetCarrierSeparationDistance(): number\n\treturn DribbleConfigs.CARRIER_BODY_RADIUS + DribbleConfigs.BALL_COLLISION_RADIUS + DribbleConfigs.MIN_BODY_SEPARATION_MARGIN\nend\n\n-- Shared feet origin: feet = RootPart.Y - PLAYER_FEET_OFFSET\nfunction DribbleGeometryHelper.GetFeetY(rootY: number): number\n\treturn rootY - DribbleConfigs.PLAYER_FEET_OFFSET\nend\n\n-- Turn slow-down factor for DRIBBLING carriers: 1 at/below threshold (120 deg), MIN at 180 degrees.\nfunction DribbleGeometryHelper.ComputeTurnSpeedFactor(angleRad: number, isSprinting: boolean): number\n\tlocal thresh = math.rad(DribbleConfigs.DRIBBLE_TURN_DIP_THRESHOLD_DEG)\n\tlocal a = math.abs(angleRad)\n\tif a ~= a or a <= thresh then\n\t\treturn 1.0\n\tend\n\tlocal minF = if isSprinting then DribbleConfigs.DRIBBLE_TURN_MIN_FACTOR_SPRINT else DribbleConfigs.DRIBBLE_TURN_MIN_FACTOR_WALK\n\tlocal norm = math.clamp((a - thresh) / (math.pi - thresh), 0, 1)\n\treturn 1.0 - (1.0 - minF) * (norm ^ DribbleConfigs.DRIBBLE_TURN_EXPONENT)\nend\n\n-- Forward micro-touch radial pulse: purely forward along travel direction, zero lateral sway, 0 at rest.\nfunction DribbleGeometryHelper.ComputeMicroTouchOffset(speed: number, isSprinting: boolean, timeSec: number): number\n\tif not DribbleConfigs.MICRO_TOUCH_ENABLED or speed <= DribbleConfigs.MIN_PLAYER_MOVE_SPEED then\n\t\treturn 0.0\n\tend\n\tlocal amp = if isSprinting then DribbleConfigs.MICRO_TOUCH_AMPLITUDE_SPRINT else DribbleConfigs.MICRO_TOUCH_AMPLITUDE_WALK\n\tlocal cad = if isSprinting then DribbleConfigs.MICRO_TOUCH_CADENCE_SPRINT else DribbleConfigs.MICRO_TOUCH_CADENCE_WALK\n\tlocal phase = (timeSec * cad * 2 * math.pi) % (2 * math.pi)\n\t-- Forward-only positive pulse in [0, 1]\n\tlocal pulse = 0.5 * (1 - math.cos(phase))\n\treturn amp * pulse\nend\n\n-- Desired controlled ball position: along leadDir (MoveDirection when moving, body front when idle);\n-- slides to nearest feasible flank when the target is outside the cage; returns (target, flankAngleDeg, infeasible).\nfunction DribbleGeometryHelper.FeasibleFrontTarget(\n\trootPos: Vector3,\n\tleadDir: Vector3,\n\tisSprinting: boolean,\n\tradialOffset: number?,\n\tminSeparation: number?\n): (Vector3, number, boolean)\n\tlocal f = safeUnit(horiz(leadDir), Vector3.new(0, 0, -1))\n\tlocal baseD = if isSprinting then DribbleConfigs.FRONT_DISTANCE_SPRINT else DribbleConfigs.FRONT_DISTANCE_WALK\n\tlocal sep = minSeparation or DribbleGeometryHelper.GetCarrierSeparationDistance()\n\tlocal d = math.max(baseD + (radialOffset or 0), sep)\n\tlocal base = math.atan2(f.Z, f.X)\n\tlocal steps = DribbleConfigs.FLANK_ANGLE_STEPS\n\tlocal stepRad = 2 * math.pi / steps\n\tfor _, radius in ipairs({ d, sep }) do\n\t\tfor k = 0, steps // 2 do\n\t\t\tfor _, sgn in ipairs({ 1, -1 }) do\n\t\t\t\tif k == 0 and sgn == -1 then\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tlocal ang = base + sgn * k * stepRad\n\t\t\t\tlocal x = rootPos.X + math.cos(ang) * radius\n\t\t\t\tlocal z = rootPos.Z + math.sin(ang) * radius\n\t\t\t\tif insideCage(x, z) then\n\t\t\t\t\treturn Vector3.new(x, rootPos.Y, z), math.deg(k * stepRad), false\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tlocal mx, mz = cageLimits()\n\tlocal clamped = Vector3.new(math.clamp(rootPos.X + f.X * d, -mx, mx), rootPos.Y, math.clamp(rootPos.Z + f.Z * d, -mz, mz))\n\treturn clamped, 180, true\nend\n\nlocal function wrapAngle(a: number): number\n\treturn (a + math.pi) % (2 * math.pi) - math.pi\nend\n\n-- Polar front tracking: the ball ORBITS the carrier (bounded angular speed, bounded radial speed, radius never below the\n-- clearance ring) toward the target, carried with the carrier velocity so it genuinely travels. Because the relative\n-- motion is an arc around the body, the ball never crosses the torso while swinging between back/side/front.\n-- Returns the absolute ball velocity for this step (displacement = velocity * dt before friction/cage).\nfunction DribbleGeometryHelper.ComputeFrontVelocity(\n\trootPos: Vector3,\n\tcarrierVel: Vector3,\n\tballPos: Vector3,\n\ttarget: Vector3,\n\tdt: number,\n\tminSeparation: number?\n): Vector3\n\tlocal sep = minSeparation or DribbleGeometryHelper.GetCarrierSeparationDistance()\n\tlocal rel = horiz(ballPos - rootPos)\n\tlocal tRel = horiz(target - rootPos)\n\tlocal rt = math.max(tRel.Magnitude, sep)\n\tlocal thetaT = if tRel.Magnitude > EPS then math.atan2(tRel.Z, tRel.X) else 0\n\tlocal r = rel.Magnitude\n\tlocal thetaB = if r > 0.05 then math.atan2(rel.Z, rel.X) else thetaT\n\tif r <= 0.05 then\n\t\tr = sep\n\t\trel = Vector3.new(math.cos(thetaB) * r, 0, math.sin(thetaB) * r)\n\tend\n\tlocal step = math.clamp(dt, 0.001, 0.1)\n\n\tlocal dTheta = wrapAngle(thetaT - thetaB)\n\tlocal maxAng = DribbleConfigs.FRONT_MAX_ANGULAR_SPEED * step\n\tlocal stepTheta = math.clamp(dTheta * DribbleConfigs.FRONT_ANGULAR_GAIN * step, -maxAng, maxAng)\n\tif math.abs(stepTheta) > math.abs(dTheta) then\n\t\tstepTheta = dTheta\n\tend\n\n\tlocal dR = rt - r\n\tlocal maxRad = DribbleConfigs.FRONT_RADIAL_MAX_SPEED * step\n\tlocal stepR = math.clamp(dR * DribbleConfigs.FRONT_RADIAL_GAIN * step, -maxRad, maxRad)\n\tif math.abs(stepR) > math.abs(dR) then\n\t\tstepR = dR\n\tend\n\n\tlocal newR = math.max(r + stepR, sep)\n\tlocal newTheta = thetaB + stepTheta\n\tlocal relNew = Vector3.new(math.cos(newTheta) * newR, 0, math.sin(newTheta) * newR)\n\tlocal relVel = clampMag((relNew - rel) / step, DribbleConfigs.FRONT_MAX_REL_SPEED)\n\treturn clampMag(horiz(carrierVel) + relVel, DribbleConfigs.MAX_BALL_DRIBBLE_SPEED)\nend\n\n-- Compute initial 3D velocity for Jump Self-Lob (Scoop).\n-- Moving uses verified horizontal momentum; stationary uses horizontal launchDir (from camera look).\nfunction DribbleGeometryHelper.ComputeSelfLobVelocity(\n\tlaunchDir: Vector3,\n\tcarrierHorizVel: Vector3,\n\tisMoving: boolean\n): Vector3\n\tlocal f = safeUnit(horiz(launchDir), Vector3.new(0, 0, -1))\n\tlocal vH: number\n\tif isMoving then\n\t\tlocal curSpeed = horiz(carrierHorizVel).Magnitude\n\t\tvH = math.clamp(\n\t\t\tcurSpeed * DribbleConfigs.SELF_LOB_MOMENTUM_FACTOR,\n\t\t\tDribbleConfigs.SELF_LOB_MIN_HORIZONTAL_SPEED,\n\t\t\tDribbleConfigs.SELF_LOB_MAX_HORIZONTAL_SPEED\n\t\t)\n\telse\n\t\tvH = DribbleConfigs.SELF_LOB_MIN_HORIZONTAL_SPEED\n\tend\n\treturn Vector3.new(f.X * vH, DribbleConfigs.SELF_LOB_UPWARD_SPEED, f.Z * vH)\nend\n\nlocal function reflectInward(n: Vector3, vRel: Vector3): Vector3\n\tlocal vn = vRel.X * n.X + vRel.Z * n.Z\n\tif vn < 0 then\n\t\treturn vRel - n * ((1 + DribbleConfigs.BODY_CONTACT_RESTITUTION) * vn)\n\tend\n\treturn vRel\nend\n\n-- Joint swept body + cage resolution for one step. Returns (pos, vel, adjusted, infeasible).\n-- 1) vertical-disjoint balls untouched; 2) exact first time-of-impact vs body circle; 3) cage feasibility with\n-- feasible-flank ring search (never pushes through walls, never teleports beyond one ring correction).\nfunction DribbleGeometryHelper.ResolveBodyCage(\n\tp0: Vector3,\n\tp1: Vector3,\n\tb0: Vector3,\n\tb1: Vector3,\n\tvb: Vector3,\n\tvp: Vector3,\n\tdt: number,\n\tfacing: Vector3,\n\tminSeparation: number?\n): (Vector3, Vector3, boolean, boolean)\n\tlocal dT = minSeparation or DribbleGeometryHelper.GetCarrierSeparationDistance()\n\tlocal ballR = DribbleConfigs.BALL_COLLISION_RADIUS\n\tlocal feet = DribbleGeometryHelper.GetFeetY(p1.Y)\n\tif math.max(feet, b1.Y - ballR) > math.min(feet + DribbleConfigs.BODY_HEIGHT, b1.Y + ballR) then\n\t\treturn b1, vb, false, false\n\tend\n\n\tlocal fU = safeUnit(horiz(facing), Vector3.new(0, 0, -1))\n\tlocal s0 = Vector3.new(b0.X - p0.X, 0, b0.Z - p0.Z)\n\tlocal s1 = Vector3.new(b1.X - p1.X, 0, b1.Z - p1.Z)\n\tlocal ds = s1 - s0\n\tlocal a = ds.X * ds.X + ds.Z * ds.Z\n\tlocal b = 2 * (s0.X * ds.X + s0.Z * ds.Z)\n\tlocal c = (s0.X * s0.X + s0.Z * s0.Z) - dT * dT\n\n\tlocal adjusted = false\n\tlocal s1c = s1\n\tlocal vbc = vb\n\tlocal vpH = horiz(vp)\n\n\tif c <= 0 then\n\t\tadjusted = true\n\t\tlocal d0 = s0.Magnitude\n\t\tlocal n = safeUnit(s0, fU)\n\t\tlocal sC = n * (d0 + math.min(dT - d0, DribbleConfigs.MAX_OVERLAP_SEPARATION_STEP))\n\t\tlocal vr = reflectInward(n, Vector3.new(vb.X - vp.X, 0, vb.Z - vp.Z))\n\t\tlocal o = vr.X * n.X + vr.Z * n.Z\n\t\tif o < DribbleConfigs.OVERLAP_RECOVERY_PUSH_SPEED then\n\t\t\tvr = vr + n * (DribbleConfigs.OVERLAP_RECOVERY_PUSH_SPEED - math.max(0, o))\n\t\tend\n\t\ts1c = sC + vr * dt\n\t\tlocal l = s1c.Magnitude\n\t\tif l < dT then\n\t\t\ts1c = if l > EPS then s1c * (dT / l) else n * dT\n\t\tend\n\t\tvbc = Vector3.new(vpH.X + vr.X, vb.Y, vpH.Z + vr.Z)\n\telseif b < 0 and a > 1e-8 then\n\t\tlocal disc = b * b - 4 * a * c\n\t\tif disc >= 0 then\n\t\t\tlocal t = (-b - math.sqrt(disc)) / (2 * a)\n\t\t\tif t >= 0 and t <= 1 then\n\t\t\t\tadjusted = true\n\t\t\t\tlocal sC = s0 + ds * t\n\t\t\t\tlocal n = safeUnit(sC, fU)\n\t\t\t\tlocal vr = reflectInward(n, if dt > EPS then ds / dt else Vector3.zero)\n\t\t\t\ts1c = sC + vr * ((1 - t) * dt)\n\t\t\t\tlocal l = s1c.Magnitude\n\t\t\t\tif l < dT then\n\t\t\t\t\ts1c = if l > EPS then s1c * (dT / l) else n * dT\n\t\t\t\tend\n\t\t\t\tvbc = Vector3.new(vpH.X + vr.X, vb.Y, vpH.Z + vr.Z)\n\t\t\tend\n\t\tend\n\tend\n\n\tlocal cx, cz = p1.X + s1c.X, p1.Z + s1c.Z\n\tlocal infeasible = false\n\tif not insideCage(cx, cz) then\n\t\tadjusted = true\n\t\tlocal mx, mz = cageLimits()\n\t\tlocal clx, clz = math.clamp(cx, -mx, mx), math.clamp(cz, -mz, mz)\n\t\tlocal vx, vz = vbc.X, vbc.Z\n\t\tif clx ~= cx and ((clx > 0 and vx > 0) or (clx < 0 and vx < 0)) then\n\t\t\tvx = 0\n\t\tend\n\t\tif clz ~= cz and ((clz > 0 and vz > 0) or (clz < 0 and vz < 0)) then\n\t\t\tvz = 0\n\t\tend\n\t\tvbc = Vector3.new(vx, vbc.Y, vz)\n\t\tlocal dx, dz = clx - p1.X, clz - p1.Z\n\t\tif math.sqrt(dx * dx + dz * dz) >= dT - 1e-6 then\n\t\t\tcx, cz = clx, clz\n\t\telse\n\t\t\t-- Body and wall conflict: choose the feasible ring point nearest to the clamped ball\n\t\t\tlocal best, bestD = nil, math.huge\n\t\t\tlocal steps = DribbleConfigs.FLANK_ANGLE_STEPS\n\t\t\tfor i = 0, steps - 1 do\n\t\t\t\tlocal ang = i * 2 * math.pi / steps\n\t\t\t\tlocal qx, qz = p1.X + math.cos(ang) * dT, p1.Z + math.sin(ang) * dT\n\t\t\t\tif insideCage(qx, qz) then\n\t\t\t\t\tlocal dd = (qx - clx) ^ 2 + (qz - clz) ^ 2\n\t\t\t\t\tif dd < bestD then\n\t\t\t\t\t\tbestD = dd\n\t\t\t\t\t\tbest = Vector3.new(qx, 0, qz)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif best then\n\t\t\t\tcx, cz = best.X, best.Z\n\t\t\t\tlocal n = safeUnit(Vector3.new(cx - p1.X, 0, cz - p1.Z), fU)\n\t\t\t\tlocal vr = reflectInward(n, Vector3.new(vbc.X - vp.X, 0, vbc.Z - vp.Z))\n\t\t\t\tvbc = Vector3.new(vpH.X + vr.X, vbc.Y, vpH.Z + vr.Z)\n\t\t\telse\n\t\t\t\tcx, cz = clx, clz\n\t\t\t\tinfeasible = true\n\t\t\tend\n\t\tend\n\tend\n\n\treturn Vector3.new(cx, b1.Y, cz), vbc, adjusted, infeasible\nend\n\nreturn DribbleGeometryHelper\n"},{"disk":"src/client/character/SprintCutReferenceData.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","SprintCutReferenceData"],"className":"ModuleScript","content":"--!s