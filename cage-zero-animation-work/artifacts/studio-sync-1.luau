9837512969971,-0.8219239711761475],[9.99999993922529e-9,-1.999999987845058e-8,-9.99999993922529e-9,-0.9968305826187134,-0.07351592183113098,-0.030382659286260605,-0.0791562870144844,0.9545462727546692,0.28735971450805664,0.007876429706811905,0.28885209560394287,-0.9573418498039246],[9.000000034120603e-8,-0.000001259999976355175,-1.3000000365082087e-7,-0.9899408221244812,0.08954689651727676,0.10951212048530579,0.11864686012268066,0.9471533298492432,0.2980279326438904,-0.07704009860754013,0.308027058839798,-0.9482407569885254],[-6.999999868639861e-8,-3.7999998880877683e-7,-0.0000028199999633216066,0.9965750575065613,0.035934749990701675,0.07447562366724014,0.03445662930607796,0.6381940841674805,-0.769093930721283,-0.07517345249652863,0.7690452933311462,0.6347719430923462],[-1.700000069604357e-7,-9.899999895424116e-7,3.999999975690116e-8,-0.9834957122802734,0.10677334666252136,-0.14607049524784088,0.17650674283504486,0.7435291409492493,-0.6449775099754333,0.03974488005042076,-0.6601370573043823,-0.7501028180122375]]}],\"parts\":[\"LowerTorso\",\"UpperTorso\",\"Head\",\"LeftUpperArm\",\"LeftLowerArm\",\"LeftHand\",\"RightUpperArm\",\"RightLowerArm\",\"RightHand\",\"LeftUpperLeg\",\"LeftLowerLeg\",\"LeftFoot\",\"RightUpperLeg\",\"RightLowerLeg\",\"RightFoot\"]}]===])\nlocal function build(): KeyframeSequence\n local seq=Instance.new(\"KeyframeSequence\");seq.Name=data.name;seq.Loop=true;seq.Priority=Enum.AnimationPriority.Movement\n for _,frame in data.frames do\n  local key=Instance.new(\"Keyframe\");key.Time=frame.time\n  local root=Instance.new(\"Pose\");root.Name=\"HumanoidRootPart\";root.Weight=0;root.Parent=key\n  local poses={}\n  for i,name in data.parts do\n   local pose=Instance.new(\"Pose\");pose.Name=name;pose.Weight=1\n   pose.CFrame=CFrame.new(table.unpack(frame.poses[i]));pose.EasingStyle=Enum.PoseEasingStyle.Cubic;pose.EasingDirection=Enum.PoseEasingDirection.InOut\n   pose.Parent=if data.parents[i]==0 then root else poses[data.parents[i]];poses[i]=pose\n  end\n  for _,marker in data.markers do if math.abs(marker.time-key.Time)<0.0001 then local m=Instance.new(\"KeyframeMarker\");m.Name=marker.name or \"FootPlant\";m.Value=marker.value or marker.foot or \"\";m.Parent=key end end\n  key.Parent=seq\n end\n return seq\nend\nreturn table.freeze({Build=build,Name=data.name,Duration=data.duration})\n"},{"disk":"src/client/character/ShotChargeClipData.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","ShotChargeClipData"],"className":"ModuleScript","content":"--!strict\n-- Dedicated balanced backswing. The shot reference supplies arm shape and key timing;\n-- release/contact animation and server foot-contact model remain separate.\nlocal Shared = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Shared\")\nlocal Config = require(Shared.configs.ShotConfigs)\nlocal Reference = require(Shared.ShotReferenceData)\nlocal ShotModel = require(Shared.ShotModel)\nlocal Support = require(Shared.R15PoseSupport)\nlocal Charge = {}\ntype Sample = {p: Vector3?, r: Vector3}\ntype PoseMap = {[string]: Sample}\nlocal parents = {0,1,2,2,4,5,2,7,8,1,10,11,1,13,14}\n\nfunction Charge.PoseAt(time: number): PoseMap\n\tlocal pose = ShotModel.PoseAt(0.08)\n\tlocal u = math.clamp(time / Config.ChargeHoldAt, 0, 1)\n\tlocal a = u*u*u*(10 + u*(-15 + 6*u))\n\tpose.LowerTorso = {p = Vector3.zero, r = Vector3.new(-2,-3,0)}\n\tpose.UpperTorso = {r = Vector3.new(-3-a, 5+3*a, 0)}\n\tpose.Head = {r = Vector3.new(5+a,-2-3*a,0)}\n\tpose.LeftUpperLeg = {r = Vector3.new(7,0,-3)}\n\tpose.LeftLowerLeg = {r = Vector3.new(-12,0,0)}\n\tpose.LeftFoot = {r = Vector3.new(7,0,0)}\n\tpose.RightUpperLeg = {r = Vector3.new(4-26*a,5*a,3*a)}\n\tpose.RightLowerLeg = {r = Vector3.new(-8-74*a,0,0)}\n\tpose.RightFoot = {r = Vector3.new(4+20*a,0,0)}\n\tfor _, side in {\"Left\", \"Right\"} do\n\t\tlocal arm = pose[side..\"UpperArm\"].r\n\t\tlocal elbow = pose[side..\"LowerArm\"].r\n\t\tpose[side..\"UpperArm\"] = {r = Vector3.new(math.clamp(arm.X,-15,18),\n\t\t\tmath.clamp(arm.Y,-12,12), if side==\"Left\" then -22 else 24)}\n\t\tpose[side..\"LowerArm\"] = {r = Vector3.new(math.clamp(elbow.X,35,55),\n\t\t\tmath.clamp(elbow.Y,-8,8),math.clamp(elbow.Z,-6,6))}\n\t\tpose[side..\"Hand\"] = {r = Vector3.zero}\n\tend\n\treturn Support.Ground(pose)\nend\n\nfunction Charge.Build(moving: boolean): KeyframeSequence\n\tlocal sequence = Instance.new(\"KeyframeSequence\")\n\tsequence.Name = if moving then Config.MovingChargeClipName else Config.ChargeClipName\n\tsequence.Priority = Enum.AnimationPriority.Action2\n\tsequence.Loop = false\n\tlocal times = {}\n\tfor _, sourceTime in Reference.Times do\n\t\tlocal t = sourceTime / Config.PlaybackRate\n\t\tif t < Config.ChargeHoldAt then table.insert(times,t) end\n\tend\n\ttable.insert(times,Config.ChargeHoldAt)\n\ttable.insert(times,0.6) -- Hold before the clip end; do not freeze an arbitrary shot frame.\n\tfor _, t in times do\n\t\tlocal frame = Instance.new(\"Keyframe\");frame.Time=t\n\t\tlocal root = Instance.new(\"Pose\");root.Name=\"HumanoidRootPart\";root.Weight=0;root.Parent=frame\n\t\tlocal pose = Charge.PoseAt(t)\n\t\tlocal built: {Pose} = {}\n\t\tfor i, name in Reference.Parts do\n\t\t\tlocal sample = pose[name]\n\t\t\tlocal p = Instance.new(\"Pose\");p.Name=name\n\t\t\tp.CFrame = CFrame.new(sample.p or Vector3.zero)\n\t\t\t\t* CFrame.Angles(math.rad(sample.r.X),math.rad(sample.r.Y),math.rad(sample.r.Z))\n\t\t\tp.Weight = if moving and (name==\"LowerTorso\" or name:find(\"Left.*Leg\") or name==\"LeftFoot\") then 0\n\t\t\t\telseif moving and (name:find(\"Right.*Leg\") or name==\"RightFoot\") then 0.8 else 1\n\t\t\tp.EasingStyle=Enum.PoseEasingStyle.Cubic;p.EasingDirection=Enum.PoseEasingDirection.InOut\n\t\t\tp.Parent=if parents[i]==0 then root else built[parents[i]]\n\t\t\tbuilt[i]=p\n\t\tend\n\t\tframe.Parent=sequence\n\tend\n\treturn sequence\nend\n\nreturn table.freeze(Charge)\n"},{"disk":"src/shared/SprintSpeedRules.luau","studioPath":["ReplicatedStorage","Shared","SprintSpeedRules"],"className":"ModuleScript","content":"--!strict\n-- Pure sprint speed state: cardinal/diagonal input and brief turn deceleration.\nlocal Config = require(script.Parent.configs.SprintConfigs)\nlocal Rules = {}\n\nexport type State = {\n\tforward: number, lateral: number, direction: Vector3, turnOrigin: Vector3,\n\tlastMovingAt: number, penaltyUntil: number, penaltySpeed: number, speed: number,\n}\n\nfunction Rules.IsAxis(value: any): boolean\n\treturn value == -1 or value == 0 or value == 1\nend\n\nfunction Rules.BaseSpeed(forward: number, lateral: number): number\n\treturn if forward ~= 0 and lateral ~= 0 then Config.DIAGONAL_SPEED else Config.SPRINT_SPEED\nend\n\nfunction Rules.New(): State\n\treturn {forward = 0, lateral = 0, direction = Vector3.zero, turnOrigin = Vector3.zero,\n\t\tlastMovingAt = -math.huge, penaltyUntil = 0, penaltySpeed = Config.SPRINT_SPEED,\n\t\tspeed = Config.SPRINT_SPEED}\nend\n\nfunction Rules.SetDirection(state: State, forward: number, lateral: number, now: number)\n\tlocal direction = Vector3.new(lateral, 0, -forward)\n\tif direction.Magnitude == 0 then return end\n\tdirection = direction.Unit\n\tlocal recent = now - state.lastMovingAt <= Config.TURN_MEMORY_SEC\n\tif not recent then\n\t\tstate.penaltyUntil, state.penaltySpeed = 0, Config.SPRINT_SPEED\n\t\tstate.turnOrigin = Vector3.zero\n\t\tstate.speed = Rules.BaseSpeed(forward, lateral)\n\telseif state.direction.Magnitude > 0 then\n\t\tlocal angle = math.deg(math.acos(math.clamp(state.direction:Dot(direction), -1, 1)))\n\t\tlocal changed = angle > 0.1\n\t\tif changed and now < state.penaltyUntil and state.turnOrigin.Magnitude > 0 then\n\t\t\t-- SA/SD arrive as separate key events; retain the origin of this brief turn.\n\t\t\tangle = math.max(angle, math.deg(math.acos(math.clamp(state.turnOrigin:Dot(direction), -1, 1))))\n\t\tend\n\t\tlocal cap = if angle >= 134.9 then Config.REVERSE_SPEED\n\t\t\telseif angle >= 44.9 then Config.DIAGONAL_SPEED else nil\n\t\tif changed and cap then\n\t\t\tif now >= state.penaltyUntil then state.turnOrigin = state.direction end\n\t\t\t-- Smaller turns cannot erase an already active reverse penalty.\n\t\t\tstate.penaltySpeed = if now < state.penaltyUntil then math.min(cap, state.penaltySpeed) else cap\n\t\t\tstate.penaltyUntil = now + Config.TURN_HOLD_SEC\n\t\tend\n\tend\n\tstate.forward, state.lateral, state.direction = forward, lateral, direction\n\tstate.lastMovingAt = now\n\tlocal target = Rules.BaseSpeed(forward, lateral)\n\tif now < state.penaltyUntil then target = math.min(target, state.penaltySpeed) end\n\tstate.speed = math.min(state.speed, target)\nend\n\nfunction Rules.Advance(state: State, now: number, dt: number): number\n\tstate.lastMovingAt = now -- A held key remains recent even without new network intents.\n\tlocal target = Rules.BaseSpeed(state.forward, state.lateral)\n\tif now < state.penaltyUntil then target = math.min(target, state.penaltySpeed) end\n\tstate.speed = math.min(target, state.speed + Config.RECOVERY_PER_SEC * math.clamp(dt, 0, 0.1))\n\treturn state.speed\nend\n\nreturn table.freeze(Rules)\n"},{"disk":"src/shared/configs/GroundTurnConfigs.luau","studioPath":["ReplicatedStorage","Shared","configs","GroundTurnConfigs"],"className":"ModuleScript","content":"--!strict\n-- Initial visual tuning for continuous steering; no animation completion gate.\nreturn table.freeze({\n\tResponseSec = 0.045,\n\tFacingRateRadPerSec = 20,\n\tLeanResponse = 22,\n\tMaxRollDeg = 9,\n\tMaxPitchDeg = 3,\n\tFullLeanAngleDeg = 45,\n\tFullLeanRateRadPerSec = 8,\n})\n"},{"disk":"src/shared/configs/SprintConfigs.luau","studioPath":["ReplicatedStorage","Shared","configs","SprintConfigs"],"className":"ModuleScript","content":"--!strict\n-- src/shared/configs/SprintConfigs.luau\n-- Authoritative Configuration for R15 Sprint Mechanics & Run Animation Integration\n-- Governed by RF02-IDLE-RUNTIME Contract (Latest Owner Override 2026-10-26)\n\nexport type SprintConfig = {\n\tNORMAL_WALK_SPEED: number,\n\tSPRINT_SPEED: number,\n\tDIAGONAL_SPEED: number,\n\tREVERSE_SPEED: number,\n\tTURN_HOLD_SEC: number,\n\tTURN_MEMORY_SEC: number,\n\tRECOVERY_PER_SEC: number,\n\tSTART_RATE_LIMIT_INTERVAL_SEC: number,\n\tSPRINT_KEY_CODES: { Enum.KeyCode },\n}\n\nlocal SprintConfigs = {}\n\nSprintConfigs.NORMAL_WALK_SPEED = 16.0\nSprintConfigs.SPRINT_SPEED = 32.0\nSprintConfigs.DIAGONAL_SPEED = 28.8\nSprintConfigs.REVERSE_SPEED = 25.92\n-- SprintConfigs.TURN_HOLD_SEC = 0.3 -- Previous Owner tuning.\nSprintConfigs.TURN_HOLD_SEC = 0.7\nSprintConfigs.TURN_MEMORY_SEC = 0.3 -- Remember a brief key-up gap before the next direction.\nSprintConfigs.RECOVERY_PER_SEC = 32.0 -- Smooth return after the Owner-selected hold.\nSprintConfigs.START_RATE_LIMIT_INTERVAL_SEC = 0.05\n\n-- Owner Override: hold LeftShift / RightShift to sprint.\n-- Dual-key tracking: releasing one Shift while other remains held preserves sprinting.\nSprintConfigs.SPRINT_KEY_CODES = table.freeze({\n\tEnum.KeyCode.LeftShift,\n\tEnum.KeyCode.RightShift,\n})\n\nreturn table.freeze(SprintConfigs)\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\nSprintConfigs.SPRINT_SPEED = 32.0\n]====]\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\n\tOTHER_DIRECTION_SPEED: number,\n\n-- Previous section --\nSprintConfigs.SPRINT_SPEED = 28.8\nSprintConfigs.OTHER_DIRECTION_SPEED = 25.92 -- Initial Owner-review tuning for side/back movement.\n]====]\n"},{"disk":"src/shared/DribbleControlRules.luau","studioPath":["ReplicatedStorage","Shared","DribbleControlRules"],"className":"ModuleScript","content":"--!strict\n-- Pure direction rules, shared by server validation and local input; no side effects.\nlocal Rules = {}\n\nfunction Rules.IsFiniteVector(v: any): boolean\n\treturn typeof(v) == \"Vector3\"\n\t\tand v.X == v.X and v.Y == v.Y and v.Z == v.Z\n\t\tand math.abs(v.X) < math.huge and math.abs(v.Y) < math.huge and math.abs(v.Z) < math.huge\nend\n\nfunction Rules.AttackGoal(teamSide: string, halfLength: number, backZone: number): Vector3?\n\tif teamSide ~= \"North\" and teamSide ~= \"South\" then return nil end\n\t-- TeamSide is its own goal, not the goal it attacks.\n\treturn Vector3.new(0, 0, (if teamSide == \"North\" then 1 else -1) * (halfLength - backZone))\nend\n\nfunction Rules.HorizontalDirection(v: Vector3): Vector3\n\tif not Rules.IsFiniteVector(v) then return Vector3.zero end\n\tlocal h = Vector3.new(v.X, 0, v.Z)\n\treturn if h.Magnitude > 1e-4 then h.Unit else Vector3.zero\nend\n\nfunction Rules.GoalMovement(localInput: Vector3, goalDirection: Vector3): Vector3\n\tlocal forward = Rules.HorizontalDirection(goalDirection)\n\tif forward.Magnitude == 0 or localInput.Magnitude == 0 then return Vector3.zero end\n\tlocal right = forward:Cross(Vector3.yAxis)\n\treturn Rules.HorizontalDirection(right * localInput.X - forward * localInput.Z)\nend\n\nreturn table.freeze(Rules)\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\nfunction Rules.CutForTransition(previousChord: string, chord: string, previousInput: Vector3, input: Vector3, reverseAngle: number): string?\n\tif chord == previousChord or previousInput.Magnitude < 0.001 or input.Magnitude < 0.001 then return nil end\n\tlocal prev = Rules.HorizontalDirection(previousInput)\n\tlocal nextDir = Rules.HorizontalDirection(input)\n\tlocal angle = math.deg(math.acos(math.clamp(prev:Dot(nextDir), -1, 1)))\n\tif angle >= reverseAngle then\n\t\treturn if prev:Cross(nextDir).Y < 0 then \"ReverseRight\" else \"ReverseLeft\"\n\tend\n\tif #chord == 2 then\n\t\tif input.Z < 0 then return if input.X < 0 then \"FrontLeft\" else \"FrontRight\" end\n\t\treturn if input.X < 0 then \"BackLeft\" else \"BackRight\"\n\tend\n\treturn nil\nend\n\n]====]\n"},{"disk":"src/client/controllers/SprintController.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","controllers","SprintController"],"className":"ModuleScript","content":"--!strict\n-- src/client/controllers/SprintController.luau\n-- Client Controller for Player Sprint Intent & Context Loss Handling\n-- Governed by RF02-IDLE-RUNTIME Contract & Owner Additive Scope (2026-10-26 & Review026)\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal GuiService = game:GetService(\"GuiService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Network = require(Shared:WaitForChild(\"Network\"))\nlocal SprintConfigs = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"SprintConfigs\"))\n\nlocal isInitialized = false\nlocal isSprinting = false\nlocal sprintRemote: RemoteEvent? = nil\nlocal activeSprintKeys: { [Enum.KeyCode]: boolean } = {}\nlocal activeConnections: { RBXScriptConnection } = {}\nlocal characterGeneration: number = 0\nlocal retryThread: thread? = nil\nlocal lastSentTime: number = 0\nlocal currentCharacter: Model? = nil\n\nlocal currentForwardIntent: number = 0\nlocal currentLateralIntent: number = 0\nlocal isMovingIntent: boolean = false\nlocal serverSprintRequested: boolean = false\n\nlocal SprintController = {}\n\nlocal function isLocomotionEligible(): boolean\n\tlocal char = currentCharacter\n\tif not char or not char:IsDescendantOf(game) then\n\t\treturn false\n\tend\n\tlocal hum = char:FindFirstChildOfClass(\"Humanoid\")\n\tif not hum or hum.Health <= 0 then\n\t\treturn false\n\tend\n\tlocal state = hum:GetState()\n\tif state == Enum.HumanoidStateType.Jumping\n\t\tor state == Enum.HumanoidStateType.Freefall\n\t\tor state == Enum.HumanoidStateType.Seated\n\t\tor state == Enum.HumanoidStateType.Climbing\n\t\tor state == Enum.HumanoidStateType.Swimming\n\t\tor state == Enum.HumanoidStateType.Dead\n\t\tor state == Enum.HumanoidStateType.Physics\n\t\tor state == Enum.HumanoidStateType.PlatformStanding then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function checkRetrySprint(thisGen: number)\n\tif retryThread then\n\t\ttask.cancel(retryThread)\n\t\tretryThread = nil\n\tend\n\n\tlocal isShiftHeld = (next(activeSprintKeys) ~= nil)\n\tif not isShiftHeld or not isMovingIntent or not isLocomotionEligible() then\n\t\treturn\n\tend\n\n\t-- Schedule a single bounded retry after the rate limit window\n\tretryThread = task.delay(SprintConfigs.START_RATE_LIMIT_INTERVAL_SEC + 0.02, function()\n\t\tretryThread = nil\n\t\tif characterGeneration ~= thisGen then\n\t\t\treturn\n\t\tend\n\t\tlocal stillShift = (next(activeSprintKeys) ~= nil)\n\t\tif not stillShift or not isMovingIntent or not isLocomotionEligible() then\n\t\t\treturn\n\t\tend\n\t\tlocal activeChar = currentCharacter\n\t\tif not activeChar or not activeChar:IsDescendantOf(game) then\n\t\t\treturn\n\t\tend\n\t\tlocal serverState = (activeChar:GetAttribute(\"IsSprinting\") == true)\n\t\tif not serverState then\n\t\t\t-- Server did not grant sprint (rate-limited / rejected); re-send intent now that cooldown has elapsed!\n\t\t\tisSprinting = false\n\t\t\tsyncSprintIntent()\n\t\tend\n\tend)\nend\n\nfunction syncSprintIntent(forceResend: boolean?)\n\tlocal isShiftHeld = (next(activeSprintKeys) ~= nil)\n\tlocal isEligible = isShiftHeld and isMovingIntent and isLocomotionEligible()\n\n\tif not isEligible then\n\t\tif retryThread then\n\t\t\ttask.cancel(retryThread)\n\t\t\tretryThread = nil\n\t\tend\n\t\tlocal char = currentCharacter\n\t\tlocal serverFlag = (char and char:GetAttribute(\"IsSprinting\") == true)\n\t\tif isSprinting or serverSprintRequested or serverFlag then\n\t\t\tisSprinting = false\n\t\t\tserverSprintRequested = false\n\t\t\tlastSentTime = os.clock()\n\t\t\tif sprintRemote then\n\t\t\t\tsprintRemote:FireServer({\n\t\t\t\t\tisShiftHeld = false,\n\t\t\t\t\tisMoving = false,\n\t\t\t\t\tforward = 0,\n\t\t\t\t})\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\n\t-- isEligible == true\n\tif isSprinting and not forceResend then\n\t\treturn\n\tend\n\tisSprinting = true\n\tserverSprintRequested = true\n\tlastSentTime = os.clock()\n\n\tif sprintRemote then\n\t\tsprintRemote:FireServer({\n\t\t\tisShiftHeld = isShiftHeld,\n\t\t\tisMoving = true,\n\t\t\tforward = currentForwardIntent,\n\t\t\tlateral = currentLateralIntent,\n\t\t})\n\tend\n\n\t-- Always schedule bounded grounded retry in case this request hits a server rate-limit window\n\tcheckRetrySprint(characterGeneration)\nend\n\nfunction SprintController.SetMovementIntent(isMoving: boolean, forward: number?, lateral: number?)\n\tlocal nextForward = if isMoving then (forward or 0) else 0\n\tlocal nextLateral = if isMoving then (lateral or 0) else 0\n\tif isMovingIntent == isMoving and currentForwardIntent == nextForward and currentLateralIntent == nextLateral then return end\n\tisMovingIntent = isMoving\n\tcurrentForwardIntent = nextForward\n\tcurrentLateralIntent = nextLateral\n\tsyncSprintIntent(true)\nend\n\nfunction SprintController.SetForwardIntent(forward: number)\n\tSprintController.SetMovementIntent(forward ~= 0, forward)\nend\n\nlocal function resetSprintState()\n\tif retryThread then\n\t\ttask.cancel(retryThread)\n\t\tretryThread = nil\n\tend\n\ttable.clear(activeSprintKeys)\n\tisMovingIntent = false\n\tcurrentForwardIntent = 0\n\tcurrentLateralIntent = 0\n\tlocal char = currentCharacter\n\tlocal serverFlag = (char and char:GetAttribute(\"IsSprinting\") == true)\n\tif isSprinting or serverSprintRequested or serverFlag then\n\t\tisSprinting = false\n\t\tserverSprintRequested = false\n\t\tlastSentTime = os.clock()\n\t\tif sprintRemote then\n\t\t\tsprintRemote:FireServer({\n\t\t\t\tisShiftHeld = false,\n\t\t\t\tisMoving = false,\n\t\t\t\tforward = 0,\n\t\t\t})\n\t\tend\n\tend\nend\n\nlocal function isSprintKey(keyCode: Enum.KeyCode): boolean\n\tfor _, key in ipairs(SprintConfigs.SPRINT_KEY_CODES) do\n\t\tif key == keyCode then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nlocal function onInputBegan(input: InputObject, gameProcessedEvent: boolean)\n\tif gameProcessedEvent then\n\t\treturn\n\tend\n\n\tif input.UserInputType == Enum.UserInputType.Keyboard then\n\t\tif isSprintKey(input.KeyCode) then\n\t\t\tactiveSprintKeys[input.KeyCode] = true\n\t\t\tsyncSprintIntent()\n\t\tend\n\tend\nend\n\nlocal function onInputEnded(input: InputObject, _gameProcessedEvent: boolean)\n\tif input.UserInputType == Enum.UserInputType.Keyboard then\n\t\tif isSprintKey(input.KeyCode) then\n\t\t\tactiveSprintKeys[input.KeyCode] = nil\n\t\t\t-- Releasing one Shift while other Shift is still held preserves sprinting\n\t\t\tif next(activeSprintKeys) == nil then\n\t\t\t\tif retryThread then\n\t\t\t\t\ttask.cancel(retryThread)\n\t\t\t\t\tretryThread = nil\n\t\t\t\tend\n\t\t\tend\n\t\t\tsyncSprintIntent()\n\t\tend\n\tend\nend\n\nlocal function setupCharacter(character: Model)\n\tcharacterGeneration += 1\n\tlocal thisGen = characterGeneration\n\tcurrentCharacter = character\n\n\tfor _, c in ipairs(activeConnections) do\n\t\tc:Disconnect()\n\tend\n\ttable.clear(activeConnections)\n\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\n\t-- Post-yield generation check\n\tif characterGeneration ~= thisGen or not character:IsDescendantOf(game) or not humanoid then\n\t\treturn\n\tend\n\n\t-- Cancel sprint intent on airborne, seated, climbing, or swimming states\n\tlocal stateConn = humanoid.StateChanged:Connect(function(oldState, newState)\n\t\tif characterGeneration == thisGen then\n\t\t\tif newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then\n\t\t\t\t-- Airborne: cancel retry timer and suspend server sprint intent\n\t\t\t\tif retryThread then\n\t\t\t\t\ttask.cancel(retryThread)\n\t\t\t\t\tretryThread = nil\n\t\t\t\tend\n\t\t\t\tlocal serverFlag = (character:GetAttribute(\"IsSprinting\") == true)\n\t\t\t\tif isSprinting or serverSprintRequested or serverFlag then\n\t\t\t\t\tisSprinting = false\n\t\t\t\t\tserverSprintRequested = false\n\t\t\t\t\tif sprintRemote then\n\t\t\t\t\t\tsprintRemote:FireServer({\n\t\t\t\t\t\t\tisShiftHeld = false,\n\t\t\t\t\t\t\tisMoving = false,\n\t\t\t\t\t\t\tforward = 0,\n\t\t\t\t\t\t})\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\telseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running then\n\t\t\t\t-- Landing/Running: resume sprint ONLY when transitioning from an airborne state\n\t\t\t\tlocal wasAirborne = (oldState == Enum.HumanoidStateType.Jumping or oldState == Enum.HumanoidStateType.Freefall)\n\t\t\t\tif wasAirborne then\n\t\t\t\t\tisSprinting = false\n\t\t\t\t\tsyncSprintIntent(true)\n\t\t\t\telseif not isSprinting then\n\t\t\t\t\t-- Ordinary ground transition (e.g. Landed -> Running): only sync if not already sprinting\n\t\t\t\t\tsyncSprintIntent()\n\t\t\t\tend\n\t\t\telseif newState == Enum.HumanoidStateType.Seated\n\t\t\t\tor newState == Enum.HumanoidStateType.Climbing\n\t\t\t\tor newState == Enum.HumanoidStateType.Swimming\n\t\t\t\tor newState == Enum.HumanoidStateType.Dead then\n\t\t\t\tresetSprintState()\n\t\t\tend\n\t\tend\n\tend)\n\ttable.insert(activeConnections, stateConn)\n\n\tlocal diedConn = humanoid.Died:Connect(function()\n\t\tif characterGeneration == thisGen then\n\t\t\tresetSprintState()\n\t\tend\n\tend)\n\ttable.insert(activeConnections, diedConn)\n\n\t-- Reconcile client optimistic sprint with authoritative server attribute\n\tlocal attrConn = character:GetAttributeChangedSignal(\"IsSprinting\"):Connect(function()\n\t\tif characterGeneration == thisGen then\n\t\t\tlocal serverState = (character:GetAttribute(\"IsSprinting\") == true)\n\t\t\tif not serverState and isSprinting then\n\t\t\t\t-- Server rejected or revoked sprint: reconcile client state\n\t\t\t\tisSprinting = false\n\t\t\t\tcheckRetrySprint(thisGen)\n\t\t\tend\n\t\tend\n\tend)\n\ttable.insert(activeConnections, attrConn)\n\n\t-- Reconcile negative rate-limit acknowledgement from server (RF-F45 fix)\n\tlocal rejectConn = character:GetAttributeChangedSignal(\"SprintRejectedSeq\"):Connect(function()\n\t\tif characterGeneration == thisGen then\n\t\t\tif isSprinting then\n\t\t\t\tisSprinting = false\n\t\t\tend\n\t\t\tcheckRetrySprint(thisGen)\n\t\tend\n\tend)\n\ttable.insert(activeConnections, rejectConn)\nend\n\nfunction SprintController.Init()\n\tif isInitialized then\n\t\treturn\n\tend\n\tisInitialized = true\n\n\tlocal localPlayer = Players.LocalPlayer\n\tassert(localPlayer ~= nil, \"[SprintController] LocalPlayer required for initialization\")\n\n\tsprintRemote = Network.GetRemoteEvent(Network.Names.SprintIntentRequest)\n\tassert(sprintRemote ~= nil, \"[SprintController] SprintIntentRequest remote event missing\")\n\n\t-- Bind keyboard inputs\n\tUserInputService.InputBegan:Connect(onInputBegan)\n\tUserInputService.InputEnded:Connect(onInputEnded)\n\n\t-- Context loss handlers: ensure sprint is released when focus, window, menu, or chat opens\n\tUserInputService.WindowFocusReleased:Connect(resetSprintState)\n\tGuiService.MenuOpened:Connect(resetSprintState)\n\tUserInputService.TextBoxFocused:Connect(resetSprintState)\n\n\t-- Character lifecycle observers\n\tlocalPlayer.CharacterAdded:Connect(function(char)\n\t\tresetSprintState()\n\t\tsetupCharacter(char)\n\tend)\n\n\tlocalPlayer.CharacterRemoving:Connect(function()\n\t\tcharacterGeneration += 1\n\t\tresetSprintState()\n\tend)\n\n\tif localPlayer.Character and localPlayer.Character:IsDescendantOf(game) then\n\t\tlocal existingChar = localPlayer.Character\n\t\ttask.spawn(function()\n\t\t\tsetupCharacter(existingChar)\n\t\tend)\n\tend\nend\n\nfunction SprintController.IsSprinting(): boolean\n\treturn isSprinting\nend\n\nreturn table.freeze(SprintController)\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\n\t\t\tforward = 1,\n\n-- Previous section --\nfunction SprintController.SetMovementIntent(isMoving: boolean)\n\tif isMovingIntent == isMoving then\n\t\treturn\n\tend\n\n-- Previous section --\n\tcurrentForwardIntent = if isMoving then 1 else 0\n\tsyncSprintIntent()\n\n-- Previous section --\n\tSprintController.SetMovementIntent(forward ~= 0)\n]====]\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\nfunction SprintController.SetMovementIntent(isMoving: boolean, forward: number?)\n\n-- Previous section --\n\tif isMovingIntent == isMoving and currentForwardIntent == nextForward then return end\n]====]\n"},{"disk":"src/client/controllers/AirMovementController.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","controllers","AirMovementController"],"className":"ModuleScript","content":"--!strict\n-- src/client/controllers/AirMovementController.luau\n-- Client Controller for High Momentum Jump, Soft Apex, Liftoff Yaw Lock & Four-Way Air Lean Visual Overlay\n-- Governed by: docs/plan/phase-01-gameplay-demo/release-first/assets/dribble-receive-HANDOFF.md\n-- & docs/plan/phase-01-gameplay-demo/release-first/assets/jump-stutter-only-HANDOFF.md\n-- Features:\n-- 1. Continuous grounded momentum tracking: preserves verified takeoff speed across walk/sprint before sprint WalkSpeed resets.\n-- 2. Stepped horizontal momentum maintenance: guarantees stand < walk < sprint forward travel without midair boost or arbitrary multipliers.\n-- 3. Bounded soft apex integration: clamps dt integration to remaining budget, preventing large dt overruns.\n-- 4. Single-owner Yaw Lock: Actual character facing yaw locked at takeoff throughout flight until landed; AutoRotate disabled; deadband-guarded CFrame correction avoids per-frame root teleport stutter. Camera may orbit freely 360°.\n-- 5. Four-Way Air Lean: Layered support for both modern AnimationConstraint (via Attachment0) and legacy Motor6D (via C0).\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal JumpConfigs = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"JumpConfigs\"))\nlocal GroundTurnConfigs = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"GroundTurnConfigs\"))\n\nlocal isInitialized = false\nlocal localPlayer: Player? = nil\nlocal currentCharacter: Model? = nil\nlocal currentHumanoid: Humanoid? = nil\nlocal currentHrp: BasePart? = nil\n\n-- Joint Reference (Supports both AnimationConstraint and Motor6D)\nlocal rootJointType: \"AnimationConstraint\" | \"Motor6D\" | \"None\" = \"None\"\nlocal currentRootJoint: Instance? = nil\nlocal currentRootAttachment0: Attachment? = nil\nlocal baseRootC0: CFrame = CFrame.identity\nlocal baseAttachmentC0: CFrame = CFrame.identity\n\nlocal characterGeneration: number = 0\nlocal activeConnections: { RBXScriptConnection } = {}\n\n-- Airborne Momentum & Soft Apex State\nlocal isAirborne: boolean = false\nlocal takeoffSpeed: number = 0\nlocal takeoffDirection: Vector3 = Vector3.zero\n-- Actual horizontal velocity at liftoff; blended toward the takeoff vector so a direction different from the\n-- ground travel/facing does not flip the velocity in a single frame\nlocal takeoffStartHoriz: Vector3 = Vector3.zero\nlocal takeoffBlendElapsed: number = 0\nlocal momentumMaintenanceActive = false\nlocal apexSoftElapsed: number = 0\nlocal flightTime: number = 0\n\n-- Rolling Grounded Momentum Tracking (guards against premature sprint WalkSpeed reset)\nlocal lastGroundedSpeed: number = 0\nlocal lastGroundedDirection: Vector3 = Vector3.zero\nlocal lastGroundedFacingYaw: number = 0\n\n-- Yaw Lock State (Owner Constraint: Lock actual character facing yaw at takeoff until landed)\nlocal lockedTakeoffYaw: number = 0\n\n-- Four-Way Air Lean State (Radians)\nlocal currentPitch: number = 0\nlocal currentRoll: number = 0\n\n-- MovementHeadingPreviewController publishes its latched raw movement intent here\n-- while its airborne path intentionally zeros Humanoid:Move.\nlocal leanInputSourceEnabled = false\nlocal leanInputWorldDirection = Vector3.zero\n\nlocal AirMovementController = {}\n\nlocal function syncCharacterTelemetry()\n\tlocal char = currentCharacter\n\tif not char or not char:IsDescendantOf(game) then\n\t\treturn\n\tend\n\tchar:SetAttribute(\"AirRootJointType\", rootJointType)\n\tchar:SetAttribute(\"IsAirborne\", isAirborne)\n\tchar:SetAttribute(\"TakeoffSpeed\", takeoffSpeed)\n\tchar:SetAttribute(\"LockedTakeoffYaw\", lockedTakeoffYaw)\n\tchar:SetAttribute(\"AirLeanPitch\", currentPitch)\n\tchar:SetAttribute(\"AirLeanRoll\", currentRoll)\nend\n\nlocal function resetAirState()\n\tisAirborne = false\n\ttakeoffSpeed = 0\n\ttakeoffDirection = Vector3.zero\n\ttakeoffStartHoriz = Vector3.zero\n\ttakeoffBlendElapsed = 0\n\tmomentumMaintenanceActive = false\n\tapexSoftElapsed = 0\n\tflightTime = 0\n\tsyncCharacterTelemetry()\nend\n\nlocal function resetJoints()\n\tif rootJointType == \"Motor6D\" and currentRootJoint and currentRootJoint.Parent ~= nil then\n\t\t(currentRootJoint :: Motor6D).C0 = baseRootC0\n\telseif rootJointType == \"AnimationConstraint\" and currentRootAttachment0 and currentRootAttachment0.Parent ~= nil then\n\t\tcurrentRootAttachment0.CFrame = baseAttachmentC0\n\tend\n\tcurrentPitch = 0\n\tcurrentRoll = 0\n\tsyncCharacterTelemetry()\nend\n\nlocal function cleanup(characterBeingRemoved: Model?)\n\tif characterBeingRemoved ~= nil and currentCharacter ~= characterBeingRemoved then\n\t\treturn\n\tend\n\n\tcharacterGeneration += 1\n\n\tfor _, conn in ipairs(activeConnections) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(activeConnections)\n\n\t-- Restore native AutoRotate if character is still valid\n\tif currentHumanoid and currentHumanoid.Parent ~= nil then\n\t\tcurrentHumanoid.AutoRotate = true\n\tend\n\n\tresetJoints()\n\tresetAirState()\n\tcurrentCharacter = nil\n\tcurrentHumanoid = nil\n\tcurrentHrp = nil\n\tcurrentRootJoint = nil\n\tcurrentRootAttachment0 = nil\n\trootJointType = \"None\"\nend\n\nlocal function isCurrentCharacter(char: Model, generation: number): boolean\n\treturn characterGeneration == generation\n\t\tand localPlayer ~= nil\n\t\tand localPlayer.Character == char\n\t\tand char:IsDescendantOf(game)\nend\n\nlocal function onLiftoff(hrp: BasePart, hum: Humanoid, isLedgeFall: boolean)\n\tif isAirborne then\n\t\t-- Capture yaw and momentum ONCE per flight; no relatch in Freefall or repeated state events\n\t\treturn\n\tend\n\n\tlocal currentVel = hrp.AssemblyLinearVelocity\n\tlocal effectiveLedgeFall = isLedgeFall and (currentVel.Y <= JumpConfigs.LEDGE_FALL_MAX_INITIAL_VY)\n\n\tisAirborne = true\n\tmomentumMaintenanceActive = true\n\tflightTime = 0\n\tapexSoftElapsed = 0\n\n\t-- Capture actual character facing yaw at liftoff\n\tif effectiveLedgeFall then\n\t\tlockedTakeoffYaw = lastGroundedFacingYaw\n\telse\n\t\tlocal _, y, _ = hrp.CFrame:ToOrientation()\n\t\tlockedTakeoffYaw = y\n\tend\n\n\t-- Lock character yaw: disable native AutoRotate and zero angular velocity\n\thum.AutoRotate = false\n\thrp.AssemblyAngularVelocity = Vector3.zero\n\n\tlocal horizVel = Vector3.new(currentVel.X, 0, currentVel.Z)\n\tlocal rawSpeed = horizVel.Magnitude\n\ttakeoffStartHoriz = horizVel\n\ttakeoffBlendElapsed = 0\n\n\t-- RF-F39: Capture verified grounded momentum before sprint reset occurs\n\tlocal capturedSpeed = math.max(rawSpeed, lastGroundedSpeed)\n\ttakeoffSpeed = math.clamp(capturedSpeed, 0, JumpConfigs.MAX_AIR_HORIZONTAL_SPEED)\n\n\tlocal moveDir = hum.MoveDirection\n\tif moveDir.Magnitude > 0.1 then\n\t\ttakeoffDirection = moveDir.Unit\n\telseif rawSpeed > 1.0 then\n\t\ttakeoffDirection = horizVel.Unit\n\telseif lastGroundedDirection.Magnitude > 0.1 then\n\t\ttakeoffDirection = lastGroundedDirection\n\telse\n\t\ttakeoffDirection = Vector3.zero\n\tend\n\n\tsyncCharacterTelemetry()\nend\n\nlocal function onLanded(hum: Humanoid)\n\tresetAirState()\n\t-- Restore AutoRotate on verified landing\n\thum.AutoRotate = true\nend\n\nlocal function applyLeanJoint(pitch: number, roll: number)\n\tif rootJointType == \"Motor6D\" and currentRootJoint and currentRootJoint.Parent ~= nil then\n\t\t(currentRootJoint :: Motor6D).C0 = baseRootC0 * CFrame.Angles(pitch, 0, roll)\n\telseif rootJointType == \"AnimationConstraint\" and currentRootAttachment0 and currentRootAttachment0.Parent ~= nil then\n\t\tcurrentRootAttachment0.CFrame = baseAttachmentC0 * CFrame.Angles(pitch, 0, roll)\n\tend\nend\n\nlocal function onStepped(_time: number, dt: number, thisGen: number)\n\tif characterGeneration ~= thisGen or not currentHrp or not currentHumanoid or currentHumanoid.Health <= 0 then\n\t\treturn\n\tend\n\n\tlocal hrp = currentHrp\n\tlocal hum = currentHumanoid\n\n\tif isAirborne and momentumMaintenanceActive then\n\t\t-- RF-F39: PreSimulation Velocity Maintenance\n\t\t-- Directly sets horizontal flight velocity along takeoff vector in Stepped,\n\t\t-- before physics solver runs, preventing native Humanoid air drag from collapsing sprint to walk.\n\t\tif takeoffSpeed > 0.5 and takeoffDirection.Magnitude > 0.1 then\n\t\t\tlocal currentVy = hrp.AssemblyLinearVelocity.Y\n\t\t\tif hum:GetState() == Enum.HumanoidStateType.Jumping and flightTime < 0.03 and currentVy < JumpConfigs.JUMP_POWER * 0.5 then\n\t\t\t\tcurrentVy = math.max(currentVy, JumpConfigs.JUMP_POWER)\n\t\t\tend\n\t\t\tlocal targetHoriz = takeoffDirection * takeoffSpeed\n\t\t\tif takeoffBlendElapsed < JumpConfigs.TAKEOFF_VELOCITY_BLEND_SEC then\n\t\t\t\tlocal alpha = takeoffBlendElapsed / JumpConfigs.TAKEOFF_VELOCITY_BLEND_SEC\n\t\t\t\ttargetHoriz = takeoffStartHoriz:Lerp(targetHoriz, alpha)\n\t\t\t\ttakeoffBlendElapsed += dt\n\t\t\tend\n\t\t\thrp.AssemblyLinearVelocity = Vector3.new(targetHoriz.X, currentVy, targetHoriz.Z)\n\t\tend\n\tend\nend\n\nlocal function onHeartbeat(dt: number, thisGen: number)\n\tif characterGeneration ~= thisGen or not currentHrp or not currentHumanoid or currentHumanoid.Health <= 0 then\n\t\treturn\n\tend\n\n\tlocal hrp = currentHrp\n\tlocal hum = currentHumanoid\n\n\tif isAirborne then\n\t\tflightTime += dt\n\n\t\t-- 1. Owner Yaw Lock Enforcement & Collision Guard\n\t\tlocal currentPos = hrp.Position\n\t\tlocal currentVel = hrp.AssemblyLinearVelocity\n\t\tlocal horizontalVelocity = Vector3.new(currentVel.X, 0, currentVel.Z)\n\t\tif momentumMaintenanceActive\n\t\t\tand flightTime > 0.04\n\t\t\tand takeoffBlendElapsed >= JumpConfigs.TAKEOFF_VELOCITY_BLEND_SEC\n\t\t\tand takeoffSpeed > 0.5\n\t\t\tand takeoffDirection.Magnitude > 0.1\n\t\t\tand horizontalVelocity:Dot(takeoffDirection) < takeoffSpeed * 0.5\n\t\t\tand horizontalVelocity.Magnitude < takeoffSpeed * 0.65 then\n\t\t\t-- Accept a strong post-solver speed loss as collision/obstruction response;\n\t\t\t-- stop restoring the takeoff vector so the character cannot push into a wall.\n\t\t\tmomentumMaintenanceActive = false\n\t\tend\n\n\t\tif hum.AutoRotate then\n\t\t\thum.AutoRotate = false\n\t\tend\n\t\thrp.AssemblyAngularVelocity = Vector3.zero\n\n\t\t-- Deadband-guarded orientation lock: only rewrite hrp.CFrame if rotation drifted from lockedTakeoffYaw,\n\t\t-- avoiding unconditional per-frame CFrame teleport stutter during smooth flight.\n\t\tlocal rx, currentYaw, rz = hrp.CFrame:ToOrientation()\n\t\tlocal yawDiff = math.abs(currentYaw - lockedTakeoffYaw)\n\t\tif yawDiff > math.pi then\n\t\t\tyawDiff = 2 * math.pi - yawDiff\n\t\tend\n\t\tif yawDiff > JumpConfigs.CLIENT_YAW_LOCK_DEADBAND_RAD or math.abs(rx) > 0.02 or math.abs(rz) > 0.02 then\n\t\t\thrp.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, lockedTakeoffYaw, 0)\n\t\t\thrp.AssemblyAngularVelocity = Vector3.zero\n\t\t\thrp.AssemblyLinearVelocity = currentVel\n\t\tend\n\n\t\tlocal vy = currentVel.Y\n\n\t\t-- 2. RF-F36: Soft Apex Integration Clamping: Clamp integration step to remaining duration budget\n\t\tif vy <= JumpConfigs.APEX_SOFT_ZONE_VY_MAX and vy >= JumpConfigs.APEX_SOFT_ZONE_VY_MIN then\n\t\t\tif apexSoftElapsed < JumpConfigs.APEX_SOFT_MAX_DURATION then\n\t\t\t\tlocal remainingTime = JumpConfigs.APEX_SOFT_MAX_DURATION - apexSoftElapsed\n\t\t\t\tlocal stepDt = math.min(dt, remainingTime)\n\t\t\t\tapexSoftElapsed += stepDt\n\t\t\t\tlocal counterAccel = (JumpConfigs.GRAVITY * JumpConfigs.APEX_GRAVITY_DAMPING) * stepDt\n\t\t\t\thrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, vy + counterAccel, currentVel.Z)\n\t\t\tend\n\t\tend\n\n\t\t-- 3. Four-Way Air Lean: Visual pitch/roll tilt overlay based on flight movement input\n\t\t-- Relative to LOCKED takeoff yaw (does NOT turn character yaw!)\n\t\tlocal moveDir = if leanInputSourceEnabled then leanInputWorldDirection else hum.MoveDirection\n\t\tlocal targetPitch = 0\n\t\tlocal targetRoll = 0\n\n\t\tlocal horizontalMoveDir = Vector3.new(moveDir.X, 0, moveDir.Z)\n\t\tif horizontalMoveDir.Magnitude > 0.05 then\n\t\t\tlocal lockedCFrame = CFrame.Angles(0, lockedTakeoffYaw, 0)\n\t\t\tlocal localMove = lockedCFrame:VectorToObjectSpace(horizontalMoveDir.Unit)\n\t\t\tlocal inputX = math.clamp(localMove.X, -1, 1)   -- Left (-) / Right (+)\n\t\t\tlocal inputZ = math.clamp(-localMove.Z, -1, 1)  -- Forward (+) / Back (-)\n\n\t\t\ttargetPitch = -inputZ * math.rad(JumpConfigs.LEAN_MAX_PITCH_DEG)\n\t\t\ttargetRoll = -inputX * math.rad(JumpConfigs.LEAN_MAX_ROLL_DEG)\n\t\tend\n\n\t\tlocal lerpFactor = math.clamp(dt * JumpConfigs.LEAN_LERP_SPEED, 0, 1)\n\t\tcurrentPitch += (targetPitch - currentPitch) * lerpFactor\n\t\tcurrentRoll += (targetRoll - currentRoll) * lerpFactor\n\n\t\t-- RF-F34: Apply lean to joint (AnimationConstraint or Motor6D)\n\t\tapplyLeanJoint(currentPitch, currentRoll)\n\t\tsyncCharacterTelemetry()\n\telse\n\t\t-- Grounded: Track rolling verified momentum for takeoff snapshot (RF-F39)\n\t\tlocal currentVel = hrp.AssemblyLinearVelocity\n\t\tlocal horizVel = Vector3.new(currentVel.X, 0, currentVel.Z)\n\t\tlastGroundedSpeed = horizVel.Magnitude\n\n\t\tlocal moveDir = hum.MoveDirection\n\t\tif moveDir.Magnitude > 0.1 then\n\t\t\tlastGroundedDirection = moveDir.Unit\n\t\telseif horizVel.Magnitude > 1.0 then\n\t\t\tlastGroundedDirection = horizVel.Unit\n\t\telse\n\t\t\tlastGroundedDirection = Vector3.zero\n\t\tend\n\n\t\tlocal _, y, _ = hrp.CFrame:ToOrientation()\n\t\tlocal yawDelta = (y - lastGroundedFacingYaw + math.pi) % (2 * math.pi) - math.pi\n\t\tlocal yawRate = yawDelta / math.max(dt, 0.001)\n\t\tlastGroundedFacingYaw = y\n\n\t\t-- Reuse the existing single visual-joint owner; airborne yaw/momentum stay unchanged.\n\t\tlocal targetPitch, targetRoll = 0, 0\n\t\tlocal char = currentCharacter\n\t\tlocal eligible = char ~= nil and char:GetAttribute(\"MovePreviewActive\") == true\n\t\t\tand char:GetAttribute(\"GoalDribbleActive\") ~= true\n\t\t\tand char:GetAttribute(\"ShotActive\") ~= true and char:GetAttribute(\"ShotCharging\") ~= true\n\t\t\tand hum.FloorMaterial ~= Enum.Material.Air\n\t\t\tand hum:GetState() == Enum.HumanoidStateType.Running\n\t\tif eligible and char and horizVel.Magnitude > 2 then\n\t\t\tlocal desired = char:GetAttribute(\"DesiredMoveDirection\")\n\t\t\tif typeof(desired) == \"Vector3\" and desired.Magnitude > 0.01 then\n\t\t\t\tlocal wantedYaw = math.atan2(-desired.X, -desired.Z)\n\t\t\t\tlocal delta = (wantedYaw - y + math.pi) % (2 * math.pi) - math.pi\n\t\t\t\tlocal turn = math.clamp(delta / math.rad(GroundTurnConfigs.FullLeanAngleDeg)\n\t\t\t\t\t+ yawRate / GroundTurnConfigs.FullLeanRateRadPerSec, -1, 1)\n\t\t\t\tlocal speedWeight = math.clamp(horizVel.Magnitude / 28.8, 0, 1)\n\t\t\t\ttargetRoll = turn * math.rad(GroundTurnConfigs.MaxRollDeg) * speedWeight\n\t\t\t\ttargetPitch = -math.abs(turn) * math.rad(GroundTurnConfigs.MaxPitchDeg) * speedWeight\n\t\t\tend\n\t\tend\n\t\tlocal alpha = 1 - math.exp(-GroundTurnConfigs.LeanResponse * math.clamp(dt, 0, 0.1))\n\t\tcurrentPitch += (targetPitch - currentPitch) * alpha\n\t\tcurrentRoll += (targetRoll - currentRoll) * alpha\n\t\tapplyLeanJoint(currentPitch, currentRoll)\n\t\tif char then\n\t\t\tchar:SetAttribute(\"GroundTurnRoll\", currentRoll)\n\t\t\tchar:SetAttribute(\"GroundTurnPitch\", currentPitch)\n\t\tend\n\tend\nend\n\nlocal function setupCharacter(char: Model)\n\tlocal player = localPlayer\n\tif player == nil or player.Character ~= char or not char:IsDescendantOf(game) then\n\t\treturn\n\tend\n\n\t-- Invalidate and disconnect the old character first, then capture the token\n\t-- that identifies this setup attempt. cleanup() increments the generation.\n\tcleanup()\n\tlocal thisGen = characterGeneration\n\n\tcurrentCharacter = char\n\tlocal hum = char:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\tif not isCurrentCharacter(char, thisGen) or not hum then\n\t\treturn\n\tend\n\n\tlocal hrp = char:WaitForChild(\"HumanoidRootPart\", 10) :: BasePart?\n\tif not isCurrentCharacter(char, thisGen) or not hrp or hum.Health <= 0 then\n\t\treturn\n\tend\n\n\tcurrentHumanoid = hum\n\tcurrentHrp = hrp\n\n\t-- RF-F34: Inspect Root joint in LowerTorso (Supports AnimationConstraint and Motor6D)\n\tlocal lowerTorso = char:WaitForChild(\"LowerTorso\", 5) :: BasePart?\n\tif not isCurrentCharacter(char, thisGen) or not lowerTorso then\n\t\treturn\n\tend\n\n\tlocal root = lowerTorso:FindFirstChild(\"Root\")\n\tif root and root:IsA(\"Motor6D\") then\n\t\trootJointType = \"Motor6D\"\n\t\tcurrentRootJoint = root\n\t\tbaseRootC0 = root.C0\n\telseif root and root:IsA(\"AnimationConstraint\") then\n\t\trootJointType = \"AnimationConstraint\"\n\t\tcurrentRootJoint = root\n\t\tlocal attachment0 = root.Attachment0\n\t\tif attachment0 then\n\t\t\tcurrentRootAttachment0 = attachment0\n\t\t\tbaseAttachmentC0 = attachment0.CFrame\n\t\tend\n\tend\n\n\tif rootJointType == \"None\"\n\t\tor (rootJointType == \"AnimationConstraint\" and currentRootAttachment0 == nil) then\n\t\twarn(\"[AirMovementController] Current R15 character has no supported LowerTorso.Root joint; callbacks were not installed\")\n\t\tcleanup(char)\n\t\treturn\n\tend\n\n\t-- Configure higher jump parameters\n\thum.UseJumpPower = true\n\thum.JumpPower = JumpConfigs.JUMP_POWER\n\thum.JumpHeight = JumpConfigs.EXPECTED_APEX_HEIGHT\n\thum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)\n\thum.AutoRotate = true\n\n\tlocal _, initYaw, _ = hrp.CFrame:ToOrientation()\n\tlastGroundedFacingYaw = initYaw\n\tlockedTakeoffYaw = initYaw\n\tsyncCharacterTelemetry()\n\n\t-- State observer for liftoff and landing transitions\n\tlocal stateConn = hum.StateChanged:Connect(function(_oldState, newState)\n\t\tif not isCurrentCharacter(char, thisGen) then\n\t\t\treturn\n\t\tend\n\n\t\tif newState == Enum.HumanoidStateType.Jumping then\n\t\t\tonLiftoff(hrp, hum, false)\n\t\telseif newState == Enum.HumanoidStateType.Freefall then\n\t\t\tif not isAirborne then\n\t\t\t\tlocal isRisingJump = hrp.AssemblyLinearVelocity.Y > JumpConfigs.LEDGE_FALL_MAX_INITIAL_VY\n\t\t\t\tonLiftoff(hrp, hum, not isRisingJump)\n\t\t\tend\n\t\telseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running then\n\t\t\tif isAirborne then\n\t\t\t\tonLanded(hum)\n\t\t\tend\n\t\telseif newState == Enum.HumanoidStateType.Dead\n\t\t\tor newState == Enum.HumanoidStateType.Seated\n\t\t\tor newState == Enum.HumanoidStateType.Swimming\n\t\t\tor newState == Enum.HumanoidStateType.Climbing then\n\t\t\tresetAirState()\n\t\t\tresetJoints()\n\t\t\thum.AutoRotate = true\n\t\tend\n\tend)\n\ttable.insert(activeConnections, stateConn)\n\n\tlocal diedConn = hum.Died:Connect(function()\n\t\tif isCurrentCharacter(char, thisGen) then\n\t\t\tresetAirState()\n\t\t\tresetJoints()\n\t\t\thum.AutoRotate = true\n\t\tend\n\tend)\n\ttable.insert(activeConnections, diedConn)\n\n\t-- PreSimulation stepping for continuous forward momentum maintenance (RF-F39)\n\tlocal steppedConn = RunService.Stepped:Connect(function(time: number, dt: number)\n\t\tonStepped(time, dt, thisGen)\n\tend)\n\ttable.insert(activeConnections, steppedConn)\n\n\t-- PostSimulation stepping for soft apex, yaw lock & air lean overlay\n\tlocal heartbeatConn = RunService.Heartbeat:Connect(function(dt: number)\n\t\tonHeartbeat(dt, thisGen)\n\tend)\n\ttable.insert(activeConnections, heartbeatConn)\nend\n\nfunction AirMovementController.Init()\n\tif isInitialized then\n\t\treturn\n\tend\n\tisInitialized = true\n\n\tlocal player = Players.LocalPlayer\n\tassert(player ~= nil, \"[AirMovementController] LocalPlayer required for initialization\")\n\tlocalPlayer = player\n\n\tplayer.CharacterAdded:Connect(function(char)\n\t\tsetupCharacter(char)\n\tend)\n\n\tplayer.CharacterRemoving:Connect(function(char)\n\t\tcleanup(char)\n\tend)\n\n\tif player.Character and player.Character:IsDescendantOf(game) then\n\t\tlocal existingChar = player.Character\n\t\ttask.spawn(function()\n\t\t\tsetupCharacter(existingChar)\n\t\tend)\n\tend\nend\n\n-- Seams for future mechanics (AimOrientation, shot/pass/curve queries)\nfunction AirMovementController.IsAirborne(): boolean\n\tif not isInitialized then\n\t\tlocal lp = Players.LocalPlayer\n\t\tlocal char = lp and lp.Character\n\t\tif char then\n\t\t\treturn char:GetAttribute(\"IsAirborne\") == true\n\t\tend\n\tend\n\treturn isAirborne\nend\n\nfunction AirMovementController.GetTakeoffSpeed(): number\n\tif not isInitialized then\n\t\tlocal lp = Players.LocalPlayer\n\t\tlocal char = lp and lp.Character\n\t\tlocal attr = char and char:GetAttribute(\"TakeoffSpeed\")\n\t\tif type(attr) == \"number\" then\n\t\t\treturn attr\n\t\tend\n\tend\n\treturn takeoffSpeed\nend\n\nfunction AirMovementController.GetLockedTakeoffYaw(): number\n\tif not isInitialized then\n\t\tlocal lp = Players.LocalPlayer\n\t\tlocal char = lp and lp.Character\n\t\tlocal attr = char and char:GetAttribute(\"LockedTakeoffYaw\")\n\t\tif type(attr) == \"number\" then\n\t\t\treturn attr\n\t\tend\n\tend\n\treturn lockedTakeoffYaw\nend\n\nfunction AirMovementController.GetAirLean(): (number, number)\n\tif not isInitialized then\n\t\tlocal lp = Players.LocalPlayer\n\t\tlocal char = lp and lp.Character\n\t\tif char then\n\t\t\tlocal p = char:GetAttribute(\"AirLeanPitch\")\n\t\t\tlocal r = char:GetAttribute(\"AirLeanRoll\")\n\t\t\tif type(p) == \"number\" and type(r) == \"number\" then\n\t\t\t\treturn p, r\n\t\t\tend\n\t\tend\n\tend\n\treturn currentPitch, currentRoll\nend\n\nfunction AirMovementController.GetRootJointType(): string\n\tif not isInitialized then\n\t\tlocal lp = Players.LocalPlayer\n\t\tlocal char = lp and lp.Character\n\t\tlocal attr = char and char:GetAttribute(\"AirRootJointType\")\n\t\tif type(attr) == \"string\" then\n\t\t\treturn attr\n\t\tend\n\tend\n\treturn rootJointType\nend\n\nfunction AirMovementController.SetLeanInputSourceEnabled(enabled: boolean)\n\tleanInputSourceEnabled = enabled\n\tif not enabled then\n\t\tleanInputWorldDirection = Vector3.zero\n\tend\nend\n\nfunction AirMovementController.SetLeanInputDirection(direction: Vector3)\n\tlocal horizontalDirection = Vector3.new(direction.X, 0, direction.Z)\n\tif horizontalDirection.Magnitude > 1 then\n\t\thorizontalDirection = horizontalDirection.Unit\n\tend\n\tleanInputWorldDirection = horizontalDirection\nend\n\nfunction AirMovementController.GetAimOrientation(): CFrame\n\tif currentHrp then\n\t\treturn CFrame.new(currentHrp.Position) * CFrame.Angles(0, lockedTakeoffYaw, 0) * CFrame.Angles(currentPitch, 0, currentRoll)\n\tend\n\tlocal lp = Players.LocalPlayer\n\tlocal char = lp and lp.Character\n\tlocal hrp = char and char:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif hrp then\n\t\tlocal yaw = AirMovementController.GetLockedTakeoffYaw()\n\t\tlocal pitch, roll = AirMovementController.GetAirLean()\n\t\treturn CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, roll)\n\tend\n\treturn CFrame.identity\nend\n\nreturn table.freeze(AirMovementController)\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\n\t\t-- Grounded: Smoothly return lean to neutral\n\t\tif math.abs(currentPitch) > 0.001 or math.abs(currentRoll) > 0.001 then\n\t\t\tlocal returnFactor = math.clamp(dt * JumpConfigs.LEAN_RETURN_SPEED, 0, 1)\n\t\t\tcurrentPitch += (0 - currentPitch) * returnFactor\n\t\t\tcurrentRoll += (0 - currentRoll) * returnFactor\n\n\t\t\tif math.abs(currentPitch) < 0.001 and math.abs(currentRoll) < 0.001 then\n\t\t\t\tcurrentPitch = 0\n\t\t\t\tcurrentRoll = 0\n\t\t\t\tresetJoints()\n\t\t\telse\n\t\t\t\tapplyLeanJoint(currentPitch, currentRoll)\n\t\t\t\tsyncCharacterTelemetry()\n]====]\n"},{"disk":"src/server/services/SprintService.luau","studioPath":["ServerScriptService","Server","services","SprintService"],"className":"ModuleScript","content":"--!strict\n-- src/server/services/SprintService.luau\n-- Authoritative Server Service for Player Sprint Mechanics\n-- Governed by RF02-IDLE-RUNTIME Contract (Owner Scope Delta 2026-10-26 & Additive Scope)\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Network = require(Shared:WaitForChild(\"Network\"))\nlocal SprintConfigs = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"SprintConfigs\"))\nlocal DribbleActionConfigs = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"DribbleActionConfigs\"))\nlocal SprintSpeedRules = require(Shared:WaitForChild(\"SprintSpeedRules\"))\n\nlocal lastSprintStartTime: { [Player]: number } = {}\nlocal activeConnections: { [Player]: { RBXScriptConnection } } = {}\nlocal characterGenerations: { [Player]: number } = {}\nlocal speedStates: { [Player]: SprintSpeedRules.State } = {}\nlocal isInitialized = false\n\nlocal SprintService = {}\n\nlocal function cleanupPlayer(player: Player)\n\tlastSprintStartTime[player] = nil\n\tcharacterGenerations[player] = nil\n\tspeedStates[player] = nil\n\tlocal conns = activeConnections[player]\n\tif conns then\n\t\tfor _, c in ipairs(conns) do\n\t\t\tc:Disconnect()\n\t\tend\n\t\tactiveConnections[player] = nil\n\tend\nend\n\nlocal function setSprintState(player: Player, shouldSprint: boolean, forward: number?, lateral: number?)\n\tlocal character = player.Character\n\tif not character or not character:IsDescendantOf(game) then\n\t\treturn\n\tend\n\n\tlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\tif not humanoid or humanoid.Health <= 0 or humanoid.RigType ~= Enum.HumanoidRigType.R15 then\n\t\treturn\n\tend\n\t-- Owner-approved G close-control mode: Shift cannot raise its server speed cap.\n\tif character:GetAttribute(\"GoalDribbleActive\") == true or character:GetAttribute(\"ServerShotPhase\") == \"Charging\" then\n\t\tspeedStates[player] = nil\n\t\thumanoid.WalkSpeed = DribbleActionConfigs.GOAL_SPEED\n\t\tcharacter:SetAttribute(\"IsSprinting\", false)\n\t\tif shouldSprint then\n\t\t\tcharacter:SetAttribute(\"SprintRejectedSeq\", (character:GetAttribute(\"SprintRejectedSeq\") or 0) + 1)\n\t\tend\n\t\treturn\n\tend\n\n\tif shouldSprint then\n\t\t-- Verify not in a state that forbids sprinting\n\t\tlocal state = humanoid:GetState()\n\t\tif state == Enum.HumanoidStateType.Jumping\n\t\t\tor state == Enum.HumanoidStateType.Freefall\n\t\t\tor state == Enum.HumanoidStateType.Climbing\n\t\t\tor state == Enum.HumanoidStateType.Swimming\n\t\t\tor state == Enum.HumanoidStateType.Seated\n\t\t\tor state == Enum.HumanoidStateType.Dead\n\t\t\tor state == Enum.HumanoidStateType.Physics\n\t\t\tor state == Enum.HumanoidStateType.PlatformStanding then\n\t\t\thumanoid.WalkSpeed = SprintConfigs.NORMAL_WALK_SPEED\n\t\t\tcharacter:SetAttribute(\"IsSprinting\", false)\n\t\t\tcharacter:SetAttribute(\"SprintRejectedSeq\", (character:GetAttribute(\"SprintRejectedSeq\") or 0) + 1)\n\t\t\treturn\n\t\tend\n\n\t\tlocal speedState = speedStates[player] or SprintSpeedRules.New()\n\t\tspeedStates[player] = speedState\n\t\tSprintSpeedRules.SetDirection(speedState, forward or 0, lateral or 0, os.clock())\n\t\thumanoid.WalkSpeed = speedState.speed\n\t\tcharacter:SetAttribute(\"SprintForward\", forward == 1)\n\t\tcharacter:SetAttribute(\"SprintTurnUntil\", speedState.penaltyUntil)\n\t\tcharacter:SetAttribute(\"IsSprinting\", true)\n\telse\n\t\thumanoid.WalkSpeed = SprintConfigs.NORMAL_WALK_SPEED\n\t\tcharacter:SetAttribute(\"IsSprinting\", false)\n\tend\nend\n\nlocal function onSprintIntentRequest(player: Player, payload: any)\n\tlocal shouldSprint: boolean = false\n\tlocal forward = 0\n\tlocal lateral = 0\n\n\t-- Security Gate 1: Strict validation of client intent payload (RF-F44 fix & 360° Analog Sprint).\n\t-- Never accepts arbitrary client speed/velocity. Server chooses authoritative configured speed.\n\t-- Sprint allowed when Shift is held and character is moving (isMoving == true, or forward ~= 0).\n\tif typeof(payload) == \"table\" then\n\t\tlocal isShiftHeld = payload.isShiftHeld\n\t\tif typeof(isShiftHeld) ~= \"boolean\" then\n\t\t\treturn\n\t\tend\n\n\t\tlocal lateralValue = if payload.lateral == nil then 0 else payload.lateral\n\t\tif not SprintSpeedRules.IsAxis(payload.forward) or not SprintSpeedRules.IsAxis(lateralValue) then return end\n\t\tforward = payload.forward\n\t\tlateral = lateralValue\n\t\tlocal isMoving = false\n\t\tif typeof(payload.isMoving) == \"boolean\" then\n\t\t\tisMoving = payload.isMoving\n\t\telseif typeof(payload.forward) == \"number\" then\n\t\t\t-- Backwards-compatible domain check: domain must be {-1, 0, 1}\n\t\t\tif payload.forward ~= -1 and payload.forward ~= 0 and payload.forward ~= 1 then\n\t\t\t\treturn\n\t\t\tend\n\t\t\tisMoving = (payload.forward ~= 0)\n\t\telse\n\t\t\treturn\n\t\tend\n\n\t\tif isMoving ~= (forward ~= 0 or lateral ~= 0) then return end\n\t\tshouldSprint = (isShiftHeld == true and isMoving == true)\n\telseif payload == false then\n\t\t-- Fail-safe stop request is allowed as a boolean `false`\n\t\tshouldSprint = false\n\telse\n\t\t-- Malformed payload (nil, true without direction, number, string, array, etc.): reject safely\n\t\treturn\n\tend\n\n\t-- Security Gate 2: If requesting to start sprint, apply rate limiting to prevent network spam.\n\t-- If requesting to stop (shouldSprint == false), NEVER rate-limit, guaranteeing release can never get stuck!\n\tif shouldSprint then\n\t\tlocal now = os.clock()\n\t\tlocal lastStart = lastSprintStartTime[player] or 0\n\t\tif (now - lastStart) < SprintConfigs.START_RATE_LIMIT_INTERVAL_SEC\n\t\t\tand not (player.Character and player.Character:GetAttribute(\"IsSprinting\") == true) then\n\t\t\t-- Rate limit exceeded: reject start request and signal rejection sequence (RF-F45/RF-F48 fix)\n\t\t\tlocal char = player.Character\n\t\t\tif char and char:IsDescendantOf(game) then\n\t\t\t\tlocal hum = char:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif hum then\n\t\t\t\t\thum.WalkSpeed = if char:GetAttribute(\"GoalDribbleActive\") == true or char:GetAttribute(\"ServerShotPhase\") == \"Charging\" then DribbleActionConfigs.GOAL_SPEED else SprintConfigs.NORMAL_WALK_SPEED\n\t\t\t\tend\n\t\t\t\tchar:SetAttribute(\"IsSprinting\", false)\n\t\t\t\tchar:SetAttribute(\"SprintRejectedSeq\", (char:GetAttribute(\"SprintRejectedSeq\") or 0) + 1)\n\t\t\tend\n\t\t\treturn\n\t\tend\n\t\tlastSprintStartTime[player] = now\n\tend\n\n\t-- Security Gate 3: Live R15 character validation and authoritative speed assignment\n\tsetSprintState(player, shouldSprint, forward, lateral)\nend\n\nlocal function bindCharacter(player: Player, character: Model)\n\tspeedStates[player] = nil\n\tlocal currentGen = (characterGenerations[player] or 0) + 1\n\tcharacterGenerations[player] = currentGen\n\n\t-- Disconnect previous connections for this player\n\tlocal prevConns = activeConnections[player]\n\tif prevConns then\n\t\tfor _, c in ipairs(prevConns) do\n\t\t\tc:Disconnect()\n\t\tend\n\t\tactiveConnections[player] = nil\n\tend\n\n\tlocal conns: { RBXScriptConnection } = {}\n\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\n\t-- Post-yield generation and hierarchy verification\n\tif characterGenerations[player] ~= currentGen\n\t\tor player.Character ~= character\n\t\tor not character:IsDescendantOf(game)\n\t\tor not humanoid\n\t\tor not humanoid:IsDescendantOf(character) then\n\t\treturn\n\tend\n\n\t-- Initialize walk speed to baseline normal\n\thumanoid.WalkSpeed = SprintConfigs.NORMAL_WALK_SPEED\n\tcharacter:SetAttribute(\"IsSprinting\", false)\n\n\tlocal shotConn = character:GetAttributeChangedSignal(\"ServerShotPhase\"):Connect(function()\n\t\tif player.Character == character then setSprintState(player,false) end\n\tend)\n\ttable.insert(conns,shotConn)\n\n\t-- Reset sprint on death\n\tlocal diedConn = humanoid.Died:Connect(function()\n\t\tsetSprintState(player, false)\n\tend)\n\ttable.insert(conns, diedConn)\n\n\t-- Reset sprint on airborne, seated, climbing, or swimming states\n\tlocal jumpConn = humanoid.Jumping:Connect(function(active: boolean)\n\t\tif active then\n\t\t\tsetSprintState(player, false)\n\t\tend\n\tend)\n\ttable.insert(conns, jumpConn)\n\n\tlocal fallConn = humanoid.FreeFalling:Connect(function(active: boolean)\n\t\tif active then\n\t\t\tsetSprintState(player, false)\n\t\tend\n\tend)\n\ttable.insert(conns, fallConn)\n\n\tlocal seatConn = humanoid.Seated:Connect(function(active: boolean)\n\t\tif active then\n\t\t\tsetSprintState(player, false)\n\t\tend\n\tend)\n\ttable.insert(conns, seatConn)\n\n\t-- RF-F30 fix: Climbing and Swimming callbacks receive numeric speed, not boolean\n\tlocal climbConn = humanoid.Climbing:Connect(function(speed: number)\n\t\tif speed > 0.1 then\n\t\t\tsetSprintState(player, false)\n\t\tend\n\tend)\n\ttable.insert(conns, climbConn)\n\n\tlocal swimConn = humanoid.Swimming:Connect(function(speed: number)\n\t\tif speed > 0.1 then\n\t\t\tsetSprintState(player, false)\n\t\tend\n\tend)\n\ttable.insert(conns, swimConn)\n\n\tlocal stateConn = humanoid.StateChanged:Connect(function(_oldState, newState)\n\t\tif newState == Enum.HumanoidStateType.Jumping\n\t\t\tor newState == Enum.HumanoidStateType.Freefall\n\t\t\tor newState == Enum.HumanoidStateType.Seated\n\t\t\tor newState == Enum.HumanoidStateType.Climbing\n\t\t\tor newState == Enum.HumanoidStateType.Swimming\n\t\t\tor newState == Enum.HumanoidStateType.Dead then\n\t\t\tsetSprintState(player, false)\n\t\tend\n\tend)\n\ttable.insert(conns, stateConn)\n\n\tactiveConnections[player] = conns\nend\n\nfunction SprintService.Init()\n\tif isInitialized then\n\t\treturn\n\tend\n\tisInitialized = true\n\n\tlocal sprintEvent = Network.GetRemoteEvent(Network.Names.SprintIntentRequest)\n\tassert(sprintEvent ~= nil, \"[SprintService] SprintIntentRequest remote event missing\")\n\n\tsprintEvent.OnServerEvent:Connect(onSprintIntentRequest)\n\tRunService.Heartbeat:Connect(function(dt: number)\n\t\tlocal now = os.clock()\n\t\tfor player, state in pairs(speedStates) do\n\t\t\tlocal char = player.Character\n\t\t\tlocal hum = char and char:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tif char and hum and hum.Health > 0 and char:GetAttribute(\"IsSprinting\") == true then\n\t\t\t\tif char:GetAttribute(\"GoalDribbleActive\") == true or char:GetAttribute(\"ServerShotPhase\") == \"Charging\" then\n\t\t\t\t\tsetSprintState(player, false)\n\t\t\t\telse\n\t\t\t\t\thum.WalkSpeed = SprintSpeedRules.Advance(state, now, dt)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\n\n\tPlayers.PlayerAdded:Connect(function(player)\n\t\tplayer.CharacterAdded:Connect(function(char)\n\t\t\tbindCharacter(player, char)\n\t\tend)\n\t\tplayer.CharacterRemoving:Connect(function()\n\t\t\tcleanupPlayer(player)\n\t\tend)\n\tend)\n\n\tPlayers.PlayerRemoving:Connect(cleanupPlayer)\n\n\t-- Bind existing players\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tplayer.CharacterAdded:Connect(function(char)\n\t\t\tbindCharacter(player, char)\n\t\tend)\n\t\tplayer.CharacterRemoving:Connect(function()\n\t\t\tcleanupPlayer(player)\n\t\tend)\n\t\tif player.Character and player.Character:IsDescendantOf(game) then\n\t\t\tlocal existingChar = player.Character\n\t\t\ttask.spawn(function()\n\t\t\t\tbindCharacter(player, existingChar)\n\t\t\tend)\n\t\tend\n\tend\nend\n\nreturn table.freeze(SprintService)\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\nlocal function setSprintState(player: Player, shouldSprint: boolean)\n\n-- Previous section --\n\t\thumanoid.WalkSpeed = SprintConfigs.SPRINT_SPEED\n\n-- Previous section --\n\t\tif (now - lastStart) < SprintConfigs.START_RATE_LIMIT_INTERVAL_SEC then\n\n-- Previous section --\n\tsetSprintState(player, shouldSprint)\n]====]\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\nlocal function setSprintState(player: Player, shouldSprint: boolean, forward: number?)\n\n-- Previous section --\n\t\thumanoid.WalkSpeed = if forward == 1 then SprintConfigs.SPRINT_SPEED else SprintConfigs.OTHER_DIRECTION_SPEED\n\n-- Previous section --\n\t\tif payload.forward ~= -1 and payload.forward ~= 0 and payload.forward ~= 1 then return end\n\n-- Previous section --\n\tsetSprintState(player, shouldSprint, forward)\n]====]\n"},{"disk":"src/shared/R15PoseSupport.luau","studioPath":["ReplicatedStorage","Shared","R15PoseSupport"],"className":"ModuleScript","content":"--!strict\n-- Canonical normalized R15 authoring geometry; does not move live characters.\ntype JointSample = {p: Vector3?, r: Vector3}\ntype PoseMap = {[string]: JointSample}\nlocal Support = {}\nlocal G_SUPPORT_CHAINS = {\n\tLeft = {\n\t\thip0 = Vector3.new(-0.50000006, -0.387453228, 0.0999825597),\n\t\thip1 = Vector3.new(-0.0755341053, 0.592273593, 0.0578525662),\n\t\tknee0 = Vector3.new(-0.0262608826, -0.761328697, -0.0509277508),\n\t\tknee1 = Vector3.new(-0.00505596399, 0.489029348, -0.15365231),\n\t\tankle0 = Vector3.new(-0.00246268511, -0.467684567, 0.0713348314),\n\t\tankle1 = Vector3.new(0.00442031026, 0.0454355441, 0.255645543),\n\t},\n\tRight = {\n\t\thip0 = Vector3.new(0.49999994, -0.387453228, 0.0999634415),\n\t\thip1 = Vector3.new(0.0755339861, 0.592273414, 0.0578332059),\n\t\tknee0 = Vector3.new(0.0265339613, -0.761112213, -0.0509468839),\n\t\tknee1 = Vector3.new(0.00532895327, 0.489245981, -0.153671652),\n\t\tankle0 = Vector3.new(0.00232899189, -0.467684567, 0.0713181272),\n\t\tankle1 = Vector3.new(-0.00455403328, 0.0454352126, 0.255628645),\n\t},\n}\n\nfunction Support.Ground(pose: PoseMap): PoseMap\n\tlocal function transform(sample: JointSample): CFrame\n\t\treturn CFrame.new(sample.p or Vector3.zero)\n\t\t\t* CFrame.Angles(math.rad(sample.r.X), math.rad(sample.r.Y), math.rad(sample.r.Z))\n\tend\n\tlocal torso = CFrame.new(0, 4.183 - 1.44150245, 0) * transform(pose.LowerTorso)\n\t\t* CFrame.new(0, 0.437955648, -0.0999825597)\n\tlocal bottoms: { number } = {}\n\tfor _, side in ipairs({ \"Left\", \"Right\" }) do\n\t\tlocal chain = G_SUPPORT_CHAINS[side]\n\t\tlocal upper = torso * CFrame.new(chain.hip0) * transform(pose[side .. \"UpperLeg\"]) * CFrame.new(-chain.hip1)\n\t\tlocal lower = upper * CFrame.new(chain.knee0) * transform(pose[side .. \"LowerLeg\"]) * CFrame.new(-chain.knee1)\n\t\tlocal foot = lower * CFrame.new(chain.ankle0) * transform(pose[side .. \"Foot\"]) * CFrame.new(-chain.ankle1)\n\t\tlocal halfHeight = math.abs(foot.XVector.Y) * 0.836178064 / 2\n\t\t\t+ math.abs(foot.YVector.Y) * 0.873450398 / 2\n\t\t\t+ math.abs(foot.ZVector.Y) * 1.242453933 / 2\n\t\ttable.insert(bottoms, foot.Y - halfHeight)\n\tend\n\tlocal delta = bottoms[1] - bottoms[2]\n\tlocal supportBottom = 0.5 * (bottoms[1] + bottoms[2] - math.sqrt(delta * delta + 0.01 * 0.01))\n\tpose.LowerTorso.p = (pose.LowerTorso.p or Vector3.zero) + Vector3.new(0, 0.015 - supportBottom, 0)\n\treturn pose\nend\n\n\n\nfunction Support.FootFrame(root: CFrame, pose: PoseMap, side: string): CFrame\n local function transform(s: JointSample): CFrame\n  return CFrame.new(s.p or Vector3.zero)*CFrame.Angles(math.rad(s.r.X),math.rad(s.r.Y),math.rad(s.r.Z))\n end\n local chain=G_SUPPORT_CHAINS[side]\n local torso=root*CFrame.new(0,-1.44150245,0)*transform(pose.LowerTorso)*CFrame.new(0,0.437955648,-0.0999825597)\n local upper=torso*CFrame.new(chain.hip0)*transform(pose[side..'UpperLeg'])*CFrame.new(-chain.hip1)\n local lower=upper*CFrame.new(chain.knee0)*transform(pose[side..'LowerLeg'])*CFrame.new(-chain.knee1)\n return lower*CFrame.new(chain.ankle0)*transform(pose[side..'Foot'])*CFrame.new(-chain.ankle1)\nend\nreturn table.freeze(Support)\n"},{"disk":"src/shared/JumpAnimationTiming.luau","studioPath":["ReplicatedStorage","Shared","JumpAnimationTiming"],"className":"ModuleScript","content":"--!strict\n-- Source landmarks from jump.md; independent of character movement/physics ownership.\nlocal Timing = {\n\tPushOff = 0.9,\n\tApex = 1.2667,\n\tDescentHold = 1.4667,\n\tLandingStart = 1.5,\n\tLandingEnd = 3,\n\tLandingMoveBlendAfter = 0.18,\n}\n\nfunction Timing.Sample(verticalSpeed: number, launchSpeed: number, passiveFall: boolean): (number, string)\n\tif passiveFall then return Timing.DescentHold, \"Fall\" end\n\tif math.abs(verticalSpeed)<=6 then return Timing.Apex, \"Apex\" end\n\tif verticalSpeed > 0 then\n\t\tlocal progress = 1-math.clamp(verticalSpeed/math.max(1,launchSpeed),0,1)\n\t\treturn Timing.PushOff+(Timing.Apex-Timing.PushOff)*progress,\n\t\t\tif verticalSpeed <= 6 then \"Apex\" else \"Rise\"\n\tend\n\tlocal progress = math.clamp(-verticalSpeed/45,0,1)\n\treturn Timing.Apex+(Timing.DescentHold-Timing.Apex)*progress,\n\t\tif verticalSpeed >= -6 then \"Apex\" else \"Descent\"\nend\n\nreturn table.freeze(Timing)\n"},{"disk":"src/client/character/JumpReferenceData.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","JumpReferenceData"],"className":"ModuleScript","content":"--!strict\n-- Full 91-frame / 3-second Owner reference from animation/jump.md.\n-- Root travel is retained as source data; the jump adapter stays in-place.\nlocal PARTS = { \"LowerTorso\", \"UpperTorso\", \"Head\", \"LeftUpperArm\", \"Le