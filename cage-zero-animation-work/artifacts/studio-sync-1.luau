248 -0.9191 0.0376 0.042 0.2633 0.4032 0.2408 0.7961 -0.039 0.2988 -1.0283 0.0432 0.0208 0.1782 -0.3989 -0.2214\n1.8333 -1.5034 0.1097 -0.9734 -0.2426 0.1352 0.0812 -0.5813 0.0058 -0.0571 0.6253 0.1086 -0.0822 0.079 -0.3796 -0.3991 1.4118 -0.0242 -0.3942 0.1063 0.0316 -0.0881 0.3819 0.7906 0.3812 1.4037 -0.0174 0.4553 0.0835 0.3455 0.0317 0.841 0.033 -0.4132 -0.9351 0.0125 0.0364 0.2405 0.4327 0.2082 0.7773 -0.07 0.29 -1.0265 0.0446 0.0061 0.2251 -0.3958 -0.2187\n1.8667 -1.4977 0.0985 -0.962 -0.2451 0.1154 0.0939 -0.576 0.0454 -0.0046 0.619 0.0475 -0.0932 0.0276 -0.2848 -0.3847 1.243 0.0174 -0.3822 0.1082 -0.0119 -0.0898 0.5256 0.8479 0.4507 1.3833 -0.0206 0.4526 0.116 0.2932 -0.0138 0.9349 0.0226 -0.3724 -0.9254 -0.0222 0.0295 0.1777 0.4776 0.1398 0.6974 -0.1292 0.2724 -1.0258 0.01 -0.0346 0.3071 -0.3997 -0.2093\n1.9 -1.4887 0.0891 -0.9517 -0.2416 0.0915 0.1056 -0.5683 0.0935 0.0583 0.5948 -0.0237 -0.1146 -0.0439 -0.1515 -0.3753 1.0137 0.0703 -0.3547 0.1066 -0.0736 -0.089 0.6945 0.9393 0.5468 1.3492 -0.027 0.4449 0.158 0.2631 -0.0757 1.0368 0.02 -0.3145 -0.8915 -0.0619 0.0268 0.0928 0.5345 0.0496 0.5726 -0.1988 0.2379 -1.0255 -0.0459 -0.0877 0.4005 -0.4094 -0.1958\n1.9333 -1.4769 0.0842 -0.9426 -0.2347 0.063 0.1172 -0.5591 0.1444 0.1202 0.5582 -0.0893 -0.1436 -0.1268 -0.0069 -0.3616 0.7639 0.1206 -0.3123 0.1043 -0.1416 -0.0875 0.8658 1.0586 0.643 1.3014 -0.038 0.4339 0.2099 0.2641 -0.1456 1.1317 0.0243 -0.253 -0.8421 -0.0982 0.031 0.0033 0.5983 -0.0469 0.4238 -0.2623 0.1814 -1.0248 -0.1041 -0.1377 0.4864 -0.4265 -0.18\n1.9667 -1.4635 0.0873 -0.9351 -0.2275 0.0332 0.1288 -0.5475 0.1925 0.1714 0.5172 -0.1407 -0.175 -0.2116 0.118 -0.3394 0.5312 0.1577 -0.2626 0.1022 -0.2034 -0.0864 1.0227 1.1826 0.7128 1.2457 -0.0533 0.4216 0.2663 0.2889 -0.2138 1.2111 0.0296 -0.1968 -0.7936 -0.1211 0.0396 -0.0744 0.6598 -0.1326 0.2794 -0.3089 0.1127 -1.0248 -0.1513 -0.175 0.5562 -0.4493 -0.1648\n2 0 -0.025 0 -0.2212 0 0.1423 -0.5278 0.2451 0.2161 0.4676 -0.1879 -0.2105 -0.3091 0.2278 -0.3045 0.2854 0.1824 -0.2009 0.0984 -0.2647 -0.0872 1.2026 1.3144 0.7439 1.1761 -0.0747 0.4062 0.3299 0.3284 -0.2856 1.2923 0.0329 -0.1352 -0.7528 -0.1288 0.05 -0.1444 0.7257 -0.218 0.13 -0.3483 0.0305 -1.0307 -0.1899 -0.2045 0.6247 -0.4796 -0.1494\n]]\n\nexport type ReferenceFrame = { time: number, travel: Vector3, rotations: { CFrame } }\nlocal frames: { ReferenceFrame } = {}\nlocal times: { number } = {}\nfor line in DATA:gmatch(\"[^\\r\\n]+\") do\n\tlocal values: { number } = {}\n\tfor token in line:gmatch(\"%S+\") do\n\t\tlocal number = tonumber(token)\n\t\tassert(number ~= nil, \"Invalid NPCMotion number\")\n\t\ttable.insert(values, number)\n\tend\n\tassert(#values == 4 + #PARTS * 3, \"NPCMotion frame stride mismatch\")\n\tlocal rotations: { CFrame } = {}\n\tfor index = 1, #PARTS do\n\t\tlocal offset = 5 + (index - 1) * 3\n\t\ttable.insert(rotations, CFrame.Angles(values[offset], values[offset + 1], values[offset + 2]))\n\tend\n\tassert(#frames == 0 or values[1] > frames[#frames].time, \"NPCMotion times must increase\")\n\ttable.insert(frames, { time = values[1], travel = Vector3.new(values[2], values[3], values[4]), rotations = table.freeze(rotations) })\n\ttable.insert(times, values[1])\nend\nassert(#frames == 61 and frames[1].time == 0 and frames[#frames].time == 2, \"NPCMotion shot incomplete\")\nreturn table.freeze({ Parts = table.freeze(PARTS), Frames = table.freeze(frames), Times = table.freeze(times) })\n"},{"disk":"src/shared/ShotModel.luau","studioPath":["ReplicatedStorage","Shared","ShotModel"],"className":"ModuleScript","content":"--!strict\n-- The reference's horizontal travel belongs to locomotion; retain every joint rotation.\nlocal Reference = require(script.Parent.ShotReferenceData)\ntype JointSample = {p: Vector3?, r: Vector3}\ntype JointSample = {p: Vector3?, r: Vector3}\ntype JointSample = {p: Vector3?, r: Vector3}\ntype PoseMap = {[string]: JointSample}\nlocal Model = {}\nlocal Support = require(script.Parent.R15PoseSupport)\nfunction Model.PoseAt(time: number): PoseMap\n local frames = Reference.Frames\n local i = math.clamp(math.floor(time * 30) + 1, 1, #frames - 1)\n while i > 1 and frames[i].time > time do i -= 1 end\n while i < #frames - 1 and frames[i+1].time < time do i += 1 end\n local a,b = frames[i],frames[i+1]\n local alpha = math.clamp((time-a.time)/(b.time-a.time),0,1)\n local pose: PoseMap = {}\n for j,name in Reference.Parts do\n  local rotation = a.rotations[j]:Lerp(b.rotations[j],alpha)\n  local x,y,z = rotation:ToEulerAnglesXYZ()\n  pose[name] = {r=Vector3.new(math.deg(x),math.deg(y),math.deg(z))}\n end\n pose.LowerTorso.p = Vector3.new(0,a.travel.Y+(b.travel.Y-a.travel.Y)*alpha,0)\n return Support.Ground(pose)\nend\n-- Server uses authored FK, never client-replicated animated limb positions.\nfunction Model.FootFrame(root: CFrame, time: number, side: string): CFrame\n return Support.FootFrame(root,Model.PoseAt(time),side)\nend\nreturn table.freeze(Model)\n"},{"disk":"src/shared/ShotRules.luau","studioPath":["ReplicatedStorage","Shared","ShotRules"],"className":"ModuleScript","content":"--!strict\nlocal Config = require(script.Parent.configs.ShotConfigs)\nlocal Rules = {}\n\nfunction Rules.IsFinite(n: any): boolean\n\treturn typeof(n) == \"number\" and n == n and math.abs(n) < math.huge\nend\n\nfunction Rules.IsActionId(id: any): boolean\n\treturn Rules.IsFinite(id) and id >= 1 and id <= 2147483647 and id % 1 == 0\nend\n\nfunction Rules.Aim(value: any): Vector3?\n\tif typeof(value) ~= \"Vector3\" or not Rules.IsFinite(value.X)\n\t\tor not Rules.IsFinite(value.Y) or not Rules.IsFinite(value.Z) then return nil end\n\tlocal magnitude = value.Magnitude\n\tif magnitude < 0.5 or magnitude > 1.5 then return nil end\n\tlocal unit = value / magnitude\n\t-- Ground kick permits low shots and deliberate loft; no backward vertical singularity.\n\tif unit.Y < -0.95 or unit.Y > 0.8 then return nil end\n\treturn unit\nend\n\nfunction Rules.Velocity(aim: Vector3, charge: number): Vector3\n\tlocal power = math.clamp(charge / Config.MaxChargeSec, 0, 1)\n\treturn aim * (Config.MinSpeed + (Config.MaxSpeed - Config.MinSpeed) * power)\nend\n\nfunction Rules.Touches(foot: CFrame, ball: Vector3, radius: number): boolean\n\tlocal p = foot:PointToObjectSpace(ball)\n\tlocal half = Config.FootHalfSize\n\tlocal gap = Vector3.new(math.max(0, math.abs(p.X) - half.X),\n\t\tmath.max(0, math.abs(p.Y) - half.Y), math.max(0, math.abs(p.Z) - half.Z))\n\treturn gap.Magnitude <= radius + Config.ContactTolerance\nend\n\nreturn table.freeze(Rules)\n"},{"disk":"src/shared/configs/ShotConfigs.luau","studioPath":["ReplicatedStorage","Shared","configs","ShotConfigs"],"className":"ModuleScript","content":"--!strict\nreturn table.freeze({\n\tClipName = \"RF02_Shot_R15_v01\",\n\tChargeClipName = \"RF02_ShotChargeBackswing_R15_v02\",\n\tMovingChargeClipName = \"RF02_ShotChargeBackswingMoving_R15_v02\",\n\tChargeHoldAt = 0.22,\n\tChargeFadeSec = 0.12,\n\tAnimationId = \"\", -- Studio registers the authored sequence; publishing is a separate Owner step.\n\tPlaybackRate = 1.25,\n\tSourceEnd = 0.7,\n\tDuration = 0.56,\n\tContactAt = 0.24,\n\tContactEnd = 0.29336,\n\tBlendOutAt = 0.48,\n\tMaxChargeSec = 1.2,\n\tChargeTimeoutSec = 5,\n\tCooldownSec = 0.7,\n\tMinSpeed = 54,\n\tMaxSpeed = 128,\n\tCurveAcceleration = 24,\n\tCurveDurationSec = 0.8,\n\tRecaptureDelaySec = 0.6,\n\tContactTolerance = 0.15,\n\tFootHalfSize = Vector3.new(0.418089032, 0.436725199, 0.621226967),\n\tBallSetupTrackGain = 9.5,\n\tBallSetupMaxRelativeSpeed = 28.0,\n\tBallSetupOffset = Vector3.new(1.3, 0, -2.05),\n})\n"},{"disk":"src/client/controllers/ShotController.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","controllers","ShotController"],"className":"ModuleScript","content":"--!strict\n-- Charge is measured by the server. Animation follows its accepted release timestamp.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UIS = game:GetService(\"UserInputService\")\nlocal Provider = game:GetService(\"KeyframeSequenceProvider\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Config = require(Shared.configs.ShotConfigs)\nlocal Rules = require(Shared.ShotRules)\nlocal ClipData = require(script.Parent.Parent.character.DribbleClipData)\nlocal ChargeClipData = require(script.Parent.Parent.character.ShotChargeClipData)\nlocal player = Players.LocalPlayer\nlocal Controller = {}\nlocal initialized = false\nlocal serial = 0\nlocal held: Enum.UserInputType? = nil\nlocal beganAt = 0\nlocal character: Model? = nil\nlocal track: AnimationTrack? = nil\nlocal animationId: string? = nil\nlocal chargeAnimationId: string? = nil\nlocal movingChargeAnimationId: string? = nil\nlocal chargeTracks: {AnimationTrack} = {}\nlocal chargeTrack: AnimationTrack? = nil\nlocal shownId: number? = nil\nlocal pendingRelease = false\nlocal presentationOnly = false\nlocal generation = 0\nlocal connections: {RBXScriptConnection} = {}\nlocal gauge: TextLabel? = nil\n\nlocal function remote(): RemoteEvent\n\treturn Shared.Parent.CageZeroRemotes.BallActionRequest :: RemoteEvent\nend\n\nlocal function stopChargeTracks(fade: number)\n\tfor _, t in chargeTracks do t:Stop(fade) end\nend\n\nlocal function updateChargePresentation(char: Model, restart: boolean)\n\tlocal hum = char:FindFirstChildOfClass(\"Humanoid\")\n\tlocal root = hum and hum.RootPart\n\tlocal velocity = root and root.AssemblyLinearVelocity or Vector3.zero\n\tlocal moving = hum ~= nil and (hum.MoveDirection.Magnitude > 0.1 or Vector3.new(velocity.X,0,velocity.Z).Magnitude > 1.5)\n\tlocal nextTrack = chargeTracks[if moving then 2 else 1]\n\tif not nextTrack or (not restart and nextTrack == chargeTrack and nextTrack.IsPlaying) then return end\n\tlocal phase = if not restart and chargeTrack then math.min(chargeTrack.TimePosition,Config.ChargeHoldAt) else 0\n\tif chargeTrack then chargeTrack:Stop(Config.ChargeFadeSec) end\n\tchargeTrack = nextTrack\n\tnextTrack:Play(Config.ChargeFadeSec,1,if phase >= Config.ChargeHoldAt then 0 else 1)\n\tnextTrack.TimePosition = phase\nend\n\nlocal function cancel()\n\tif not presentationOnly and character and (held or pendingRelease or character:GetAttribute(\"ShotActive\") == true) then\n\t\tremote():FireServer({action=\"Shot\", phase=\"Cancel\", id=serial})\n\tend\n\theld = nil\n\tpendingRelease = false\n\tpresentationOnly=false\n\tif track then track:Stop(0.1) end\n\tstopChargeTracks(0.1)\n\tif character then\n\t\tcharacter:SetAttribute(\"ShotActive\", false)\n\t\tcharacter:SetAttribute(\"ShotCharging\", false)\n\tend\n\tif gauge then gauge.Visible = false end\nend\n\nlocal function playShotPresentation(char: Model, stamp: number?)\n if not track then return end\n stopChargeTracks(Config.ChargeFadeSec)\n char:SetAttribute(\"ShotActive\",true)\n track:Play(Config.ChargeFadeSec)\n if stamp then track.TimePosition=math.clamp(workspace:GetServerTimeNow()-stamp,0,Config.Duration) end\nend\n\nlocal function bind(char: Model)\n\tcancel()\n\tgeneration += 1\n\tlocal gen = generation\n\tfor _, c in connections do c:Disconnect() end\n\ttable.clear(connections)\n\tif track then track:Destroy(); track = nil end\n\tfor _, t in chargeTracks do t:Destroy() end\n\ttable.clear(chargeTracks);chargeTrack=nil\n\tcharacter = char\n\tshownId = nil\n\tlocal hum = char:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\tlocal animator = hum and hum:WaitForChild(\"Animator\", 5) :: Animator?\n\tif generation ~= gen or not animator or not hum then return end\n\tif not animationId then\n\t\tif Config.AnimationId ~= \"\" then animationId = Config.AnimationId\n\t\telseif RunService:IsStudio() then\n\t\t\tlocal seq = ClipData.BuildKeyframeSequence(Config.ClipName)\n\t\t\tassert(seq, \"Shot sequence missing\")\n\t\t\tanimationId = Provider:RegisterKeyframeSequence(seq)\n   local charge = ChargeClipData.Build(false)\n   chargeAnimationId = Provider:RegisterKeyframeSequence(charge);charge:Destroy()\n   local movingCharge = ChargeClipData.Build(true)\n   movingChargeAnimationId = Provider:RegisterKeyframeSequence(movingCharge);movingCharge:Destroy()\n\t\t\tseq:Destroy()\n\t\telse warn(\"[Shot] Published animation ID required\"); return end\n\tend\n\tlocal anim = Instance.new(\"Animation\")\n\tanim.AnimationId = animationId :: string\n\tanim.Name = Config.ClipName\n\ttrack = animator:LoadAnimation(anim)\n\tanim:Destroy()\n\ttrack.Priority = Enum.AnimationPriority.Action2\n\ttrack.Looped = false\n\tfor i, id in {chargeAnimationId, movingChargeAnimationId} do\n\t\tif id then\n\t\t\tlocal anim = Instance.new(\"Animation\")\n\t\t\tanim.Name = if i==1 then Config.ChargeClipName else Config.MovingChargeClipName\n\t\t\tanim.AnimationId = id\n\t\t\tlocal loaded = animator:LoadAnimation(anim);anim:Destroy()\n\t\t\tloaded.Priority = Enum.AnimationPriority.Action2;loaded.Looped=false\n\t\t\tchargeTracks[i] = loaded\n\t\tend\n\tend\n\ttable.insert(connections, track:GetMarkerReachedSignal(\"BlendOut\"):Connect(function()\n\t\tif track then track:AdjustWeight(0,0.08) end\n\tend))\n\ttable.insert(connections, hum.Died:Connect(cancel))\n\ttable.insert(connections, char:GetAttributeChangedSignal(\"ServerShotPhase\"):Connect(function()\n\t\tif character ~= char then return end\n\t\tlocal phase = char:GetAttribute(\"ServerShotPhase\")\n\t\tlocal id = char:GetAttribute(\"ServerShotId\")\n\t\tif phase == \"Windup\" and id == serial and shownId ~= id and track then\n\t\t\tpendingRelease = false\n\t\t\tshownId = id :: number\n\t\t\tlocal stamp=char:GetAttribute(\"ServerShotStart\")\n\t\t\tplayShotPresentation(char,if typeof(stamp)==\"number\" then stamp else nil)\n\t\telseif phase == \"Cancelled\" or phase == \"Rejected\" then\n\t\t\tif held then presentationOnly=true;pendingRelease=false else cancel() end\n\t\tend\n\tend))\nend\n\nfunction Controller.Init()\n\tif initialized then return end\n\tinitialized = true\n\tlocal gui = Instance.new(\"ScreenGui\")\n\tgui.Name = \"ShotChargeHUD\"\n\tgui.ResetOnSpawn = false\n\tgui.Parent = player:WaitForChild(\"PlayerGui\")\n\tlocal label = Instance.new(\"TextLabel\")\n\tlabel.Size = UDim2.fromOffset(180, 30)\n\tlabel.Position = UDim2.new(0.5, -90, 0.75, 0)\n\tlabel.BackgroundColor3 = Color3.fromRGB(18, 22, 28)\n\tlabel.BackgroundTransparency = 0.2\n\tlabel.TextColor3 = Color3.fromRGB(255, 230, 140)\n\tlabel.TextSize = 18\n\tlabel.Visible = false\n\tlabel.Parent = gui\n\tgauge = label\n\tplayer.CharacterAdded:Connect(function(char) task.spawn(bind, char) end)\n\tif player.Character then task.spawn(bind, player.Character) end\n\tUIS.InputBegan:Connect(function(input, processed)\n\t\tif processed or UIS:GetFocusedTextBox() or held then return end\n\t\tlocal key = input.UserInputType\n\t\tif key ~= Enum.UserInputType.MouseButton1 and key ~= Enum.UserInputType.MouseButton2 then return end\n\t\tlocal char = character\n\t\tlocal hum = char and char:FindFirstChildOfClass(\"Humanoid\")\n\t\tif not char or not hum or hum.Health <= 0 or not track or track.Length <= 0\n\t\t\tor char:GetAttribute(\"ShotActive\") == true\n\t\t\tor hum.FloorMaterial == Enum.Material.Air then return end\n\t\tserial += 1\n\t\tpresentationOnly=char:GetAttribute(\"IsBallCarrier\")~=true\n\t\theld, beganAt = key, os.clock()\n\t\tchar:SetAttribute(\"ShotCharging\", true)\n\t\tupdateChargePresentation(char,true)\n\t\tif not presentationOnly then remote():FireServer({action=\"Shot\", phase=\"Begin\", id=serial}) end\n\tend)\n\tUIS.InputEnded:Connect(function(input)\n\t\tif not held or input.UserInputType ~= held then return end\n\t\tlocal curve = if held == Enum.UserInputType.MouseButton2\n\t\t\tthen (if UIS:IsKeyDown(Enum.KeyCode.A) then -1 else 1) else 0\n\t\theld = nil\n\t\tpendingRelease = true\n\t\tif character then character:SetAttribute(\"ShotCharging\", false) end\n\t\tlocal camera = workspace.CurrentCamera\n\t\tlocal aim = camera and Rules.Aim(camera.CFrame.LookVector)\n\t\tif not aim or UIS:GetFocusedTextBox() then cancel(); remote():FireServer({action=\"Shot\",phase=\"Cancel\",id=serial}); return end\n\t\tif character then character:SetAttribute(\"ShotVisualAim\",aim) end\n  if presentationOnly or not character or character:GetAttribute(\"IsBallCarrier\")~=true then\n   pendingRelease=false\n   if character then playShotPresentation(character,nil) end\n  else remote():FireServer({action=\"Shot\",phase=\"Release\",id=serial,aim=aim,curve=curve}) end\n\tend)\n\tUIS.WindowFocusReleased:Connect(cancel)\n\tRunService.PreAnimation:Connect(function()\n\t\tif (held or pendingRelease) and chargeTrack and chargeTrack.IsPlaying and chargeTrack.TimePosition >= Config.ChargeHoldAt then\n\t\t\tchargeTrack.TimePosition=Config.ChargeHoldAt;chargeTrack:AdjustSpeed(0)\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function()\n\t\tlocal char = character\n\t\tif held and char then updateChargePresentation(char,false) end\n\t\tif held and char and workspace.CurrentCamera then\n\t\t\tchar:SetAttribute(\"ShotChargeAim\", workspace.CurrentCamera.CFrame.LookVector)\n\t\tend\n\t\tif held and (not char\n\t\t\tor os.clock()-beganAt > Config.ChargeTimeoutSec) then cancel() end\n\t\tif char and char:GetAttribute(\"ShotActive\") == true and track then\n\t\t\tif not track.IsPlaying or track.TimePosition >= Config.Duration-0.01 then char:SetAttribute(\"ShotActive\",false) end\n\t\tend\n\t\tlabel.Visible = held ~= nil\n\t\tif held then label.Text = string.format(\"ยิง %d%%\", math.clamp((os.clock()-beganAt)/Config.MaxChargeSec,0,1)*100) end\n\tend)\nend\n\nreturn Controller\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\nlocal Cut = require(script.Parent.DribbleCutController)\n\n-- Previous section --\n\t\t\tCut.Cancel()\n\n-- Previous section --\n\t\t\tor char:GetAttribute(\"DribbleCutActive\") == true or hum.FloorMaterial == Enum.Material.Air then return end\n]====]\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\n\tif chargeTrack then chargeTrack:Stop(0.1) end\n\n-- Previous section --\n if chargeTrack then chargeTrack:Stop(0.06) end\n\n-- Previous section --\n track:Play(0.06)\n\n-- Previous section --\n\tif chargeTrack then chargeTrack:Destroy();chargeTrack=nil end\n\n-- Previous section --\n   seq.Name = Config.ClipName..\"_ChargeUpperBody\"\n   for _,pose in seq:GetDescendants() do\n    if pose:IsA(\"Pose\") and (pose.Name==\"LowerTorso\" or pose.Name:find(\"Leg\") or pose.Name:find(\"Foot\")) then pose.Weight=0 end\n   end\n   chargeAnimationId=Provider:RegisterKeyframeSequence(seq)\n\n-- Previous section --\n\tif chargeAnimationId then\n\t\tlocal charge=Instance.new(\"Animation\");charge.Name=\"ShotChargeUpperBody\";charge.AnimationId=chargeAnimationId\n\t\tchargeTrack=animator:LoadAnimation(charge);chargeTrack.Priority=Enum.AnimationPriority.Action2;charge:Destroy()\n\n-- Previous section --\n\t\tif chargeTrack then chargeTrack:Play(0.1,1,0);chargeTrack.TimePosition=0 end\n]====]\n"},{"disk":"src/shared/DribbleCutTimeline.luau","studioPath":["ReplicatedStorage","Shared","DribbleCutTimeline"],"className":"ModuleScript","content":"-- Retired by Owner: retained as comments, no runtime implementation.\n--[====[\n--!strict\n-- Shared authored times for sprint-cut.md (61 source frames / 2 seconds).\n-- Marker callbacks advance gameplay; these times validate/order intent, never fabricate a strike.\nlocal Timeline = {}\nTimeline.SourceDuration = 2.0\nTimeline.Duration = 0.7\nTimeline.TimeScale = Timeline.Duration / Timeline.SourceDuration\nTimeline.TrapAt = 0.1333 * Timeline.TimeScale\nTimeline.StrikeAt = 0.2667 * Timeline.TimeScale\nTimeline.ReleaseAt = 1.9 * Timeline.TimeScale\nTimeline.BlendOutAt = 1.8 * Timeline.TimeScale\nTimeline.TrapDistance = 2.55\nTimeline.PushLead = 0.45\nTimeline.EarlyTolerance = 0.025\nTimeline.LateTolerance = 0.18\nTimeline.SprintGraceSec = 0.12\n\nexport type Profile = { TrapFoot: string, StrikeFoot: string }\nlocal left = table.freeze({ TrapFoot = \"L\", StrikeFoot = \"L\" })\nlocal right = table.freeze({ TrapFoot = \"R\", StrikeFoot = \"R\" })\nlocal profiles: { [string]: Profile } = {\n\tFrontLeft = left, FrontRight = right, BackLeft = left, BackRight = right,\n\t-- Existing reversal bindings share one left-pivot clip.\n\tReverseLeft = left, ReverseRight = left,\n}\n\nfunction Timeline.Get(cut: string): Profile?\n\treturn profiles[cut]\nend\n\nfunction Timeline.HasSprintContext(active: boolean, lastSprintAt: number?, now: number): boolean\n\treturn active or (lastSprintAt ~= nil and now >= lastSprintAt and now - lastSprintAt <= Timeline.SprintGraceSec)\nend\n\nfunction Timeline.ValidateMarker(profile: Profile, phase: any, foot: any, elapsed: number): boolean\n\tif elapsed ~= elapsed or math.abs(elapsed) == math.huge then return false end\n\tlocal time: number\n\tlocal expectedFoot: string\n\tif phase == \"Trap\" then\n\t\ttime, expectedFoot = Timeline.TrapAt, profile.TrapFoot\n\telseif phase == \"Strike\" then\n\t\ttime, expectedFoot = Timeline.StrikeAt, profile.StrikeFoot\n\telseif phase == \"Release\" then\n\t\ttime, expectedFoot = Timeline.ReleaseAt, profile.StrikeFoot\n\telse\n\t\treturn false\n\tend\n\treturn foot == expectedFoot and elapsed >= time - Timeline.EarlyTolerance and elapsed <= time + Timeline.LateTolerance\nend\n\nfunction Timeline.DirectionAlpha(time: number): number\n\tlocal t = math.clamp((time - Timeline.StrikeAt) / (Timeline.ReleaseAt - Timeline.StrikeAt), 0, 1)\n\treturn t * t * (3 - 2 * t)\nend\n\nfunction Timeline.SpeedFactor(time: number): number\n\tif time < Timeline.TrapAt then\n\t\tlocal t = math.clamp(time / Timeline.TrapAt, 0, 1)\n\t\treturn 1 - 0.55 * t * t * (3 - 2 * t)\n\telseif time < Timeline.StrikeAt then\n\t\treturn 0.45\n\tend\n\treturn 0.45 + 0.55 * Timeline.DirectionAlpha(time)\nend\n\nreturn table.freeze(Timeline)\n\n]====]\n"},{"disk":"src/shared/configs/DribbleActionConfigs.luau","studioPath":["ReplicatedStorage","Shared","configs","DribbleActionConfigs"],"className":"ModuleScript","content":"--!strict\n-- Owner-approved G hold / R15 dribble animation runtime bindings.\n-- Governed by RF02-DRIBBLE-ANIMATION-INTEGRATION Contract (2026-10-27).\n\nlocal RunService = game:GetService(\"RunService\")\n\nexport type DribbleClipSpec = {\n\tClipName: string,\n\tExpectedKeyframeCount: number,\n\tExpectedDuration: number,\n\tDurationTolerance: number,\n\tExpectedLoop: boolean,\n\tExpectedPriority: Enum.AnimationPriority,\n\tExpectedDrivenJoints: number,\n\tExpectedMarkerCount: number,\n\tControlReleaseTime: number?,\n}\n\nlocal DribbleActionConfigs = {}\n\nDribbleActionConfigs.GOAL_SPEED = 8.0\nDribbleActionConfigs.GOAL_BALL_DISTANCE = 1.95\nDribbleActionConfigs.GOAL_CARRIER_SEPARATION = 1.85\nDribbleActionConfigs.GOAL_INTENT_TIMEOUT = 0.5\nDribbleActionConfigs.INTENT_INTERVAL = 0.1\nDribbleActionConfigs.STUDIO_FALLBACK_ENABLED = true\nDribbleActionConfigs.PREVIEW_RIG_PATH = \"Workspace.PreviewRigs.PreviewRig_R15_Boy_Height30\"\nDribbleActionConfigs.ANIMSAVES_CONTAINER = \"AnimSaves\"\nDribbleActionConfigs.LOOP_FADE_SEC = 0.18\nDribbleActionConfigs.WALK_BASE_SPEED = 16.0\nDribbleActionConfigs.RUN_BASE_SPEED = 32.0\nDribbleActionConfigs.GOAL_BASE_SPEED = 8.0\n\n-- Marker-driven forward touch coordination (bounded, server-validated)\nDribbleActionConfigs.TOUCH_INTENT_COOLDOWN_SEC = 0.08\nDribbleActionConfigs.TOUCH_PULSE_DURATION_SEC = 0.24\nDribbleActionConfigs.TOUCH_PULSE_BOOST_WALK = 0.38\nDribbleActionConfigs.TOUCH_PULSE_BOOST_RUN = 0.62\nDribbleActionConfigs.TOUCH_PULSE_BOOST_GOAL = 0.18\n-- Orbit / radial speed multiplier when an animation foot-touch marker strikes the ball\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_WALK = 1.65\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_RUN = 2.05\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_GOAL = 1.35\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_WALK = 4.5\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_RUN = 8.5\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_GOAL = 1.2\n\n-- Published asset IDs remain nil until officially published; Studio uses validated local KeyframeSequences.\nDribbleActionConfigs.PublishedIds = table.freeze({\n\tWalkDribble = nil :: string?,\n\tRunDribble = nil :: string?,\n\tGModeLoop = nil :: string?,\n\tGoalForward = nil :: string?,\n\tGoalBackward = nil :: string?,\n\tGoalLeft = nil :: string?,\n\tGoalRight = nil :: string?,\n})\n\nDribbleActionConfigs.Clips = table.freeze({\n\tWalkDribble = table.freeze({\n\t\tClipName = \"RF02_WalkDribble_R15_v01\",\n\t\tExpectedKeyframeCount = 91,\n\t\tExpectedDuration = 3.0,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 6,\n\t}) :: DribbleClipSpec,\n\n\tRunDribble = table.freeze({\n\t\tClipName = \"RF02_RunDribble_R15_v01\",\n\t\tExpectedKeyframeCount = 145,\n\t\tExpectedDuration = 0.72,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n\n\tGModeLoop = table.freeze({\n\t\tClipName = \"RF02_GMode_SlowControlLoop_R15_v01\",\n\t\tExpectedKeyframeCount = 225,\n\t\tExpectedDuration = 1.12,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n\n\tGoalForward = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollForward_W_R15_v01\",\n\t\tExpectedKeyframeCount = 129,\n\t\tExpectedDuration = 0.64,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 4,\n\t}) :: DribbleClipSpec,\n\n\tGoalBackward = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollBackward_S_R15_v01\",\n\t\tExpectedKeyframeCount = 129,\n\t\tExpectedDuration = 0.64,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 4,\n\t}) :: DribbleClipSpec,\n\n\tGoalLeft = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollLeft_A_R15_v01\",\n\t\tExpectedKeyframeCount = 193,\n\t\tExpectedDuration = 0.96,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n\n\tGoalRight = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleRollRight_D_R15_v01\",\n\t\tExpectedKeyframeCount = 193,\n\t\tExpectedDuration = 0.96,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = true,\n\t\tExpectedPriority = Enum.AnimationPriority.Movement,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t}) :: DribbleClipSpec,\n})\n\nlocal recognizedClipNames: { [string]: boolean } = {\n\tRF02_WalkDribble_R15_v01 = true,\n\tRF02_RunDribble_R15_v01 = true,\n\tRF02_GMode_SlowControlLoop_R15_v01 = true,\n\tRF02_GMode_SoleRollForward_W_R15_v01 = true,\n\tRF02_GMode_SoleRollBackward_S_R15_v01 = true,\n\tRF02_GMode_SoleRollLeft_A_R15_v01 = true,\n\tRF02_GMode_SoleRollRight_D_R15_v01 = true,\n}\n\nfunction DribbleActionConfigs.IsRecognizedClipName(clipName: string): boolean\n\treturn recognizedClipNames[clipName] == true\nend\n\nfunction DribbleActionConfigs.IsGoalModeClipName(clipName: string): boolean\n\treturn clipName == \"RF02_GMode_SlowControlLoop_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollForward_W_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollBackward_S_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollLeft_A_R15_v01\"\n\t\tor clipName == \"RF02_GMode_SoleRollRight_D_R15_v01\"\nend\n\nfunction DribbleActionConfigs.IsStudioFallbackAllowed(): boolean\n\treturn DribbleActionConfigs.STUDIO_FALLBACK_ENABLED and RunService:IsStudio()\nend\n\nreturn table.freeze(DribbleActionConfigs)\n\n--[====[\nRetired/replaced code retained as comments at Owner request (2026-10-30).\nOriginal complete source is also in the external backup.\n\n-- Owner-approved G hold / discrete ball-lock cuts / R15 dribble animation runtime bindings.\n\n-- Previous section --\nDribbleActionConfigs.CUT_REVERSE_ANGLE_DEG = 120\nDribbleActionConfigs.CUT_MOUSE_STEER_DIAG_FRONT_DEG = 34\nDribbleActionConfigs.CUT_MOUSE_STEER_DIAG_BACK_DEG = 88\nDribbleActionConfigs.CUT_MAX_DURATION = 2.2\nDribbleActionConfigs.CUT_FADE_SEC = 0.15\nDribbleActionConfigs.SPRINT_CUT_FADE_SEC = 0.05\nDribbleActionConfigs.CUT_FADE_OUT_SEC = 0.18\nDribbleActionConfigs.SPRINT_CUT_FADE_OUT_SEC = 0.07\nDribbleActionConfigs.CUT_COOLDOWN_SEC = 0.20\nDribbleActionConfigs.REVERSE_INPUT_GRACE_SEC = 0.25\n\n-- Base factors; marker-driven sprint cuts additionally apply DribbleCutTimeline.SpeedFactor.\nDribbleActionConfigs.CUT_MOVE_SPEED_FACTOR = 1.0\nDribbleActionConfigs.CUT_MOVE_SPEED_FACTOR_REVERSE = 1.0\nDribbleActionConfigs.CUT_SPEED_RECOVERY_PER_SEC = 8.0\n-- Server-side: ball stays on the pre-cut line during wind-up, then slides linearly along the diagonal line once the boot strikes it (TouchL/TouchR).\nDribbleActionConfigs.CUT_BALL_INTENT_GRACE_SEC = 0.08\n-- Legacy fallback for the unchanged GoalReverse clip; new sprint cuts require marker intent.\nDribbleActionConfigs.CUT_BALL_STRIKE_PHASE = 0.36\nDribbleActionConfigs.CUT_BALL_LEAD_WALK = 0.0\nDribbleActionConfigs.CUT_BALL_LEAD_SPRINT = 0.90\nDribbleActionConfigs.CUT_BALL_LEAD_GOAL = 0.0\nDribbleActionConfigs.CUT_LINEAR_TRACK_GAIN = 9.5\nDribbleActionConfigs.CUT_LINEAR_MAX_REL_SPEED = 28.0\n\n\n-- Previous section --\nDribbleActionConfigs.TOUCH_PULSE_BOOST_CUT = 0.35\n\n-- Previous section --\nDribbleActionConfigs.TOUCH_ORBIT_SPEED_BOOST_CUT = 1.50\n\n-- Previous section --\nDribbleActionConfigs.TOUCH_KICK_SPEED_IMPULSE_CUT = 4.0\n\n-- Previous section --\n\tFrontLeft = nil :: string?,\n\tFrontRight = nil :: string?,\n\tBackLeft = nil :: string?,\n\tBackRight = nil :: string?,\n\tReverseLeft = nil :: string?,\n\tReverseRight = nil :: string?,\n\tGoalReverse = nil :: string?,\n\n-- Previous section --\nDribbleActionConfigs.ApprovedCutAnimations = table.freeze({\n\tFrontLeft = \"RF02_CutDiagFrontLeft_AW_R15_v01\",\n\tFrontRight = \"RF02_CutDiagFrontRight_WD_R15_v01\",\n\tBackLeft = \"RF02_CutDiagBackLeft_AS_R15_v01\",\n\tBackRight = \"RF02_CutDiagBackRight_SD_R15_v01\",\n\tReverseLeft = \"RF02_CutReverse_WS_R15_v01\",\n\tReverseRight = \"RF02_CutReverse_WS_R15_v01\",\n\tGoalReverse = \"RF02_GMode_SoleDragBack_WS_R15_v01\",\n})\n\n\n-- Previous section --\n\tFrontLeft = table.freeze({\n\t\tClipName = \"RF02_CutDiagFrontLeft_AW_R15_v01\",\n\t\tExpectedKeyframeCount = 61,\n\t\tExpectedDuration = 0.7,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 6,\n\t\tControlReleaseTime = 0.665,\n\t}) :: DribbleClipSpec,\n\n\tFrontRight = table.freeze({\n\t\tClipName = \"RF02_CutDiagFrontRight_WD_R15_v01\",\n\t\tExpectedKeyframeCount = 61,\n\t\tExpectedDuration = 0.7,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 6,\n\t\tControlReleaseTime = 0.665,\n\t}) :: DribbleClipSpec,\n\n\tBackLeft = table.freeze({\n\t\tClipName = \"RF02_CutDiagBackLeft_AS_R15_v01\",\n\t\tExpectedKeyframeCount = 61,\n\t\tExpectedDuration = 0.7,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 6,\n\t\tControlReleaseTime = 0.665,\n\t}) :: DribbleClipSpec,\n\n\tBackRight = table.freeze({\n\t\tClipName = \"RF02_CutDiagBackRight_SD_R15_v01\",\n\t\tExpectedKeyframeCount = 61,\n\t\tExpectedDuration = 0.7,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 6,\n\t\tControlReleaseTime = 0.665,\n\t}) :: DribbleClipSpec,\n\n\tReverseLeft = table.freeze({\n\t\tClipName = \"RF02_CutReverse_WS_R15_v01\",\n\t\tExpectedKeyframeCount = 61,\n\t\tExpectedDuration = 0.7,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 6,\n\t\tControlReleaseTime = 0.665,\n\t}) :: DribbleClipSpec,\n\n\tReverseRight = table.freeze({\n\t\tClipName = \"RF02_CutReverse_WS_R15_v01\",\n\t\tExpectedKeyframeCount = 61,\n\t\tExpectedDuration = 0.7,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 6,\n\t\tControlReleaseTime = 0.665,\n\t}) :: DribbleClipSpec,\n\n\tGoalReverse = table.freeze({\n\t\tClipName = \"RF02_GMode_SoleDragBack_WS_R15_v01\",\n\t\tExpectedKeyframeCount = 149,\n\t\tExpectedDuration = 0.74,\n\t\tDurationTolerance = 0.05,\n\t\tExpectedLoop = false,\n\t\tExpectedPriority = Enum.AnimationPriority.Action,\n\t\tExpectedDrivenJoints = 15,\n\t\tExpectedMarkerCount = 5,\n\t\tControlReleaseTime = 0.62,\n\t}) :: DribbleClipSpec,\n\n\n-- Previous section --\n\tRF02_CutDiagFrontLeft_AW_R15_v01 = true,\n\tRF02_CutDiagFrontRight_WD_R15_v01 = true,\n\tRF02_CutDiagBackLeft_AS_R15_v01 = true,\n\tRF02_CutDiagBackRight_SD_R15_v01 = true,\n\tRF02_CutReverse_WS_R15_v01 = true,\n\n-- Previous section --\n\tRF02_GMode_SoleDragBack_WS_R15_v01 = true,\n\n-- Previous section --\n\t\tor clipName == \"RF02_GMode_SoleDragBack_WS_R15_v01\"\n]====]\n"},{"disk":"src/shared/DribbleGeometryHelper.luau","studioPath":["ReplicatedStorage","Shared","DribbleGeometryHelper"],"className":"ModuleScript","content":"--!strict\n-- src/shared/DribbleGeometryHelper.luau\n-- Continuous front-foot control + joint body/cage clearance + jump self-lob\n-- Governed by RF02-DRIBBLE-RECEIVE (2026-10-27 Authoritative Grill Final).\n-- Pure functions over Vector3; the ONLY authority is the server BallService caller.\n-- Assumptions (not measured rig bounds): carrier = upright cylinder radius CARRIER_BODY_RADIUS, ball = sphere BALL_COLLISION_RADIUS.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Constants = require(Shared:WaitForChild(\"Constants\"))\nlocal DribbleConfigs = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"DribbleConfigs\"))\n\nlocal DribbleGeometryHelper = {}\n\nlocal EPS = 1e-4\n\nlocal function horiz(v: Vector3): Vector3\n\treturn Vector3.new(v.X, 0, v.Z)\nend\n\nlocal function safeUnit(v: Vector3, fallback: Vector3): Vector3\n\tlocal m = v.Magnitude\n\tif m > EPS and m == m then\n\t\treturn v / m\n\tend\n\treturn fallback\nend\n\nlocal function clampMag(v: Vector3, maxMag: number): Vector3\n\tlocal m = v.Magnitude\n\tif m > maxMag and m > EPS then\n\t\treturn v * (maxMag / m)\n\tend\n\treturn v\nend\n\n-- Ball-center limits inside the cage box (cage physics itself is untouched).\nlocal function cageLimits(): (number, number)\n\tlocal r = DribbleConfigs.BALL_COLLISION_RADIUS\n\treturn Constants.ARENA_HALF_WIDTH_X - r, Constants.ARENA_HALF_LENGTH_Z - r\nend\n\nlocal function insideCage(x: number, z: number): boolean\n\tlocal mx, mz = cageLimits()\n\treturn math.abs(x) <= mx + 1e-6 and math.abs(z) <= mz + 1e-6\nend\n\nfunction DribbleGeometryHelper.GetCarrierSeparationDistance(): number\n\treturn DribbleConfigs.CARRIER_BODY_RADIUS + DribbleConfigs.BALL_COLLISION_RADIUS + DribbleConfigs.MIN_BODY_SEPARATION_MARGIN\nend\n\n-- Shared feet origin: feet = RootPart.Y - PLAYER_FEET_OFFSET\nfunction DribbleGeometryHelper.GetFeetY(rootY: number): number\n\treturn rootY - DribbleConfigs.PLAYER_FEET_OFFSET\nend\n\n-- Turn slow-down factor for DRIBBLING carriers: 1 at/below threshold (120 deg), MIN at 180 degrees.\nfunction DribbleGeometryHelper.ComputeTurnSpeedFactor(angleRad: number, isSprinting: boolean): number\n\tlocal thresh = math.rad(DribbleConfigs.DRIBBLE_TURN_DIP_THRESHOLD_DEG)\n\tlocal a = math.abs(angleRad)\n\tif a ~= a or a <= thresh then\n\t\treturn 1.0\n\tend\n\tlocal minF = if isSprinting then DribbleConfigs.DRIBBLE_TURN_MIN_FACTOR_SPRINT else DribbleConfigs.DRIBBLE_TURN_MIN_FACTOR_WALK\n\tlocal norm = math.clamp((a - thresh) / (math.pi - thresh), 0, 1)\n\treturn 1.0 - (1.0 - minF) * (norm ^ DribbleConfigs.DRIBBLE_TURN_EXPONENT)\nend\n\n-- Forward micro-touch radial pulse: purely forward along travel direction, zero lateral sway, 0 at rest.\nfunction DribbleGeometryHelper.ComputeMicroTouchOffset(speed: number, isSprinting: boolean, timeSec: number): number\n\tif not DribbleConfigs.MICRO_TOUCH_ENABLED or speed <= DribbleConfigs.MIN_PLAYER_MOVE_SPEED then\n\t\treturn 0.0\n\tend\n\tlocal amp = if isSprinting then DribbleConfigs.MICRO_TOUCH_AMPLITUDE_SPRINT else DribbleConfigs.MICRO_TOUCH_AMPLITUDE_WALK\n\tlocal cad = if isSprinting then DribbleConfigs.MICRO_TOUCH_CADENCE_SPRINT else DribbleConfigs.MICRO_TOUCH_CADENCE_WALK\n\tlocal phase = (timeSec * cad * 2 * math.pi) % (2 * math.pi)\n\t-- Forward-only positive pulse in [0, 1]\n\tlocal pulse = 0.5 * (1 - math.cos(phase))\n\treturn amp * pulse\nend\n\n-- Desired controlled ball position: along leadDir (MoveDirection when moving, body front when idle);\n-- slides to nearest feasible flank when the target is outside the cage; returns (target, flankAngleDeg, infeasible).\nfunction DribbleGeometryHelper.FeasibleFrontTarget(\n\trootPos: Vector3,\n\tleadDir: Vector3,\n\tisSprinting: boolean,\n\tradialOffset: number?,\n\tminSeparation: number?\n): (Vector3, number, boolean)\n\tlocal f = safeUnit(horiz(leadDir), Vector3.new(0, 0, -1))\n\tlocal baseD = if isSprinting then DribbleConfigs.FRONT_DISTANCE_SPRINT else DribbleConfigs.FRONT_DISTANCE_WALK\n\tlocal sep = minSeparation or DribbleGeometryHelper.GetCarrierSeparationDistance()\n\tlocal d = math.max(baseD + (radialOffset or 0), sep)\n\tlocal base = math.atan2(f.Z, f.X)\n\tlocal steps = DribbleConfigs.FLANK_ANGLE_STEPS\n\tlocal stepRad = 2 * math.pi / steps\n\tfor _, radius in ipairs({ d, sep }) do\n\t\tfor k = 0, steps // 2 do\n\t\t\tfor _, sgn in ipairs({ 1, -1 }) do\n\t\t\t\tif k == 0 and sgn == -1 then\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tlocal ang = base + sgn * k * stepRad\n\t\t\t\tlocal x = rootPos.X + math.cos(ang) * radius\n\t\t\t\tlocal z = rootPos.Z + math.sin(ang) * radius\n\t\t\t\tif insideCage(x, z) then\n\t\t\t\t\treturn Vector3.new(x, rootPos.Y, z), math.deg(k * stepRad), false\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tlocal mx, mz = cageLimits()\n\tlocal clamped = Vector3.new(math.clamp(rootPos.X + f.X * d, -mx, mx), rootPos.Y, math.clamp(rootPos.Z + f.Z * d, -mz, mz))\n\treturn clamped, 180, true\nend\n\nlocal function wrapAngle(a: number): number\n\treturn (a + math.pi) % (2 * math.pi) - math.pi\nend\n\n-- Polar front tracking: the ball ORBITS the carrier (bounded angular speed, bounded radial speed, radius never below the\n-- clearance ring) toward the target, carried with the carrier velocity so it genuinely travels. Because the relative\n-- motion is an arc around the body, the ball never crosses the torso while swinging between back/side/front.\n-- Returns the absolute ball velocity for this step (displacement = velocity * dt before friction/cage).\nfunction DribbleGeometryHelper.ComputeFrontVelocity(\n\trootPos: Vector3,\n\tcarrierVel: Vector3,\n\tballPos: Vector3,\n\ttarget: Vector3,\n\tdt: number,\n\tminSeparation: number?\n): Vector3\n\tlocal sep = minSeparation or DribbleGeometryHelper.GetCarrierSeparationDistance()\n\tlocal rel = horiz(ballPos - rootPos)\n\tlocal tRel = horiz(target - rootPos)\n\tlocal rt = math.max(tRel.Magnitude, sep)\n\tlocal thetaT = if tRel.Magnitude > EPS then math.atan2(tRel.Z, tRel.X) else 0\n\tlocal r = rel.Magnitude\n\tlocal thetaB = if r > 0.05 then math.atan2(rel.Z, rel.X) else thetaT\n\tif r <= 0.05 then\n\t\tr = sep\n\t\trel = Vector3.new(math.cos(thetaB) * r, 0, math.sin(thetaB) * r)\n\tend\n\tlocal step = math.clamp(dt, 0.001, 0.1)\n\n\tlocal dTheta = wrapAngle(thetaT - thetaB)\n\tlocal maxAng = DribbleConfigs.FRONT_MAX_ANGULAR_SPEED * step\n\tlocal stepTheta = math.clamp(dTheta * DribbleConfigs.FRONT_ANGULAR_GAIN * step, -maxAng, maxAng)\n\tif math.abs(stepTheta) > math.abs(dTheta) then\n\t\tstepTheta = dTheta\n\tend\n\n\tlocal dR = rt - r\n\tlocal maxRad = DribbleConfigs.FRONT_RADIAL_MAX_SPEED * step\n\tlocal stepR = math.clamp(dR * DribbleConfigs.FRONT_RADIAL_GAIN * step, -maxRad, maxRad)\n\tif math.abs(stepR) > math.abs(dR) then\n\t\tstepR = dR\n\tend\n\n\tlocal newR = math.max(r + stepR, sep)\n\tlocal newTheta = thetaB + stepTheta\n\tlocal relNew = Vector3.new(math.cos(newTheta) * newR, 0, math.sin(newTheta) * newR)\n\tlocal relVel = clampMag((relNew - rel) / step, DribbleConfigs.FRONT_MAX_REL_SPEED)\n\treturn clampMag(horiz(carrierVel) + relVel, DribbleConfigs.MAX_BALL_DRIBBLE_SPEED)\nend\n\n-- Compute initial 3D velocity for Jump Self-Lob (Scoop).\n-- Moving uses verified horizontal momentum; stationary uses horizontal launchDir (from camera look).\nfunction DribbleGeometryHelper.ComputeSelfLobVelocity(\n\tlaunchDir: Vector3,\n\tcarrierHorizVel: Vector3,\n\tisMoving: boolean\n): Vector3\n\tlocal f = safeUnit(horiz(launchDir), Vector3.new(0, 0, -1))\n\tlocal vH: number\n\tif isMoving then\n\t\tlocal curSpeed = horiz(carrierHorizVel).Magnitude\n\t\tvH = math.clamp(\n\t\t\tcurSpeed * DribbleConfigs.SELF_LOB_MOMENTUM_FACTOR,\n\t\t\tDribbleConfigs.SELF_LOB_MIN_HORIZONTAL_SPEED,\n\t\t\tDribbleConfigs.SELF_LOB_MAX_HORIZONTAL_SPEED\n\t\t)\n\telse\n\t\tvH = DribbleConfigs.SELF_LOB_MIN_HORIZONTAL_SPEED\n\tend\n\treturn Vector3.new(f.X * vH, DribbleConfigs.SELF_LOB_UPWARD_SPEED, f.Z * vH)\nend\n\nlocal function reflectInward(n: Vector3, vRel: Vector3): Vector3\n\tlocal vn = vRel.X * n.X + vRel.Z * n.Z\n\tif vn < 0 then\n\t\treturn vRel - n * ((1 + DribbleConfigs.BODY_CONTACT_RESTITUTION) * vn)\n\tend\n\treturn vRel\nend\n\n-- Joint swept body + cage resolution for one step. Returns (pos, vel, adjusted, infeasible).\n-- 1) vertical-disjoint balls untouched; 2) exact first time-of-impact vs body circle; 3) cage feasibility with\n-- feasible-flank ring search (never pushes through walls, never teleports beyond one ring correction).\nfunction DribbleGeometryHelper.ResolveBodyCage(\n\tp0: Vector3,\n\tp1: Vector3,\n\tb0: Vector3,\n\tb1: Vector3,\n\tvb: Vector3,\n\tvp: Vector3,\n\tdt: number,\n\tfacing: Vector3,\n\tminSeparation: number?\n): (Vector3, Vector3, boolean, boolean)\n\tlocal dT = minSeparation or DribbleGeometryHelper.GetCarrierSeparationDistance()\n\tlocal ballR = DribbleConfigs.BALL_COLLISION_RADIUS\n\tlocal feet = DribbleGeometryHelper.GetFeetY(p1.Y)\n\tif math.max(feet, b1.Y - ballR) > math.min(feet + DribbleConfigs.BODY_HEIGHT, b1.Y + ballR) then\n\t\treturn b1, vb, false, false\n\tend\n\n\tlocal fU = safeUnit(horiz(facing), Vector3.new(0, 0, -1))\n\tlocal s0 = Vector3.new(b0.X - p0.X, 0, b0.Z - p0.Z)\n\tlocal s1 = Vector3.new(b1.X - p1.X, 0, b1.Z - p1.Z)\n\tlocal ds = s1 - s0\n\tlocal a = ds.X * ds.X + ds.Z * ds.Z\n\tlocal b = 2 * (s0.X * ds.X + s0.Z * ds.Z)\n\tlocal c = (s0.X * s0.X + s0.Z * s0.Z) - dT * dT\n\n\tlocal adjusted = false\n\tlocal s1c = s1\n\tlocal vbc = vb\n\tlocal vpH = horiz(vp)\n\n\tif c <= 0 then\n\t\tadjusted = true\n\t\tlocal d0 = s0.Magnitude\n\t\tlocal n = safeUnit(s0, fU)\n\t\tlocal sC = n * (d0 + math.min(dT - d0, DribbleConfigs.MAX_OVERLAP_SEPARATION_STEP))\n\t\tlocal vr = reflectInward(n, Vector3.new(vb.X - vp.X, 0, vb.Z - vp.Z))\n\t\tlocal o = vr.X * n.X + vr.Z * n.Z\n\t\tif o < DribbleConfigs.OVERLAP_RECOVERY_PUSH_SPEED then\n\t\t\tvr = vr + n * (DribbleConfigs.OVERLAP_RECOVERY_PUSH_SPEED - math.max(0, o))\n\t\tend\n\t\ts1c = sC + vr * dt\n\t\tlocal l = s1c.Magnitude\n\t\tif l < dT then\n\t\t\ts1c = if l > EPS then s1c * (dT / l) else n * dT\n\t\tend\n\t\tvbc = Vector3.new(vpH.X + vr.X, vb.Y, vpH.Z + vr.Z)\n\telseif b < 0 and a > 1e-8 then\n\t\tlocal disc = b * b - 4 * a * c\n\t\tif disc >= 0 then\n\t\t\tlocal t = (-b - math.sqrt(disc)) / (2 * a)\n\t\t\tif t >= 0 and t <= 1 then\n\t\t\t\tadjusted = true\n\t\t\t\tlocal sC = s0 + ds * t\n\t\t\t\tlocal n = safeUnit(sC, fU)\n\t\t\t\tlocal vr = reflectInward(n, if dt > EPS then ds / dt else Vector3.zero)\n\t\t\t\ts1c = sC + vr * ((1 - t) * dt)\n\t\t\t\tlocal l = s1c.Magnitude\n\t\t\t\tif l < dT then\n\t\t\t\t\ts1c = if l > EPS then s1c * (dT / l) else n * dT\n\t\t\t\tend\n\t\t\t\tvbc = Vector3.new(vpH.X + vr.X, vb.Y, vpH.Z + vr.Z)\n\t\t\tend\n\t\tend\n\tend\n\n\tlocal cx, cz = p1.X + s1c.X, p1.Z + s1c.Z\n\tlocal infeasible = false\n\tif not insideCage(cx, cz) then\n\t\tadjusted = true\n\t\tlocal mx, mz = cageLimits()\n\t\tlocal clx, clz = math.clamp(cx, -mx, mx), math.clamp(cz, -mz, mz)\n\t\tlocal vx, vz = vbc.X, vbc.Z\n\t\tif clx ~= cx and ((clx > 0 and vx > 0) or (clx < 0 and vx < 0)) then\n\t\t\tvx = 0\n\t\tend\n\t\tif clz ~= cz and ((clz > 0 and vz > 0) or (clz < 0 and vz < 0)) then\n\t\t\tvz = 0\n\t\tend\n\t\tvbc = Vector3.new(vx, vbc.Y, vz)\n\t\tlocal dx, dz = clx - p1.X, clz - p1.Z\n\t\tif math.sqrt(dx * dx + dz * dz) >= dT - 1e-6 then\n\t\t\tcx, cz = clx, clz\n\t\telse\n\t\t\t-- Body and wall conflict: choose the feasible ring point nearest to the clamped ball\n\t\t\tlocal best, bestD = nil, math.huge\n\t\t\tlocal steps = DribbleConfigs.FLANK_ANGLE_STEPS\n\t\t\tfor i = 0, steps - 1 do\n\t\t\t\tlocal ang = i * 2 * math.pi / steps\n\t\t\t\tlocal qx, qz = p1.X + math.cos(ang) * dT, p1.Z + math.sin(ang) * dT\n\t\t\t\tif insideCage(qx, qz) then\n\t\t\t\t\tlocal dd = (qx - clx) ^ 2 + (qz - clz) ^ 2\n\t\t\t\t\tif dd < bestD then\n\t\t\t\t\t\tbestD = dd\n\t\t\t\t\t\tbest = Vector3.new(qx, 0, qz)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif best then\n\t\t\t\tcx, cz = best.X, best.Z\n\t\t\t\tlocal n = safeUnit(Vector3.new(cx - p1.X, 0, cz - p1.Z), fU)\n\t\t\t\tlocal vr = reflectInward(n, Vector3.new(vbc.X - vp.X, 0, vbc.Z - vp.Z))\n\t\t\t\tvbc = Vector3.new(vpH.X + vr.X, vbc.Y, vpH.Z + vr.Z)\n\t\t\telse\n\t\t\t\tcx, cz = clx, clz\n\t\t\t\tinfeasible = true\n\t\t\tend\n\t\tend\n\tend\n\n\treturn Vector3.new(cx, b1.Y, cz), vbc, adjusted, infeasible\nend\n\nreturn DribbleGeometryHelper\n"},{"disk":"src/client/character/SprintCutReferenceData.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","SprintCutReferenceData"],"className":"ModuleScript","content":"-- Retired by Owner: retained as comments, no runtime implementation.\n--[====[\n--!strict\n-- Full 61-frame / 2-second Owner reference from sprint-cut.md.\n-- Root travel is retained as source data; the cut adapter stays in-place.\nlocal PARTS = { \"LowerTorso\", \"UpperTorso\", \"Head\", \"LeftUpperArm\", \"LeftLowerArm\", \"LeftHand\", \"RightUpperArm\", \"RightLowerArm\", \"RightHand\", \"LeftUpperLeg\", \"LeftLowerLeg\", \"LeftFoot\", \"RightUpperLeg\", \"RightLowerLeg\", \"RightFoot\" }\nlocal DATA = [[\n0 0 -0.2555 0 -0.1306 0 0.1227 -0.5562 0.0235 -0.2412 0.4751 0.4716 0.1406 -0.3556 -0.2452 -0.3324 1.2478 -0.5712 0.1299 0.1626 0.1405 0.0362 0.1528 0.5556 0.2775 1.6344 0.4011 0.2734 0.2195 -0.3459 -0.2684 0.3933 -0.0123 -0.2064 -1.7961 -0.1479 0.1382 0.5721 0.6126 -0.2947 0.4527 0.1373 -0.0029 -1.3021 0.0533 -0.2315 0.9503 -0.3008 0.1808\n0.0333 -0.0297 -0.238 -0.316 -0.1247 -0.0497 0.0983 -0.538 0.1 -0.1539 0.4817 0.4252 0.1231 -0.5301 -0.1201 -0.4426 1.2914 -0.5971 0.2907 0.1963 0.1207 0.0861 0.2819 0.6172 0.2582 1.7474 0.4203 0.2953 0.2547 -0.3516 -0.2806 0.6363 -0.0471 -0.2349 -1.7796 -0.1249 0.2254 0.6097 0.5713 -0.2981 0.2863 0.0978 0.0374 -1.189 0.094 -0.1692 0.8818 -0.291 0.13\n0.0667 -0.0531 -0.2047 -0.6473 -0.1162 -0.0995 0.0711 -0.5136 0.201 -0.0404 0.478 0.3378 0.0955 -0.7096 0.0521 -0.5415 1.3839 -0.6212 0.4773 0.2401 0.0986 0.1197 0.3836 0.6652 0.2592 1.8574 0.4328 