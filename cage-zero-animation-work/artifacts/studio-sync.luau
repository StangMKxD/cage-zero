(k[4]))\nend\n\nlocal function sampleTrack(keys: { { number } }?, timeSec: number): CFrame\n\tif not keys or #keys == 0 then\n\t\treturn CFrame.identity\n\tend\n\tif timeSec <= keys[1][1] then\n\t\treturn keyTransform(keys[1])\n\tend\n\tfor i = 2, #keys do\n\t\tlocal right = keys[i]\n\t\tlocal left = keys[i - 1]\n\t\tif timeSec <= right[1] then\n\t\t\tlocal span = right[1] - left[1]\n\t\t\tlocal alpha = if span > 1e-6 then cubicInOut((timeSec - left[1]) / span) else 1\n\t\t\treturn keyTransform(left):Lerp(keyTransform(right), alpha)\n\t\tend\n\tend\n\treturn keyTransform(keys[#keys])\nend\n\nlocal DribbleClipData = {\n\tRecipes = Recipes,\n}\n\nfunction DribbleClipData.BuildKeyframeSequence(clipName: string): KeyframeSequence?\n\tlocal recipe = Recipes[clipName]\n\tif not recipe then\n\t\treturn nil\n\tend\n\n\tlocal timeSet: { [number]: boolean } = {}\n\tfor _, keys in pairs(recipe.tracks) do\n\t\tfor _, k in ipairs(keys) do\n\t\t\ttimeSet[math.round(k[1] * 10000) / 10000] = true\n\t\tend\n\tend\n\tfor _, m in ipairs(recipe.markers) do\n\t\ttimeSet[math.round(m.t * 10000) / 10000] = true\n\tend\n\n\tlocal baseTimes: { number } = {}\n\tfor t in pairs(timeSet) do\n\t\ttable.insert(baseTimes, t)\n\tend\n\ttable.sort(baseTimes)\n\n\tlocal sorted: { number } = { baseTimes[1] }\n\n\tlocal function needsBaking(startTime: number, endTime: number): boolean\n\t\tlocal middleTime = (startTime + endTime) / 2\n\t\tfor _, keys in pairs(recipe.tracks) do\n\t\t\tlocal first = sampleTrack(keys, startTime)\n\t\t\tlocal last = sampleTrack(keys, endTime)\n\t\t\tlocal actual = sampleTrack(keys, middleTime)\n\t\t\tlocal errorFrame = first:Lerp(last, 0.5):ToObjectSpace(actual)\n\t\t\tlocal _, angle = errorFrame:ToAxisAngle()\n\t\t\tif errorFrame.Position.Magnitude > 0.005 or angle > math.rad(0.25) then\n\t\t\t\treturn true\n\t\t\tend\n\t\tend\n\t\treturn false\n\tend\n\n\tlocal function appendInterval(startTime: number, endTime: number, depth: number)\n\t\tif depth < 8 and needsBaking(startTime, endTime) then\n\t\t\tlocal middleTime = (startTime + endTime) / 2\n\t\t\tappendInterval(startTime, middleTime, depth + 1)\n\t\t\tappendInterval(middleTime, endTime, depth + 1)\n\t\t\treturn\n\t\tend\n\t\ttable.insert(sorted, endTime)\n\tend\n\n\tfor i = 1, #baseTimes - 1 do\n\t\tappendInterval(baseTimes[i], baseTimes[i + 1], 0)\n\tend\n\n\tlocal sequence = Instance.new(\"KeyframeSequence\")\n\tsequence.Name = recipe.name\n\tsequence.Loop = recipe.loop\n\tsequence.Priority = recipe.priority\n\n\tlocal function buildPose(node: any, timeSec: number): Pose\n\t\tlocal pose = Instance.new(\"Pose\")\n\t\tpose.Name = node.name\n\t\tlocal keys = recipe.tracks[node.name]\n\t\tpose.Weight = if keys then 1 else 0\n\t\tpose.EasingStyle = Enum.PoseEasingStyle.Linear\n\t\tpose.EasingDirection = Enum.PoseEasingDirection.Out\n\t\tpose.CFrame = sampleTrack(keys, timeSec)\n\t\tfor _, child in ipairs(node.children) do\n\t\t\tpose:AddSubPose(buildPose(child, timeSec))\n\t\tend\n\t\treturn pose\n\tend\n\n\tfor _, timeSec in ipairs(sorted) do\n\t\tlocal frame = Instance.new(\"Keyframe\")\n\t\tframe.Time = timeSec\n\t\tframe:AddPose(buildPose(R15_TREE, timeSec))\n\t\tfor _, m in ipairs(recipe.markers) do\n\t\t\tif math.abs(m.t - timeSec) < 1e-4 then\n\t\t\t\tlocal marker = Instance.new(\"KeyframeMarker\")\n\t\t\t\tmarker.Name = m.name\n\t\t\t\tmarker.Value = m.value\n\t\t\t\tframe:AddMarker(marker)\n\t\t\tend\n\t\tend\n\t\tsequence:AddKeyframe(frame)\n\tend\n\n\treturn sequence\nend\n\nreturn table.freeze(DribbleClipData)\n"},{"disk":"src/client/character/DribbleAnimationHelper.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","DribbleAnimationHelper"],"className":"ModuleScript","content":"--!strict\n-- src/client/character/DribbleAnimationHelper.luau\n-- KeyframeSequence validator, Studio fallback registrar, and marker intent helper for R15 Dribble/Cut/G clips.\n-- Governed by RF02-DRIBBLE-ANIMATION-INTEGRATION Contract (2026-10-27).\n\nlocal KeyframeSequenceProvider = game:GetService(\"KeyframeSequenceProvider\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\", 10) :: Folder?\nassert(Shared ~= nil, \"[DribbleAnimationHelper] Shared folder missing in ReplicatedStorage\")\nlocal configs = Shared:WaitForChild(\"configs\", 10) :: Folder?\nassert(configs ~= nil, \"[DribbleAnimationHelper] configs folder missing in Shared\")\nlocal DribbleActionConfigs = require(configs:WaitForChild(\"DribbleActionConfigs\"))\nlocal DribbleClipData = require(script.Parent:WaitForChild(\"DribbleClipData\"))\n\nexport type DribbleLoopKey = \"WalkDribble\" | \"RunDribble\" | \"GModeLoop\"\nexport type DribbleCutKey = \"FrontLeft\" | \"FrontRight\" | \"BackLeft\" | \"BackRight\" | \"ReverseLeft\" | \"ReverseRight\" | \"GoalReverse\"\nexport type DribbleClipKey = DribbleLoopKey | DribbleCutKey\n\nexport type LoopTrackCache = {\n\tWalkDribble: AnimationTrack?,\n\tRunDribble: AnimationTrack?,\n\tGModeLoop: AnimationTrack?,\n}\n\nexport type LoopRegistrationSources = {\n\tWalkDribble: string,\n\tRunDribble: string,\n\tGModeLoop: string,\n}\n\nlocal cachedStudioTempIds: { [string]: string } = {}\nlocal warnedProductionMissing: { [string]: boolean } = {}\nlocal lastTouchSentTime: number = 0\nlocal ballActionRemoteRef: RemoteEvent? = nil\n\nlocal DribbleAnimationHelper = {}\n\nlocal function getBallActionRemote(): RemoteEvent?\n\tif ballActionRemoteRef and ballActionRemoteRef.Parent then\n\t\treturn ballActionRemoteRef\n\tend\n\tlocal remotesFolder = ReplicatedStorage:FindFirstChild(\"CageZeroRemotes\")\n\tif remotesFolder then\n\t\tlocal r = remotesFolder:FindFirstChild(\"BallActionRequest\")\n\t\tif r and r:IsA(\"RemoteEvent\") then\n\t\t\tballActionRemoteRef = r\n\t\tend\n\tend\n\treturn ballActionRemoteRef\nend\n\nfunction DribbleAnimationHelper.ValidateClip(clip: Instance, spec: DribbleActionConfigs.DribbleClipSpec): (boolean, string?)\n\tif not clip:IsA(\"KeyframeSequence\") then\n\t\treturn false, \"Clip is not a KeyframeSequence\"\n\tend\n\tif clip.Name ~= spec.ClipName then\n\t\treturn false, \"Clip name mismatch: expected \" .. spec.ClipName .. \", got \" .. clip.Name\n\tend\n\tif clip.Loop ~= spec.ExpectedLoop then\n\t\treturn false, \"Clip Loop mismatch: expected \" .. tostring(spec.ExpectedLoop) .. \", got \" .. tostring(clip.Loop)\n\tend\n\tif clip.Priority ~= spec.ExpectedPriority then\n\t\treturn false, \"Clip Priority mismatch: expected \" .. spec.ExpectedPriority.Name .. \", got \" .. clip.Priority.Name\n\tend\n\n\tlocal keyframes = clip:GetKeyframes()\n\tif #keyframes ~= spec.ExpectedKeyframeCount then\n\t\treturn false, string.format(\"Keyframe count mismatch: expected %d, got %d\", spec.ExpectedKeyframeCount, #keyframes)\n\tend\n\n\tlocal minTime = math.huge\n\tlocal maxTime = -math.huge\n\tlocal markerCount = 0\n\tlocal hasTouchMarker = false\n\tfor _, kf in ipairs(keyframes) do\n\t\tif kf.Time < minTime then\n\t\t\tminTime = kf.Time\n\t\tend\n\t\tif kf.Time > maxTime then\n\t\t\tmaxTime = kf.Time\n\t\tend\n\t\tif kf:IsA(\"Keyframe\") then\n\t\t\tlocal markers = kf:GetMarkers()\n\t\t\tmarkerCount += #markers\n\t\t\tfor _, m in ipairs(markers) do\n\t\t\t\tif m.Name == \"TouchL\" or m.Name == \"TouchR\" then\n\t\t\t\t\thasTouchMarker = true\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tlocal duration = maxTime - minTime\n\tif math.abs(duration - spec.ExpectedDuration) > spec.DurationTolerance then\n\t\treturn false, string.format(\"Duration mismatch: expected %.2f, got %.2f\", spec.ExpectedDuration, duration)\n\tend\n\n\tlocal firstKf = keyframes[1]\n\tlocal drivenJoints = 0\n\tfor _, desc in ipairs(firstKf:GetDescendants()) do\n\t\tif desc:IsA(\"Pose\") and desc.Name ~= \"HumanoidRootPart\" then\n\t\t\tdrivenJoints += 1\n\t\tend\n\tend\n\tif drivenJoints ~= spec.ExpectedDrivenJoints then\n\t\treturn false, string.format(\"Driven joints mismatch: expected %d, got %d\", spec.ExpectedDrivenJoints, drivenJoints)\n\tend\n\n\tif markerCount < 1 or not hasTouchMarker then\n\t\treturn false, \"Missing required TouchL/TouchR KeyframeMarkers\"\n\tend\n\n\treturn true, nil\nend\n\nfunction DribbleAnimationHelper.ResolveAnimation(key: string): (Animation?, string)\n\tlocal specs = DribbleActionConfigs.Clips :: { [string]: DribbleActionConfigs.DribbleClipSpec }\n\tlocal spec = specs[key]\n\tif not spec then\n\t\treturn nil, \"UNKNOWN_KEY\"\n\tend\n\n\tlocal publishedMap = DribbleActionConfigs.PublishedIds :: { [string]: string? }\n\tlocal approvedCutMap = DribbleActionConfigs.ApprovedCutAnimations :: { [string]: string? }\n\tlocal publishedId = publishedMap[key]\n\tlocal cutBinding = approvedCutMap[key]\n\tif not publishedId and cutBinding and string.match(cutBinding, \"^rbxassetid://%d+$\") then\n\t\tpublishedId = cutBinding\n\tend\n\n\tif publishedId and string.match(publishedId, \"^rbxassetid://%d+$\") then\n\t\tlocal anim = Instance.new(\"Animation\")\n\t\tanim.Name = \"R15_Dribble_\" .. key .. \"_Published\"\n\t\tanim.AnimationId = publishedId\n\t\treturn anim, \"PUBLISHED\"\n\tend\n\n\tif not DribbleActionConfigs.IsStudioFallbackAllowed() then\n\t\tif not warnedProductionMissing[key] then\n\t\t\twarn(\"[DribbleAnimationHelper] Published AnimationId for \" .. key .. \" is missing in production.\")\n\t\t\twarnedProductionMissing[key] = true\n\t\tend\n\t\treturn nil, \"PRODUCTION_MISSING\"\n\tend\n\n\tlocal clipName = spec.ClipName\n\tif cachedStudioTempIds[clipName] then\n\t\tlocal anim = Instance.new(\"Animation\")\n\t\tanim.Name = \"R15_Dribble_\" .. key .. \"_StudioFallback\"\n\t\tanim.AnimationId = cachedStudioTempIds[clipName]\n\t\treturn anim, \"STUDIO_FALLBACK\"\n\tend\n\n\tlocal previewRigs = workspace:FindFirstChild(\"PreviewRigs\")\n\tlocal previewRig = previewRigs and previewRigs:FindFirstChild(\"PreviewRig_R15_Boy_Height30\")\n\tlocal animSaves = previewRig and previewRig:FindFirstChild(\"AnimSaves\")\n\tlocal clip: Instance? = animSaves and animSaves:FindFirstChild(clipName)\n\tlocal sourceTag = \"STUDIO_FALLBACK\"\n\tlocal builtTemporary = false\n\n\tif not clip then\n\t\tclip = DribbleClipData.BuildKeyframeSequence(clipName)\n\t\tsourceTag = \"STUDIO_IMMUTABLE_DATA\"\n\t\tbuiltTemporary = true\n\tend\n\n\tif not clip then\n\t\twarn(\"[DribbleAnimationHelper] Clip not found for \" .. key .. \" (\" .. clipName .. \")\")\n\t\treturn nil, \"CLIP_NOT_FOUND\"\n\tend\n\n\tlocal isValid, err = DribbleAnimationHelper.ValidateClip(clip, spec)\n\tif not isValid then\n\t\tif builtTemporary then\n\t\t\tclip:Destroy()\n\t\tend\n\t\twarn(\"[DribbleAnimationHelper] Clip validation failed for \" .. key .. \": \" .. tostring(err))\n\t\treturn nil, \"CLIP_VALIDATION_FAILED\"\n\tend\n\n\tlocal ok, tempId = pcall(function()\n\t\treturn KeyframeSequenceProvider:RegisterKeyframeSequence(clip :: KeyframeSequence)\n\tend)\n\tif builtTemporary then\n\t\tclip:Destroy()\n\tend\n\n\tif not ok or not tempId or typeof(tempId) ~= \"string\" or #tempId == 0 then\n\t\twarn(\"[DribbleAnimationHelper] Failed to register KeyframeSequence for \" .. key)\n\t\treturn nil, \"REGISTRATION_FAILED\"\n\tend\n\n\tcachedStudioTempIds[clipName] = tempId\n\tlocal anim = Instance.new(\"Animation\")\n\tanim.Name = \"R15_Dribble_\" .. key .. \"_\" .. sourceTag\n\tanim.AnimationId = tempId\n\treturn anim, sourceTag\nend\n\nfunction DribbleAnimationHelper.WarmupCutTracks(animator: Animator)\n\tlocal cutKeys: { DribbleCutKey } = {\n\t\t\"FrontLeft\",\n\t\t\"FrontRight\",\n\t\t\"BackLeft\",\n\t\t\"BackRight\",\n\t\t\"ReverseLeft\",\n\t\t\"ReverseRight\",\n\t\t\"GoalReverse\",\n\t}\n\tlocal warmupTracks: { AnimationTrack } = {}\n\tlocal warmupAnims: { Animation } = {}\n\n\tfor _, key in ipairs(cutKeys) do\n\t\tlocal binding = (DribbleActionConfigs.ApprovedCutAnimations :: { [string]: string? })[key]\n\t\tif binding and #binding > 0 then\n\t\t\tlocal anim = DribbleAnimationHelper.ResolveAnimation(key)\n\t\t\tif anim then\n\t\t\t\ttable.insert(warmupAnims, anim)\n\t\t\t\tlocal ok, tr = pcall(function()\n\t\t\t\t\treturn animator:LoadAnimation(anim)\n\t\t\t\tend)\n\t\t\t\tif ok and tr then\n\t\t\t\t\ttable.insert(warmupTracks, tr)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tlocal deadline = os.clock() + 0.25\n\twhile os.clock() < deadline do\n\t\tlocal allReady = true\n\t\tfor _, tr in ipairs(warmupTracks) do\n\t\t\tif tr.Length <= 0 then\n\t\t\t\tallReady = false\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif allReady then\n\t\t\tbreak\n\t\tend\n\t\ttask.wait(0.02)\n\tend\n\n\tfor _, tr in ipairs(warmupTracks) do\n\t\tpcall(function()\n\t\t\ttr:Stop(0)\n\t\t\ttr:Destroy()\n\t\tend)\n\tend\n\tfor _, anim in ipairs(warmupAnims) do\n\t\tpcall(function()\n\t\t\tanim:Destroy()\n\t\tend)\n\tend\nend\n\nfunction DribbleAnimationHelper.LoadLoopTracks(animator: Animator): (LoopTrackCache, LoopRegistrationSources, { Animation })\n\tlocal tracks: LoopTrackCache = {\n\t\tWalkDribble = nil,\n\t\tRunDribble = nil,\n\t\tGModeLoop = nil,\n\t}\n\tlocal sources: LoopRegistrationSources = {\n\t\tWalkDribble = \"NONE\",\n\t\tRunDribble = \"NONE\",\n\t\tGModeLoop = \"NONE\",\n\t}\n\tlocal animInstances: { Animation } = {}\n\n\tlocal keys: { DribbleLoopKey } = { \"WalkDribble\", \"RunDribble\", \"GModeLoop\" }\n\tfor _, key in ipairs(keys) do\n\t\tlocal anim, src = DribbleAnimationHelper.ResolveAnimation(key)\n\t\tsources[key] = src\n\t\tif anim then\n\t\t\ttable.insert(animInstances, anim)\n\t\t\tlocal spec = (DribbleActionConfigs.Clips :: { [string]: DribbleActionConfigs.DribbleClipSpec })[key]\n\t\t\tlocal ok, track = pcall(function()\n\t\t\t\treturn animator:LoadAnimation(anim)\n\t\t\tend)\n\t\t\tif ok and track then\n\t\t\t\ttrack.Priority = spec.ExpectedPriority\n\t\t\t\ttrack.Looped = spec.ExpectedLoop\n\t\t\t\ttracks[key] = track\n\t\t\telse\n\t\t\t\tsources[key] = \"LOAD_FAILED\"\n\t\t\tend\n\t\tend\n\tend\n\n\treturn tracks, sources, animInstances\nend\n\nfunction DribbleAnimationHelper.LoadCutTrack(animator: Animator, name: string): (AnimationTrack?, string?)\n\tlocal approved = (DribbleActionConfigs.ApprovedCutAnimations :: { [string]: string? })[name]\n\tif not approved or #approved == 0 then\n\t\treturn nil, nil\n\tend\n\n\tlocal spec = (DribbleActionConfigs.Clips :: { [string]: DribbleActionConfigs.DribbleClipSpec })[name]\n\tif not spec then\n\t\treturn nil, nil\n\tend\n\n\tlocal anim: Animation? = nil\n\tif string.match(approved, \"^rbxassetid://%d+$\") then\n\t\tanim = Instance.new(\"Animation\")\n\t\tanim.Name = \"R15_Cut_\" .. name\n\t\tanim.AnimationId = approved\n\telseif approved == spec.ClipName then\n\t\tanim = DribbleAnimationHelper.ResolveAnimation(name)\n\telse\n\t\treturn nil, nil\n\tend\n\n\tif not anim then\n\t\treturn nil, nil\n\tend\n\n\tlocal ok, loaded = pcall(function()\n\t\treturn animator:LoadAnimation(anim)\n\tend)\n\tanim:Destroy()\n\tif not ok or not loaded then\n\t\treturn nil, nil\n\tend\n\n\treturn loaded :: AnimationTrack, spec.ClipName\nend\n\nfunction DribbleAnimationHelper.CleanupLoopTracks(tracks: LoopTrackCache, animInstances: { Animation })\n\tfor _, track in pairs(tracks) do\n\t\tif track then\n\t\t\tpcall(function()\n\t\t\t\ttrack:Stop(0)\n\t\t\t\ttrack:Destroy()\n\t\t\tend)\n\t\tend\n\tend\n\tfor _, anim in ipairs(animInstances) do\n\t\tpcall(function()\n\t\t\tanim:Destroy()\n\t\tend)\n\tend\n\ttable.clear(animInstances)\nend\n\nfunction DribbleAnimationHelper.NotifyTouchMarker(character: Model, foot: string, clipName: string, isCut: boolean)\n\tif not character or not character.Parent or character:GetAttribute(\"IsBallCarrier\") ~= true then\n\t\treturn\n\tend\n\tif foot ~= \"L\" and foot ~= \"R\" then\n\t\treturn\n\tend\n\tlocal now = os.clock()\n\tlocal prevCount = character:GetAttribute(\"DribbleTouchCount\")\n\tlocal nextCount = (if typeof(prevCount) == \"number\" then prevCount else 0) + 1\n\tcharacter:SetAttribute(\"LastDribbleTouchFoot\", foot)\n\tcharacter:SetAttribute(\"LastDribbleTouchTime\", now)\n\tcharacter:SetAttribute(\"LastDribbleTouchClip\", clipName)\n\tcharacter:SetAttribute(\"DribbleTouchCount\", nextCount)\n\n\tif now - lastTouchSentTime < DribbleActionConfigs.TOUCH_INTENT_COOLDOWN_SEC then\n\t\treturn\n\tend\n\tlastTouchSentTime = now\n\n\tlocal remote = getBallActionRemote()\n\tif remote then\n\t\tpcall(function()\n\t\t\tremote:FireServer({\n\t\t\t\taction = \"DribbleTouch\",\n\t\t\t\tfoot = foot,\n\t\t\t\tclip = clipName,\n\t\t\t\tisCut = isCut,\n\t\t\t\tcharacter = character,\n\t\t\t})\n\t\tend)\n\tend\nend\n\nreturn table.freeze(DribbleAnimationHelper)\n"},{"disk":"src/client/character/DribbleAnimationController.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","character","DribbleAnimationController"],"className":"ModuleScript","content":"--!strict\n-- src/client/character/DribbleAnimationController.luau\n-- Additive Carrier Dribble & G-Mode Close-Control Animation Controller for R15 Characters\n-- Governed by RF02-DRIBBLE-ANIMATION-INTEGRATION Contract (2026-10-27).\n-- Preserves R15AnimationController non-carrier locomotion and airborne Jump/Land/4-lean/yaw-lock untouched.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\", 10) :: Folder?\nassert(Shared ~= nil, \"[DribbleAnimationController] Shared folder missing in ReplicatedStorage\")\nlocal configs = Shared:WaitForChild(\"configs\", 10) :: Folder?\nassert(configs ~= nil, \"[DribbleAnimationController] configs folder missing in Shared\")\n\nlocal LocomotionConfigs = require(configs:WaitForChild(\"R15LocomotionConfigs\"))\nlocal DribbleActionConfigs = require(configs:WaitForChild(\"DribbleActionConfigs\"))\nlocal R15AnimationController = require(script.Parent:WaitForChild(\"R15AnimationController\"))\nlocal DribbleAnimationHelper = require(script.Parent:WaitForChild(\"DribbleAnimationHelper\"))\nlocal ControllersFolder = script.Parent.Parent:WaitForChild(\"controllers\")\nlocal DribbleCutController = require(ControllersFolder:WaitForChild(\"DribbleCutController\"))\n\nlocal isInitialized = false\nlocal currentCharacter: Model? = nil\nlocal currentHumanoid: Humanoid? = nil\nlocal currentAnimator: Animator? = nil\nlocal characterGeneration: number = 0\nlocal currentRunningSpeed: number = 0\nlocal baseWeightsMuted: boolean = false\nlocal activeLoopKey: string = \"NONE\"\n\nlocal currentTracks: DribbleAnimationHelper.LoopTrackCache = {\n\tWalkDribble = nil,\n\tRunDribble = nil,\n\tGModeLoop = nil,\n}\nlocal currentSources: DribbleAnimationHelper.LoopRegistrationSources = {\n\tWalkDribble = \"NONE\",\n\tRunDribble = \"NONE\",\n\tGModeLoop = \"NONE\",\n}\nlocal currentAnimInstances: { Animation } = {}\nlocal activeConnections: { RBXScriptConnection } = {}\nlocal globalConnections: { RBXScriptConnection } = {}\n\nlocal DribbleAnimationController = {}\n\nlocal function restoreBaseLocomotionWeights()\n\tif not baseWeightsMuted then\n\t\treturn\n\tend\n\tbaseWeightsMuted = false\n\tlocal walkTrack = R15AnimationController.GetWalkTrack()\n\tif walkTrack then\n\t\tpcall(function()\n\t\t\twalkTrack:AdjustWeight(1.0, DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend)\n\tend\n\tlocal runTrack = R15AnimationController.GetRunTrack()\n\tif runTrack then\n\t\tpcall(function()\n\t\t\trunTrack:AdjustWeight(1.0, DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend)\n\tend\nend\n\nlocal function muteBaseLocomotionWeights()\n\tbaseWeightsMuted = true\n\tlocal walkTrack = R15AnimationController.GetWalkTrack()\n\tif walkTrack and walkTrack.IsPlaying then\n\t\tpcall(function()\n\t\t\twalkTrack:AdjustWeight(0.0001, 0.06)\n\t\tend)\n\tend\n\tlocal runTrack = R15AnimationController.GetRunTrack()\n\tif runTrack and runTrack.IsPlaying then\n\t\tpcall(function()\n\t\t\trunTrack:AdjustWeight(0.0001, 0.06)\n\t\tend)\n\tend\nend\n\nlocal function stopAllDribbleLoops(fadeSec: number?)\n\tlocal fade = fadeSec or DribbleActionConfigs.LOOP_FADE_SEC\n\tfor _, track in pairs(currentTracks) do\n\t\tif track and track.IsPlaying then\n\t\t\tpcall(function()\n\t\t\t\ttrack:Stop(fade)\n\t\t\tend)\n\t\tend\n\tend\n\tactiveLoopKey = \"NONE\"\n\trestoreBaseLocomotionWeights()\nend\n\nlocal function isGroundedState(hum: Humanoid): boolean\n\tif hum.FloorMaterial == Enum.Material.Air then\n\t\treturn false\n\tend\n\tlocal state = hum:GetState()\n\tif\n\t\tstate == Enum.HumanoidStateType.Jumping\n\t\tor state == Enum.HumanoidStateType.Freefall\n\t\tor state == Enum.HumanoidStateType.Climbing\n\t\tor state == Enum.HumanoidStateType.Swimming\n\t\tor state == Enum.HumanoidStateType.Seated\n\t\tor state == Enum.HumanoidStateType.Dead\n\t\tor state == Enum.HumanoidStateType.Physics\n\t\tor state == Enum.HumanoidStateType.PlatformStanding\n\tthen\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function updateDribblePlayback(thisGen: number)\n\tif characterGeneration ~= thisGen then\n\t\treturn\n\tend\n\tlocal char = currentCharacter\n\tlocal hum = currentHumanoid\n\tif not char or not hum or not char.Parent or hum.Health <= 0 then\n\t\tstopAllDribbleLoops(0.05)\n\t\treturn\n\tend\n\n\tlocal isCarrier = (char:GetAttribute(\"IsBallCarrier\") == true)\n\tlocal grounded = isGroundedState(hum)\n\n\tif not isCarrier or not grounded then\n\t\tif not grounded or not isCarrier then\n\t\t\tDribbleCutController.Cancel()\n\t\tend\n\t\tstopAllDribbleLoops(0.10)\n\t\tchar:SetAttribute(\"ActiveDribbleClip\", \"\")\n\t\treturn\n\tend\n\n\t-- One-shot directional/reverse cut takes priority and locks movement until completion\n\tif DribbleCutController.IsLocked(char) then\n\t\tstopAllDribbleLoops(DribbleActionConfigs.CUT_FADE_SEC)\n\t\tchar:SetAttribute(\"ActiveDribbleClip\", DribbleCutController.GetActiveClipName() or \"\")\n\t\treturn\n\tend\n\n\tlocal rootPart = hum.RootPart\n\tlocal horizVel = if rootPart\n\t\tthen Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z).Magnitude\n\t\telse 0\n\tlocal isMoving = (hum.MoveDirection.Magnitude > LocomotionConfigs.Playback.MoveDirectionThreshold)\n\t\tor (currentRunningSpeed > LocomotionConfigs.Playback.SpeedStationaryThreshold)\n\t\tor (horizVel > 1.0)\n\n\tif not isMoving then\n\t\tstopAllDribbleLoops(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tchar:SetAttribute(\"ActiveDribbleClip\", \"\")\n\t\treturn\n\tend\n\n\tlocal goalMode = (char:GetAttribute(\"GoalDribbleActive\") == true)\n\tlocal isSprinting = (char:GetAttribute(\"IsSprinting\") == true)\n\t\tor (not goalMode and hum.WalkSpeed >= LocomotionConfigs.Playback.SprintSpeedThreshold)\n\n\tmuteBaseLocomotionWeights()\n\n\tif goalMode then\n\t\tif currentTracks.WalkDribble and currentTracks.WalkDribble.IsPlaying then\n\t\t\tcurrentTracks.WalkDribble:Stop(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend\n\t\tif currentTracks.RunDribble and currentTracks.RunDribble.IsPlaying then\n\t\t\tcurrentTracks.RunDribble:Stop(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend\n\t\tlocal gTrack = currentTracks.GModeLoop\n\t\tif gTrack then\n\t\t\tif not gTrack.IsPlaying then\n\t\t\t\tgTrack:Play(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\t\tend\n\t\t\tlocal refSpeed = if horizVel > 1.0 then horizVel else DribbleActionConfigs.GOAL_BASE_SPEED\n\t\t\tgTrack:AdjustSpeed(math.clamp(refSpeed / DribbleActionConfigs.GOAL_BASE_SPEED, 0.75, 1.25))\n\t\t\tactiveLoopKey = \"GModeLoop\"\n\t\t\tchar:SetAttribute(\"ActiveDribbleClip\", DribbleActionConfigs.Clips.GModeLoop.ClipName)\n\t\tend\n\telseif isSprinting then\n\t\tif currentTracks.WalkDribble and currentTracks.WalkDribble.IsPlaying then\n\t\t\tcurrentTracks.WalkDribble:Stop(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend\n\t\tif currentTracks.GModeLoop and currentTracks.GModeLoop.IsPlaying then\n\t\t\tcurrentTracks.GModeLoop:Stop(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend\n\t\tlocal runTrack = currentTracks.RunDribble\n\t\tif runTrack then\n\t\t\tif not runTrack.IsPlaying then\n\t\t\t\trunTrack:Play(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\t\tend\n\t\t\tlocal refSpeed = if horizVel > 2.0 then horizVel else hum.WalkSpeed\n\t\t\trunTrack:AdjustSpeed(math.clamp(refSpeed / DribbleActionConfigs.RUN_BASE_SPEED, 0.75, 1.25))\n\t\t\tactiveLoopKey = \"RunDribble\"\n\t\t\tchar:SetAttribute(\"ActiveDribbleClip\", DribbleActionConfigs.Clips.RunDribble.ClipName)\n\t\tend\n\telse\n\t\tif currentTracks.RunDribble and currentTracks.RunDribble.IsPlaying then\n\t\t\tcurrentTracks.RunDribble:Stop(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend\n\t\tif currentTracks.GModeLoop and currentTracks.GModeLoop.IsPlaying then\n\t\t\tcurrentTracks.GModeLoop:Stop(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\tend\n\t\tlocal walkTrack = currentTracks.WalkDribble\n\t\tif walkTrack then\n\t\t\tif not walkTrack.IsPlaying then\n\t\t\t\twalkTrack:Play(DribbleActionConfigs.LOOP_FADE_SEC)\n\t\t\tend\n\t\t\tlocal refSpeed = if horizVel > 1.5 then horizVel else hum.WalkSpeed\n\t\t\twalkTrack:AdjustSpeed(math.clamp(refSpeed / DribbleActionConfigs.WALK_BASE_SPEED, 0.70, 1.30))\n\t\t\tactiveLoopKey = \"WalkDribble\"\n\t\t\tchar:SetAttribute(\"ActiveDribbleClip\", DribbleActionConfigs.Clips.WalkDribble.ClipName)\n\t\tend\n\tend\nend\n\nlocal function cleanupCharacterConnections()\n\tfor _, conn in ipairs(activeConnections) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(activeConnections)\nend\n\nlocal function invalidateCharacterState()\n\tcleanupCharacterConnections()\n\tDribbleCutController.Cancel()\n\tstopAllDribbleLoops(0)\n\tDribbleAnimationHelper.CleanupLoopTracks(currentTracks, currentAnimInstances)\n\tcurrentTracks = {\n\t\tWalkDribble = nil,\n\t\tRunDribble = nil,\n\t\tGModeLoop = nil,\n\t}\n\tcurrentSources = {\n\t\tWalkDribble = \"NONE\",\n\t\tRunDribble = \"NONE\",\n\t\tGModeLoop = \"NONE\",\n\t}\n\tcurrentCharacter = nil\n\tcurrentHumanoid = nil\n\tcurrentAnimator = nil\n\tcurrentRunningSpeed = 0\n\tactiveLoopKey = \"NONE\"\nend\n\nlocal function attachLoopMarkers(thisGen: number, character: Model, key: DribbleAnimationHelper.DribbleLoopKey, track: AnimationTrack?)\n\tif not track then\n\t\treturn\n\tend\n\tlocal spec = (DribbleActionConfigs.Clips :: { [string]: DribbleActionConfigs.DribbleClipSpec })[key]\n\tif not spec then\n\t\treturn\n\tend\n\n\ttable.insert(\n\t\tactiveConnections,\n\t\ttrack:GetMarkerReachedSignal(\"TouchL\"):Connect(function()\n\t\t\tif characterGeneration == thisGen and currentCharacter == character and track.IsPlaying then\n\t\t\t\tDribbleAnimationHelper.NotifyTouchMarker(character, \"L\", spec.ClipName, false)\n\t\t\tend\n\t\tend)\n\t)\n\n\ttable.insert(\n\t\tactiveConnections,\n\t\ttrack:GetMarkerReachedSignal(\"TouchR\"):Connect(function()\n\t\t\tif characterGeneration == thisGen and currentCharacter == character and track.IsPlaying then\n\t\t\t\tDribbleAnimationHelper.NotifyTouchMarker(character, \"R\", spec.ClipName, false)\n\t\t\tend\n\t\tend)\n\t)\nend\n\nlocal function onCharacterAdded(character: Model)\n\tlocal localPlayer = Players.LocalPlayer\n\tif not localPlayer or localPlayer.Character ~= character or not character:IsDescendantOf(game) then\n\t\treturn\n\tend\n\n\tcharacterGeneration += 1\n\tlocal thisGen = characterGeneration\n\n\tinvalidateCharacterState()\n\tcurrentCharacter = character\n\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\tif\n\t\tcharacterGeneration ~= thisGen\n\t\tor localPlayer.Character ~= character\n\t\tor not character:IsDescendantOf(game)\n\t\tor not humanoid\n\t\tor not humanoid:IsDescendantOf(character)\n\tthen\n\t\treturn\n\tend\n\n\tlocal animator = humanoid:WaitForChild(\"Animator\", 10) :: Animator?\n\tif\n\t\tcharacterGeneration ~= thisGen\n\t\tor localPlayer.Character ~= character\n\t\tor not character:IsDescendantOf(game)\n\t\tor not humanoid:IsDescendantOf(character)\n\t\tor not animator\n\t\tor not animator:IsDescendantOf(humanoid)\n\tthen\n\t\treturn\n\tend\n\n\tcurrentHumanoid = humanoid\n\tcurrentAnimator = animator\n\n\tlocal tracks, sources, animInstances = DribbleAnimationHelper.LoadLoopTracks(animator)\n\tif characterGeneration ~= thisGen or localPlayer.Character ~= character or not character:IsDescendantOf(game) then\n\t\tDribbleAnimationHelper.CleanupLoopTracks(tracks, animInstances)\n\t\treturn\n\tend\n\n\tcurrentTracks = tracks\n\tcurrentSources = sources\n\tcurrentAnimInstances = animInstances\n\n\t-- Warm up one-shot cut clips asynchronously so TryStart sees track.Length > 0 immediately\n\ttask.spawn(function()\n\t\tif characterGeneration == thisGen and currentAnimator == animator then\n\t\t\tDribbleAnimationHelper.WarmupCutTracks(animator)\n\t\tend\n\tend)\n\n\tattachLoopMarkers(thisGen, character, \"WalkDribble\", tracks.WalkDribble)\n\tattachLoopMarkers(thisGen, character, \"RunDribble\", tracks.RunDribble)\n\tattachLoopMarkers(thisGen, character, \"GModeLoop\", tracks.GModeLoop)\n\n\ttable.insert(\n\t\tactiveConnections,\n\t\thumanoid.Died:Connect(function()\n\t\t\tif characterGeneration == thisGen then\n\t\t\t\tinvalidateCharacterState()\n\t\t\tend\n\t\tend)\n\t)\n\n\tlocal function observe()\n\t\tif characterGeneration == thisGen then\n\t\t\tupdateDribblePlayback(thisGen)\n\t\tend\n\tend\n\n\ttable.insert(activeConnections, humanoid:GetPropertyChangedSignal(\"MoveDirection\"):Connect(observe))\n\ttable.insert(activeConnections, humanoid:GetPropertyChangedSignal(\"WalkSpeed\"):Connect(observe))\n\ttable.insert(\n\t\tactiveConnections,\n\t\thumanoid.Running:Connect(function(speed: number)\n\t\t\tif characterGeneration == thisGen then\n\t\t\t\tcurrentRunningSpeed = speed\n\t\t\t\tupdateDribblePlayback(thisGen)\n\t\t\tend\n\t\tend)\n\t)\n\ttable.insert(\n\t\tactiveConnections,\n\t\thumanoid.StateChanged:Connect(function()\n\t\t\tif characterGeneration == thisGen then\n\t\t\t\tupdateDribblePlayback(thisGen)\n\t\t\tend\n\t\tend)\n\t)\n\ttable.insert(activeConnections, character:GetAttributeChangedSignal(\"IsBallCarrier\"):Connect(observe))\n\ttable.insert(activeConnections, character:GetAttributeChangedSignal(\"GoalDribbleActive\"):Connect(observe))\n\ttable.insert(activeConnections, character:GetAttributeChangedSignal(\"IsSprinting\"):Connect(observe))\n\ttable.insert(activeConnections, character:GetAttributeChangedSignal(\"DribbleCutActive\"):Connect(observe))\n\ttable.insert(\n\t\tactiveConnections,\n\t\tRunService.Heartbeat:Connect(function()\n\t\t\tif characterGeneration == thisGen then\n\t\t\t\tupdateDribblePlayback(thisGen)\n\t\t\tend\n\t\tend)\n\t)\n\n\tupdateDribblePlayback(thisGen)\nend\n\nlocal function onCharacterRemoving(character: Model)\n\tif character == currentCharacter then\n\t\tinvalidateCharacterState()\n\tend\nend\n\nfunction DribbleAnimationController.Init(_timeoutBudget: number?)\n\tif isInitialized then\n\t\treturn\n\tend\n\tisInitialized = true\n\n\tlocal localPlayer = Players.LocalPlayer\n\tassert(localPlayer ~= nil, \"[DribbleAnimationController] LocalPlayer required for initialization\")\n\n\ttable.insert(globalConnections, localPlayer.CharacterAdded:Connect(onCharacterAdded))\n\ttable.insert(globalConnections, localPlayer.CharacterRemoving:Connect(onCharacterRemoving))\n\n\tlocal existingChar = localPlayer.Character\n\tif existingChar and existingChar:IsDescendantOf(game) then\n\t\ttask.spawn(function()\n\t\t\tonCharacterAdded(existingChar)\n\t\tend)\n\tend\nend\n\nfunction DribbleAnimationController.Cleanup()\n\tinvalidateCharacterState()\n\tfor _, conn in ipairs(globalConnections) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(globalConnections)\n\tisInitialized = false\nend\n\nfunction DribbleAnimationController.IsReady(): boolean\n\tlocal localPlayer = Players.LocalPlayer\n\tif not localPlayer or not currentCharacter or not currentHumanoid or not currentAnimator then\n\t\treturn false\n\tend\n\treturn currentCharacter == localPlayer.Character\n\t\tand currentCharacter:IsDescendantOf(game)\n\t\tand currentHumanoid.Health > 0\nend\n\nfunction DribbleAnimationController.GetWalkDribbleTrack(): AnimationTrack?\n\treturn currentTracks.WalkDribble\nend\n\nfunction DribbleAnimationController.GetRunDribbleTrack(): AnimationTrack?\n\treturn currentTracks.RunDribble\nend\n\nfunction DribbleAnimationController.GetGModeLoopTrack(): AnimationTrack?\n\treturn currentTracks.GModeLoop\nend\n\nfunction DribbleAnimationController.GetActiveLoopKey(): string\n\treturn activeLoopKey\nend\n\nfunction DribbleAnimationController.GetRegistrationSources(): DribbleAnimationHelper.LoopRegistrationSources\n\treturn {\n\t\tWalkDribble = currentSources.WalkDribble,\n\t\tRunDribble = currentSources.RunDribble,\n\t\tGModeLoop = currentSources.GModeLoop,\n\t}\nend\n\nreturn table.freeze(DribbleAnimationController)\n"},{"disk":"src/client/controllers/DribbleCutController.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","controllers","DribbleCutController"],"className":"ModuleScript","content":"--!strict\n-- Only an Owner-approved, successfully loaded one-shot clip can lock movement.\n-- Governed by RF02-DRIBBLE-ANIMATION-INTEGRATION Contract (2026-10-27).\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Config = require(Shared:WaitForChild(\"configs\"):WaitForChild(\"DribbleActionConfigs\"))\nlocal CharacterFolder = script.Parent.Parent:WaitForChild(\"character\")\nlocal DribbleAnimationHelper = require(CharacterFolder:WaitForChild(\"DribbleAnimationHelper\"))\n\nlocal Controller = {}\nlocal track: AnimationTrack? = nil\nlocal activeConnections: { RBXScriptConnection } = {}\nlocal lockedCharacter: Model? = nil\nlocal activeCutName: string? = nil\nlocal activeClipName: string? = nil\nlocal deadline = 0.0\n\nlocal function disconnectAll()\n\tfor _, conn in ipairs(activeConnections) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(activeConnections)\nend\n\nfunction Controller.Cancel()\n\tdisconnectAll()\n\tlocal old = track\n\ttrack = nil\n\tactiveCutName = nil\n\tactiveClipName = nil\n\tif lockedCharacter then\n\t\tlockedCharacter:SetAttribute(\"DribbleCutActive\", false)\n\t\tlockedCharacter:SetAttribute(\"DribbleCutName\", \"\")\n\t\tlockedCharacter:SetAttribute(\"DribbleCutClipName\", \"\")\n\tend\n\tlockedCharacter = nil\n\tdeadline = 0\n\tif old then\n\t\tpcall(function()\n\t\t\told:Stop(Config.CUT_FADE_SEC)\n\t\t\told:Destroy()\n\t\tend)\n\tend\nend\n\nfunction Controller.TryStart(character: Model, name: string): boolean\n\tif track then\n\t\treturn false\n\tend\n\tif not character or character:GetAttribute(\"IsBallCarrier\") ~= true then\n\t\treturn false\n\tend\n\n\tlocal approved = (Config.ApprovedCutAnimations :: { [string]: string })[name]\n\tif not approved or #approved == 0 then\n\t\treturn false\n\tend\n\n\tlocal hum = character:FindFirstChildOfClass(\"Humanoid\")\n\tlocal animator = hum and hum:FindFirstChildOfClass(\"Animator\")\n\tif not hum or hum.Health <= 0 or not animator or hum.FloorMaterial == Enum.Material.Air then\n\t\treturn false\n\tend\n\n\tlocal newTrack, resolvedClipName = DribbleAnimationHelper.LoadCutTrack(animator, name)\n\tif not newTrack or not resolvedClipName then\n\t\twarn(\"[DribbleCut] Approved clip failed to load: \" .. name)\n\t\treturn false\n\tend\n\n\tif newTrack.Length <= 0 or newTrack.Length > Config.CUT_MAX_DURATION then\n\t\tnewTrack:Destroy()\n\t\twarn(\"[DribbleCut] Clip is not ready or exceeds bounded lock duration: \" .. name)\n\t\treturn false\n\tend\n\n\ttrack = newTrack\n\tlockedCharacter = character\n\tactiveCutName = name\n\tactiveClipName = resolvedClipName\n\tdeadline = os.clock() + math.min(Config.CUT_MAX_DURATION, newTrack.Length + 0.15)\n\tnewTrack.Looped = false\n\tnewTrack.Priority = Enum.AnimationPriority.Action\n\n\tcharacter:SetAttribute(\"DribbleCutActive\", true)\n\tcharacter:SetAttribute(\"DribbleCutName\", name)\n\tcharacter:SetAttribute(\"DribbleCutClipName\", resolvedClipName)\n\tcharacter:SetAttribute(\"DribbleCutControlReleaseReached\", false)\n\n\ttable.insert(\n\t\tactiveConnections,\n\t\tnewTrack:GetMarkerReachedSignal(\"TouchL\"):Connect(function()\n\t\t\tif track == newTrack and lockedCharacter == character then\n\t\t\t\tDribbleAnimationHelper.NotifyTouchMarker(character, \"L\", resolvedClipName, true)\n\t\t\tend\n\t\tend)\n\t)\n\n\ttable.insert(\n\t\tactiveConnections,\n\t\tnewTrack:GetMarkerReachedSignal(\"TouchR\"):Connect(function()\n\t\t\tif track == newTrack and lockedCharacter == character then\n\t\t\t\tDribbleAnimationHelper.NotifyTouchMarker(character, \"R\", resolvedClipName, true)\n\t\t\tend\n\t\tend)\n\t)\n\n\ttable.insert(\n\t\tactiveConnections,\n\t\tnewTrack:GetMarkerReachedSignal(\"ControlRelease\"):Connect(function()\n\t\t\tif track == newTrack and lockedCharacter == character then\n\t\t\t\tcharacter:SetAttribute(\"DribbleCutControlReleaseReached\", true)\n\t\t\tend\n\t\tend)\n\t)\n\n\ttable.insert(\n\t\tactiveConnections,\n\t\tnewTrack.Ended:Connect(function()\n\t\t\tif track == newTrack then\n\t\t\t\tController.Cancel()\n\t\t\tend\n\t\tend)\n\t)\n\n\tnewTrack:Play(Config.CUT_FADE_SEC)\n\treturn true\nend\n\nfunction Controller.IsLocked(character: Model): boolean\n\tlocal hum = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tif\n\t\tlockedCharacter ~= character\n\t\tor not hum\n\t\tor hum.Health <= 0\n\t\tor hum.FloorMaterial == Enum.Material.Air\n\t\tor character:GetAttribute(\"IsBallCarrier\") ~= true\n\t\tor os.clock() >= deadline\n\t\tor (track ~= nil and not track.IsPlaying)\n\tthen\n\t\tController.Cancel()\n\tend\n\treturn track ~= nil\nend\n\nfunction Controller.GetActiveTrack(): AnimationTrack?\n\treturn track\nend\n\nfunction Controller.GetActiveCutName(): string?\n\treturn activeCutName\nend\n\nfunction Controller.GetActiveClipName(): string?\n\treturn activeClipName\nend\n\nreturn Controller\n"},{"disk":"src/client/controllers/MovementHeadingPreviewController.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client","controllers","MovementHeadingPreviewController"],"className":"ModuleScript","content":"--!strict\n-- src/client/controllers/MovementHeadingPreviewController.luau\n-- Camera-Relative Movement Adapter: Grounded Reticle Facing (ShiftLock style) + Continuous Camera-Relative WASD\n-- Governed by RF02-CAMERA-RELATIVE Hand-Off Contract (2026-10-27)\n\nlocal GuiService = game:GetService(\"GuiService\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal localPlayer = Players.LocalPlayer\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal ConfigsFolder = Shared:WaitForChild(\"configs\")\nlocal CameraPreviewConfigs = require(ConfigsFolder:WaitForChild(\"CameraPreviewConfigs\"))\nlocal JumpConfigs = require(ConfigsFolder:WaitForChild(\"JumpConfigs\"))\nlocal DribbleConfigs = require(ConfigsFolder:WaitForChild(\"DribbleConfigs\"))\nlocal DribbleGeometryHelper = require(Shared:WaitForChild(\"DribbleGeometryHelper\"))\nlocal DribbleActionConfigs = require(ConfigsFolder:WaitForChild(\"DribbleActionConfigs\"))\nlocal DribbleControlRules = require(Shared:WaitForChild(\"DribbleControlRules\"))\nlocal DribbleCutController = require(script.Parent:WaitForChild(\"DribbleCutController\"))\nlocal MOVEMENT_STEP_NAME = \"CageZeroMovementHeadingStep\"\n\nlocal MovementHeadingPreviewController = {}\n\nlocal isInitialized = false\nlocal isActive = false\n\n-- Native PlayerModule controls handle\nlocal nativeControls: any = nil\n\n-- Key state tracking\nlocal isWDown = false\nlocal isSDown = false\nlocal isADown = false\nlocal isDDown = false\nlocal isSpaceDown = false\nlocal isGHeld = false\nlocal goalDirection: Vector3? = nil\nlocal lastGoalIntent = false\nlocal lastGoalSentTime = 0.0\nlocal lastCutChord = \"NONE\"\nlocal lastCutInput = Vector3.zero\nlocal lastCutInputTime = 0.0\n\n-- Bounded jump input buffer (os.clock deadline); cleared once Humanoid enters Jumping\nlocal jumpBufferUntil: number = 0\n\n-- Movement State\nlocal currentChord: string = \"NONE\"\nlocal currentWorldDirection: Vector3 = Vector3.zero\n\n-- Phase-Aware Dribble Turn Gate State (RF02-DRIBBLE-RECEIVE 2026-10-27)\nlocal rawWorldDirection: Vector3 = Vector3.zero\nlocal dribbleTurnFactor: number = 1.0\n\n-- Character tracking\nlocal currentCharacter: Model? = nil\nlocal currentHumanoid: Humanoid? = nil\nlocal currentHrp: BasePart? = nil\n\n-- Remote handle for carrier camera intent reporting\nlocal ballActionRemoteRef: any = nil\nlocal lastSentCameraIntent: number = 0\n\nlocal connections: { RBXScriptConnection } = {}\n\n-- References (lazy required to avoid circular dependencies)\nlocal cameraControllerRef: any = nil\nlocal airMovementControllerRef: any = nil\nlocal sprintControllerRef: any = nil\n\nlocal function getCameraController(): any\n\tif cameraControllerRef ~= nil then\n\t\treturn cameraControllerRef\n\tend\n\tlocal controllers = script.Parent\n\tif controllers then\n\t\tlocal mod = controllers:FindFirstChild(\"CameraPreviewController\")\n\t\tif mod and mod:IsA(\"ModuleScript\") then\n\t\t\tcameraControllerRef = require(mod)\n\t\tend\n\tend\n\treturn cameraControllerRef\nend\n\nlocal function getAirMovementController(): any\n\tif airMovementControllerRef ~= nil then\n\t\treturn airMovementControllerRef\n\tend\n\tlocal controllers = script.Parent\n\tlocal mod = controllers and controllers:FindFirstChild(\"AirMovementController\")\n\tif mod and mod:IsA(\"ModuleScript\") then\n\t\tairMovementControllerRef = require(mod)\n\tend\n\treturn airMovementControllerRef\nend\n\nlocal function getSprintController(): any\n\tif sprintControllerRef ~= nil then\n\t\treturn sprintControllerRef\n\tend\n\tlocal controllers = script.Parent\n\tlocal mod = controllers and controllers:FindFirstChild(\"SprintController\")\n\tif mod and mod:IsA(\"ModuleScript\") then\n\t\tsprintControllerRef = require(mod)\n\tend\n\treturn sprintControllerRef\nend\n\nlocal function getBallActionRemote(): RemoteEvent?\n\tif ballActionRemoteRef ~= nil then\n\t\treturn ballActionRemoteRef\n\tend\n\tlocal remotesFolder = ReplicatedStorage:FindFirstChild(\"CageZeroRemotes\")\n\tif remotesFolder then\n\t\tlocal r = remotesFolder:FindFirstChild(\"BallActionRequest\")\n\t\tif r and r:IsA(\"RemoteEvent\") then\n\t\t\tballActionRemoteRef = r\n\t\tend\n\tend\n\treturn ballActionRemoteRef\nend\n\nlocal function notifyMovementIntent(isMoving: boolean, forward: number)\n\tlocal sprintCtrl = getSprintController()\n\tif sprintCtrl then\n\t\tif sprintCtrl.SetMovementIntent then\n\t\t\tsprintCtrl.SetMovementIntent(isMoving)\n\t\telseif sprintCtrl.SetForwardIntent then\n\t\t\tsprintCtrl.SetForwardIntent(forward)\n\t\tend\n\tend\nend\n\nlocal function getCameraYaw(): number\n\tlocal camCtrl = getCameraController()\n\tif camCtrl and camCtrl.GetCameraYaw then\n\t\treturn camCtrl.GetCameraYaw()\n\tend\n\tlocal cam = Workspace.CurrentCamera\n\tif cam then\n\t\tlocal _, y, _ = cam.CFrame:ToOrientation()\n\t\treturn y\n\tend\n\treturn 0.0\nend\n\nlocal function publishLeanInput(direction: Vector3)\n\tlocal airCtrl = getAirMovementController()\n\tif airCtrl and airCtrl.SetLeanInputDirection then\n\t\tairCtrl.SetLeanInputDirection(direction)\n\tend\nend\n\nlocal function computeLocalInputVector(): (Vector3, string, number)\n\tlocal forward = (isWDown and 1 or 0) - (isSDown and 1 or 0)\n\tlocal lateral = (isDDown and 1 or 0) - (isADown and 1 or 0)\n\n\tlocal chord = \"\"\n\tif forward > 0 then\n\t\tchord ..= \"W\"\n\telseif forward < 0 then\n\t\tchord ..= \"S\"\n\tend\n\tif lateral < 0 then\n\t\tchord ..= \"A\"\n\telseif lateral > 0 then\n\t\tchord ..= \"D\"\n\tend\n\tif chord == \"\" then\n\t\tchord = \"NONE\"\n\tend\n\n\tif forward == 0 and lateral == 0 then\n\t\treturn Vector3.zero, chord, forward\n\tend\n\n\t-- In camera space:\n\t-- -Z is forward (W), +Z is backward (S)\n\t-- -X is left (A), +X is right (D)\n\tlocal rawLocalVector = Vector3.new(lateral, 0, -forward)\n\tif rawLocalVector.Magnitude < 0.001 then\n\t\treturn Vector3.zero, chord, forward\n\tend\n\n\treturn rawLocalVector.Unit, chord, forward\nend\n\nlocal function computeWorldDirection(camYaw: number): (Vector3, string, number)\n\tlocal localVec, chord, forward = computeLocalInputVector()\n\tif localVec.Magnitude < 0.001 then\n\t\treturn Vector3.zero, chord, forward\n\tend\n\tif goalDirection then\n\t\treturn DribbleControlRules.GoalMovement(localVec, goalDirection), chord, forward\n\tend\n\tlocal yawRotation = CFrame.Angles(0, camYaw, 0)\n\tlocal worldVec = (yawRotation:VectorToWorldSpace(localVec)).Unit\n\treturn worldVec, chord, forward\nend\n\nlocal function checkIsAirborne(): boolean\n\tlocal nativeAirborne = false\n\tif currentHumanoid and currentHumanoid.Parent then\n\t\tlocal state = currentHumanoid:GetState()\n\t\tnativeAirborne = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)\n\tend\n\tlocal airCtrl = getAirMovementController()\n\tlocal ctrlAirborne = (airCtrl ~= nil and airCtrl.IsAirborne ~= nil and airCtrl.IsAirborne() == true)\n\treturn nativeAirborne or ctrlAirborne\nend\n\nlocal function isEligibleGrounded(): boolean\n\tlocal hum = currentHumanoid\n\tlocal hrp = currentHrp\n\tlocal char = currentCharacter\n\tif not hum or not hrp or not char or not hum.Parent or hum.Health <= 0 then\n\t\treturn false\n\tend\n\n\tlocal state = hum:GetState()\n\n\t-- Native airborne states are never eligible grounded\n\tif state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then\n\t\treturn false\n\tend\n\n\t-- AirMovementController airborne state is never eligible grounded\n\tlocal airCtrl = getAirMovementController()\n\tif airCtrl and airCtrl.IsAirborne and airCtrl.IsAirborne() == true then\n\t\treturn false\n\tend\n\n\t-- Unsupported / specialized locomotion states: do NOT force camera yaw or ground movement\n\tif state == Enum.HumanoidStateType.Seated\n\t\tor state == Enum.HumanoidStateType.Climbing\n\t\tor state == Enum.HumanoidStateType.Swimming\n\t\tor state == Enum.HumanoidStateType.Physics\n\t\tor state == Enum.HumanoidStateType.Ragdoll\n\t\tor state == Enum.HumanoidStateType.Dead then\n\t\treturn false\n\tend\n\n\t-- Must be on solid ground (non-air floor material), OR in Landed state\n\tif hum.FloorMaterial == Enum.Material.Air and state ~= Enum.HumanoidStateType.Landed then\n\t\treturn false\n\tend\n\n\treturn true\nend\n\nlocal function updateMovementIntent(camYaw: number)\n\tgoalDirection = nil\n\tif isGHeld and isEligibleGrounded() and currentCharacter and currentHrp then\n\t\tlocal goal = currentCharacter:GetAttribute(\"AttackGoalPosition\")\n\t\tif typeof(goal) == \"Vector3\" then\n\t\t\tlocal direction = DribbleControlRules.HorizontalDirection(goal - currentHrp.Position)\n\t\t\tif direction.Magnitude > 0 then goalDirection = direction end\n\t\tend\n\tend\n\tlocal activeGoal = goalDirection ~= nil\n\tlocal now = os.clock()\n\tif currentCharacter and (activeGoal ~= lastGoalIntent or (activeGoal and now - lastGoalSentTime >= DribbleActionConfigs.INTENT_INTERVAL)) then\n\t\tlocal remote = getBallActionRemote()\n\t\tif remote then\n\t\t\tremote:FireServer({action = \"GoalDribble\", active = activeGoal, character = currentCharacter})\n\t\t\tlastGoalIntent = activeGoal\n\t\t\tlastGoalSentTime = now\n\t\tend\n\tend\n\tlocal worldDir, chord, forward = computeWorldDirection(camYaw)\n\trawWorldDirection = worldDir\n\tcurrentChord = chord\n\tpublishLeanInput(worldDir)\n\n\tcurrentWorldDirection = worldDir\n\tlocal char = currentCharacter\n\tif char and char:GetAttribute(\"IsBallCarrier\") == true and isEligibleGrounded() then\n\t\tlocal opposingKeys = (isWDown and isSDown) or (isADown and isDDown)\n\t\tif opposingKeys then\n\t\t\tDribbleCutController.Cancel()\n\t\t\tlastCutInput = Vector3.zero\n\t\t\tlastCutChord = \"NONE\"\n\t\t\tcurrentWorldDirection = Vector3.zero\n\t\telse\n\t\t\tlocal input = computeLocalInputVector()\n\t\t\tlocal locked = DribbleCutController.IsLocked(char)\n\t\t\tif input.Magnitude > 0 then\n\t\t\t\tif now - lastCutInputTime > DribbleActionConfigs.REVERSE_INPUT_GRACE_SEC then\n\t\t\t\t\tlastCutInput = Vector3.zero\n\t\t\t\t\tlastCutChord = \"NONE\"\n\t\t\t\tend\n\t\t\t\tif not locked then\n\t\t\t\t\tlocal name = DribbleControlRules.CutForTransition(lastCutChord, chord, lastCutInput, input, DribbleActionConfigs.CUT_REVERSE_ANGLE_DEG)\n\t\t\t\t\tif not name and lastCutChord == \"NONE\" and #chord == 2 then\n\t\t\t\t\t\tname = if input.Z < 0\n\t\t\t\t\t\t\tthen (if input.X < 0 then \"FrontLeft\" else \"FrontRight\")\n\t\t\t\t\t\t\telse (if input.X < 0 then \"BackLeft\" else \"BackRight\")\n\t\t\t\t\tend\n\t\t\t\t\tif\n\t\t\t\t\t\t(activeGoal or char:GetAttribute(\"GoalDribbleActive\") == true)\n\t\t\t\t\t\tand (name == \"ReverseLeft\" or name == \"ReverseRight\")\n\t\t\t\t\t\tand lastCutChord == \"W\"\n\t\t\t\t\t\tand chord == \"S\"\n\t\t\t\t\tthen\n\t\t\t\t\t\tname = \"GoalReverse\"\n\t\t\t\t\tend\n\t\t\t\t\tif name then\n\t\t\t\t\t\tlocked = DribbleCutController.TryStart(char, name)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\t-- Latest held input wins when the real animation finishes, without replay.\n\t\t\t\tlastCutChord = chord\n\t\t\t\tlastCutInput = input\n\t\t\t\tlastCutInputTime = now\n\t\t\tend\n\t\t\tif locked then\n\t\t\t\tcurrentWorldDirection = Vector3.zero\n\t\t\tend\n\t\tend\n\telse\n\t\tDribbleCutController.Cancel()\n\t\tlastCutInput = Vector3.zero\n\t\tlastCutChord = \"NONE\"\n\tend\n\n\tlocal isMoving = currentWorldDirection.Magnitude > 0.001\n\tnotifyMovementIntent(isMoving and not activeGoal, forward)\nend\n\nlocal function getShortestAngleDiff(target: number, current: number): number\n\treturn (target - current + math.pi) % (2 * math.pi) - math.pi\nend\n\nlocal function updateGroundedFacing(camYaw: number, dt: number): number\n\tlocal hrp = currentHrp\n\tlocal hum = currentHumanoid\n\tif not hrp or not hum or hum.Health <= 0 then\n\t\treturn 1.0\n\tend\n\n\t-- Ensure AutoRotate is false so native Humanoid does NOT rotate body toward MoveDirection\n\tif hum.AutoRotate then\n\t\thum.AutoRotate = false\n\tend\n\n\t-- If stationary, maintain current heading; do NOT auto-align to reticle\n\tif currentWorldDirection.Magnitude <= 0.001 and not goalDirection then\n\t\treturn 1.0\n\tend\n\tif currentCharacter and DribbleCutController.IsLocked(currentCharacter) then return 1.0 end\n\n\t-- Ground body faces actual movement direction in 360°\n\tlocal facing = goalDirection or currentWorldDirection\n\tlocal targetYaw = math.atan2(-facing.X, -facing.Z)\n\n\tlocal rx, currentYaw, rz = hrp.CFrame:ToOrientation()\n\tlocal diff = getShortestAngleDiff(targetYaw, currentYaw)\n\tlocal deadband = CameraPreviewConfigs.Movement.GroundedFacingDeadbandRad or 0.001\n\n\tlocal speedDipFactor = 1.0\n\tlocal movementCfg = CameraPreviewConfigs.Movement\n\n\t-- Speed dip calculation for sharp turns (body weight/inertia)\n\tif movementCfg and movementCfg.TurnSpeedDipEnabled ~= false then\n\t\tlocal threshRad = math.rad(movementCfg.TurnSpeedDipThresholdDeg or 30.0)\n\t\tlocal absDiff = math.abs(diff)\n\t\tif absDiff > threshRad then\n\t\t\tlocal minFactor = movementCfg.TurnSpeedDipMinFactor or 0.65\n\t\t\tlocal norm = math.clamp((absDiff - threshRad) / (math.pi - threshRad), 0, 1)\n\t\t\tspeedDipFactor = 1.0 - (1.0 - minFactor) * (norm ^ 1.5)\n\t\tend\n\tend\n\n\t-- Dribbling carrier ONLY (valid grounded carrier): configurable turn slow-down, immediate drop, smooth recovery.\n\t-- No contact/phase/timer gate: the heading above always follows the latest intent immediately.\n\tlocal char = currentCharacter\n\tlocal isCarrier = (char and char:GetAttribute(\"IsBallCarrier\") == true)\n\tif isCarrier then\n\t\tlocal isSprinting = (char:GetAttribute(\"IsSprinting\") == true)\n\t\tlocal target = DribbleGeometryHelper.ComputeTurnSpeedFactor(diff, isSprinting)\n\t\tif target < dribbleTurnFactor then\n\t\t\tdribbleTurnFactor = target\n\t\telse\n\t\t\tdribbleTurnFactor = math.min(target, dribbleTurnFactor + DribbleConfigs.DRIBBLE_TURN_RECOVERY_RATE * math.clamp(dt, 0.001, 0.1))\n\t\tend\n\t\tlocal blocked = char:GetAttribute(\"DribbleSpeedFactor\")\n\t\tlocal blockedFactor = if typeof(blocked) == \"number\" then math.clamp(blocked, 0, 1) else 1.0\n\t\tspeedDipFactor = dribbleTurnFactor * blockedFactor\n\telse\n\t\tdribbleTurnFactor = 1.0\n\tend\n\n\tif math.abs(diff) > deadband or math.abs(rx) > 0.02 or math.abs(rz) > 0.02 then\n\t\tlocal newYaw = targetYaw\n\t\tif movementCfg and movementCfg.TurnSmoothingEnabled ~= false then\n\t\t\tlocal turnSpeed = if isCarrier\n\t\t\t\tthen (DribbleConfigs.DRIBBLE_TURN_RATE_RAD_PER_SEC or 10.0)\n\t\t\t\telse (movementCfg.FacingTurnSpeedRadPerSec or 20.0)\n\t\t\tlocal clampedDt = math.clamp(dt, 0.001, 0.1)\n\t\t\tlocal maxStep = turnSpeed * clampedDt\n\t\t\tif math.abs(diff) <= maxStep then\n\t\t\t\tnewYaw = targetYaw\n\t\t\telse\n\t\t\t\tnewYaw = currentYaw + math.sign(diff) * maxStep\n\t\t\tend\n\t\tend\n\n\t\tlocal curVel = hrp.AssemblyLinearVelocity\n\t\thrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, newYaw, 0)\n\t\thrp.AssemblyAngularVelocity = Vector3.zero\n\t\thrp.AssemblyLinearVelocity = curVel\n\tend\n\n\treturn speedDipFactor\nend\n\nlocal function resetAllKeys()\n\tisWDown = false\n\tisSDown = false\n\tisADown = false\n\tisDDown = false\n\tisSpaceDown = false\n\tisGHeld = false\n\tgoalDirection = nil\n\tDribbleCutController.Cancel()\n\tlastCutChord = \"NONE\"\n\tlastCutInput = Vector3.zero\n\tif lastGoalIntent then\n\t\tlocal remote = getBallActionRemote()\n\t\tif remote and currentCharacter then\n\t\t\tremote:FireServer({action = \"GoalDribble\", active = false, character = currentCharacter})\n\t\tend\n\tend\n\tlastGoalIntent = false\n\tlastGoalSentTime = 0\n\tjumpBufferUntil = 0\n\tdribbleTurnFactor = 1.0\n\tcurrentChord = \"NONE\"\n\trawWorldDirection = Vector3.zero\n\tcurrentWorldDirection = Vector3.zero\n\tpublishLeanInput(Vector3.zero)\n\tnotifyMovementIntent(false, 0)\n\n\tif currentHumanoid and currentHumanoid.Parent then\n\t\tcurrentHumanoid:Move(Vector3.zero, false)\n\tend\nend\n\nlocal function onInputBegan(input: InputObject, gameProcessed: boolean)\n\tif not isActive then\n\t\treturn\n\tend\n\tif gameProcessed then\n\t\treturn\n\tend\n\n\tlocal key = input.KeyCode\n\tif key == Enum.KeyCode.W or key == Enum.KeyCode.Up then\n\t\tisWDown = true\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.S or key == Enum.KeyCode.Down then\n\t\tisSDown = true\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.A or key == Enum.KeyCode.Left then\n\t\tisADown = true\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.D or key == Enum.KeyCode.Right then\n\t\tisDDown = true\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.G then\n\t\tisGHeld = true\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.Space then\n\t\tisSpaceDown = true\n\t\tjumpBufferUntil = os.clock() + JumpConfigs.JUMP_BUFFER_WINDOW_SEC\n\tend\nend\n\nlocal function onInputEnded(input: InputObject, _gameProcessed: boolean)\n\tif not isActive then\n\t\treturn\n\tend\n\n\tlocal key = input.KeyCode\n\tif key == Enum.KeyCode.W or key == Enum.KeyCode.Up then\n\t\tisWDown = false\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.S or key == Enum.KeyCode.Down then\n\t\tisSDown = false\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.A or key == Enum.KeyCode.Left then\n\t\tisADown = false\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.D or key == Enum.KeyCode.Right then\n\t\tisDDown = false\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.G then\n\t\tisGHeld = false\n\t\tupdateMovementIntent(getCameraYaw())\n\telseif key == Enum.KeyCode.Space then\n\t\tisSpaceDown = false\n\tend\nend\n\nlocal function onMovementStep(dt: number)\n\tif not isActive then\n\t\treturn\n\tend\n\n\tif not currentHumanoid or not currentHumanoid.Parent then\n\t\treturn\n\tend\n\n\tif currentHumanoid.Health <= 0 then\n\t\treturn\n\tend\n\n\tlocal camYaw = getCameraYaw()\n\tupdateMovementIntent(camYaw)\n\n\tlocal isAirborne = checkIsAirborne()\n\tif isAirborne then\n\t\t-- Humanoid air physics must not see a non-zero MoveDirection: AirMovementController owns\n\t\t-- airborne horizontal momentum/lean. Lean intent is delivered via publishLeanInput().\n\t\tcurrentHumanoid:Move(Vector3.zero, false)\n\t\t-- Landing-edge jump buffer is preserved: do not clear jumpBufferUntil here\n\telseif isEligibleGrounded() then\n\t\t-- Grounded: 360° Analog Locomotion Facing with Turn Smoothing & Speed Dip\n\t\tlocal speedDipFactor = updateGroundedFacing(camYaw, dt)\n\t\tif goalDirection then\n\t\t\tspeedDipFactor *= math.min(1, DribbleActionConfigs.GOAL_SPEED / math.max(1, currentHumanoid.WalkSpeed))\n\t\tend\n\n\t\t-- Apply camera-relative movement direction while grounded, scaled by turn speed dip factor\n\t\tif currentWorldDirection.Magnitude > 0.001 then\n\t\t\tcurrentHumanoid:Move(currentWorldDirection * speedDipFactor, false)\n\t\telse\n\t\t\tcurrentHumanoid:Move(Vector3.zero, false)\n\t\tend\n\n\t\tlocal state = currentHumanoid:GetState()\n\t\tif state == Enum.HumanoidStateType.Jumping then\n\t\t\tjumpBufferUntil = 0\n\t\telseif (isSpaceDown or os.clock() < jumpBufferUntil)\n\t\t\tand not (currentCharacter and DribbleCutController.IsLocked(currentCharacter)) then\n\t\t\t-- A press on the Landed edge would otherwise be eaten by Landed -> Running\n\t\t\tif state == Enum.HumanoidStateType.Landed and currentHumanoid.FloorMaterial ~= Enum.Material.Air then\n\t\t\t\tcurrentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n\t\t\telse\n\t\t\t\tcurrentHumanoid.Jump = true\n\t\t\tend\n\t\tend\n\telse\n\t\t-- Unsupported state (Seated, Climbing, Swimming, Physics, Ragdoll, etc.)\n\t\t-- Hands off without forcing camera yaw or overriding native movement.\n\t\tif not currentHumanoid.AutoRotate then\n\t\t\tcurrentHumanoid.AutoRotate = true\n\t\tend\n\t\tpublishLeanInput(Vector3.zero)\n\tend\n\n\tif currentCharacter then\n\t\tcurrentCharacter:SetAttribute(\"MovePreviewActive\", true)\n\t\tcurrentCharacter:SetAttribute(\"CurrentMoveDirection\", currentWorldDirection)\n\t\tcurrentCharacter:SetAttribute(\"DesiredMoveDirection\", rawWorldDirection)\n\t\tcurrentCharacter:SetAttribute(\"LatchedMoveDirection\", currentWorldDirection)\n\n\t\t-- Report validated camera look intent when player is the active ball carrier\n\t\tif currentCharacter:GetAttribute(\"IsBallCarrier\") == true then\n\t\t\tlocal now = os.clock()\n\t\t\tif now - lastSentCameraIntent >= 0.1 then\n\t\t\t\tlastSentCameraIntent = now\n\t\t\t\tlocal camLook = Vector3.new(-math.sin(camYaw), 0, -math.cos(camYaw))\n\t\t\t\tlocal remote = getBallActionRemote()\n\t\t\t\tif remote then\n\t\t\t\t\tpcall(function()\n\t\t\t\t\t\tremote:FireServer({\n\t\t\t\t\t\t\taction = \"CameraIntent\",\n\t\t\t\t\t\t\tlookDirection = camLook,\n\t\t\t\t\t\t})\n\t\t\t\t\tend)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function setupCharacter(char: Model)\n\tcurrentCharacter = char\n\tcurrentHumanoid = char:WaitForChild(\"Humanoid\", 5.0) :: Humanoid?\n\tcurrentHrp = char:WaitForChild(\"HumanoidRootPart\", 5.0) :: BasePart?\n\n\tresetAllKeys()\n\n\tif currentHumanoid then\n\t\tcurrentHumanoid.AutoRotate = false\n\t\ttable.insert(\n\t\t\tconnections,\n\t\t\tcurrentHumanoid.Died:Connect(function()\n\t\t\t\tresetAllKeys()\n\t\t\tend)\n\t\t)\n\tend\nend\n\nlocal function suspendNativeControls()\n\ttask.spawn(function()\n\t\tlocal playerScripts = localPlayer:WaitForChild(\"PlayerScripts\", 5.0) :: PlayerScripts?\n\t\tif not playerScripts then\n\t\t\treturn\n\t\tend\n\t\tlocal playerModuleScript = playerScripts:WaitForChild(\"PlayerModule\", 5.0) :: ModuleScript?\n\t\tif not playerModuleScript then\n\t\t\treturn\n\t\tend\n\n\t\tlocal ok, PlayerModule = pcall(require, playerModuleScript)\n\t\tif ok and typeof(PlayerModule) == \"table\" and PlayerModule.GetControls then\n\t\t\tnativeControls = PlayerModule:GetControls()\n\t\t\tif nativeControls and nativeControls.Disable then\n\t\t\t\tnativeControls:Disable()\n\t\t\tend\n\t\tend\n\tend)\nend\n\nlocal function restoreNativeControls()\n\tif nativeControls and nativeControls.Enable then\n\t\tpcall(function()\n\t\t\tnativeControls:Enable()\n\t\tend)\n\tend\nend\n\nfunction MovementHeadingPreviewController.GetCurrentDirection(): Vector3\n\treturn currentWorldDirection\nend\n\nfunction MovementHeadingPreviewController.GetLatchedDirection(): Vector3\n\treturn currentWorldDirection\nend\n\nfunction MovementHeadingPreviewController.GetCurrentChord(): string\n\treturn currentChord\nend\n\nfunction MovementHeadingPreviewController.GetResolvedForward(): number\n\treturn (isWDown and 1 or 0) - (isSDown and 1 or 0)\nend\n\nfunction MovementHeadingPreviewController.IsForwardEligible(): boolean\n\treturn ((isWDown and 1 or 0) - (isSDown and 1 or 0)) > 0\nend\n\nfunction MovementHeadingPreviewController.GetDesiredDirection(): Vector3\n\treturn rawWorldDirection\nend\n\n-- Touch-phase turn gate removed (Owner 2026-10-27): turns are never gated\nfunction MovementHeadingPreviewController.IsTurnGated(): boolean\n\treturn false\nend\n\nfunction MovementHeadingPreviewController.IsActive(): boolean\n\treturn isActive\nend\n\nfunction MovementHeadingPreviewController.Init()\n\tif isInitialized then\n\t\treturn\n\tend\n\tisInitialized = true\n\n\tif not CameraPreviewConfigs.IsActiveInCurrentContext() then\n\t\treturn\n\tend\n\tif not CameraPreviewConfigs.Movement.Enabled then\n\t\treturn\n\tend\n\n\tisActive = true\n\n\t-- Suspend native PlayerModule movement so custom camera-relative movement has sole control\n\tsuspendNativeControls()\n\tlocal airCtrl = getAirMovementController()\n\tif airCtrl and airCtrl.SetLeanInputSourceEnabled then\n\t\tairCtrl.SetLeanInputSourceEnabled(true)\n\tend\n\n\t-- Input listeners\n\ttable.insert(connections, UserInputService.InputBegan:Connect(onInputBegan))\n\ttable.insert(connections, UserInputService.InputEnded:Connect(onInputEnded))\n\n\t-- Safety resets\n\ttable.insert(\n\t\tconnections,\n\t\tGuiService.MenuOpened:Connect(function()\n\t\t\tresetAllKeys()\n\t\tend)\n\t)\n\ttable.insert(\n\t\tconnections,\n\t\tUserInputService.WindowFocusReleased:Connect(function()\n\t\t\tresetAllKeys()\n\t\tend)\n\t)\n\ttable.insert(\n\t\tconnections,\n\t\tUserInputService.TextBoxFocused:Connect(function()\n\t\t\tresetAllKeys()\n\t\tend)\n\t)\n\n\t-- Pre-physics movement application\n\t-- Bound AFTER native Humanoid input (RenderPriority.Input) and BEFORE physics, so native input\n\t-- cannot reset Humanoid.Jump / Move set here.\n\tRunService:BindToRenderStep(MOVEMENT_STEP_NAME, Enum.RenderPriority.Input.Value + 5, onMovementStep)\n\n\t-- Character tracking\n\tif localPlayer.Character then\n\t\tsetupCharacter(localPlayer.Character)\n\tend\n\ttable.insert(\n\t\tconnections,\n\t\tlocalPlayer.CharacterAdded:Connect(function(newChar)\n\t\t\tsetupCharacter(newChar)\n\t\tend)\n\t)\nend\n\nfunction MovementHeadingPreviewController.Cleanup()\n\tisActive = false\n\tpcall(function()\n\t\tRunService:UnbindFromRenderStep(MOVEMENT_STEP_NAME)\n\tend)\n\n\tresetAllKeys()\n\tlocal airCtrl = getAirMovementController()\n\tif airCtrl and airCtrl.SetLeanInputSourceEnabled then\n\t\tairCtrl.SetLeanInputSourceEnabled(false)\n\tend\n\trestoreNativeControls()\n\n\tif currentHumanoid and currentHumanoid.Parent then\n\t\tcurrentHumanoid.AutoRotate = true\n\tend\n\n\tfor _, conn in ipairs(connections) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(connections)\n\n\tcurrentCharacter = nil\n\tcurrentHumanoid = nil\n\tcurrentHrp = nil\n\tnativeControls = nil\n\tballActionRemoteRef = nil\n\tlastSentCameraIntent = 0\n\tisInitialized = false\nend\n\nreturn MovementHeadingPreviewController\n"},{"disk":"src/client/init.client.luau","studioPath":["StarterPlayer","StarterPlayerScripts","Client"],"className":"LocalScript","content":"--!strict\n-- src/client/init.client.luau\n-- Client Bootstrapper: Network.Init -> R15AnimationController.Init -> CameraShiftLockController & InputController\n-- R6AnimationController preserved as inert reference; R6 controller does not compete.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal bootstrapStart = os.clock()\nlocal TOTAL_BOOTSTRAP_BUDGET = 10.0\n\nlocal remaining = TOTAL_BOOTSTRAP_BUDGET - (os.clock() - bootstrapStart)\nassert(remaining > 0, \"[Client.Init] Bootstrap deadline exhausted before waiting for Shared\")\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\", remaining) :: Folder?\nassert(Shared ~= nil, \"[Client.Init] Shared folder timed out in ReplicatedStorage\")\n\nremaining = TOTAL_BOOTSTRAP_BUDGET - (os.clock() - bootstrapStart)\nassert(remaining > 0, \"[Client.Init] Bootstrap deadline exhausted before waiting for Network\")\nlocal NetworkModule = Shared:WaitForChild(\"Network\", remaining) :: ModuleScript?\nassert(NetworkModule ~= nil, \"[Client.Init] Network module timed out in Shared\")\n\nlocal Network = require(NetworkModule)\n\n-- 1. Initialize Network client cache within total bootstrap budget (10s)\nremaining = TOTAL_BOOTSTRAP_BUDGET - (os.clock() - bootstrapStart)\nassert(remaining > 0, \"[Client.Init] Bootstrap deadline exhausted before Network.Init\")\nNetwork.Init(remaining)\n\n-- 2. Wait for character folder and R15AnimationController within remaining budget\nremaining = TOTAL_BOOTSTRAP_BUDGET - (os.clock() - bootstrapStart)\nassert(remaining > 0, \"[Client.Init] Bootstrap deadline exhausted before waiting for character folder\")\nlocal CharacterFolder = script:WaitForChild(\"character\", remaining) :: Folder?\nassert(CharacterFolder ~= nil, \"[Client.Init] character folder timed out in script\")\n\nremaining = TOTAL_BOOTSTRAP_BUDGET - (os.clock() - bootstrapStart)\nassert(remaining > 0, \"[Client.Init] Bootstrap deadline exhausted before waiting for R15AnimationController\")\nlocal ControllerModule = CharacterFolder:WaitForChild(\"R15AnimationController\", remaining) :: ModuleScript?\nassert(ControllerModule ~= nil, \"[Client.Init] R15AnimationController module timed out in character folder\")\n\nlocal R15AnimationController = require(ControllerModule)\n\n-- 3. Initialize R15 Animation Controller within remaining budget\n-- R6AnimationController preserved as inert reference; does not run concurrently.\nremaining = TOTAL_BOOTSTRAP_BUDGET - (os.clock() - bootstrapStart)\nassert(remaining > 0, \"[Client.Init] Bootstrap deadline exhausted before R15AnimationController.Init\")\nR15AnimationController.Init(remaining)\n\nlocal DribbleAnimModule = CharacterFolder:FindFirstChild(\"DribbleAnimationController\")\nif DribbleAnimModule and DribbleAnimModule:IsA(\"ModuleScript\") then\n\trequire(DribbleAnimModule).Init(remaining)\nend\n\n-- Option A Cleanup: R6ActionPoseController excised\n\n-- 4. Initialize InputController (CameraShiftLockController disabled temporarily per Owner choice; normal Roblox camera)\nremaining = TOTAL_BOOTSTRAP_BUDGET - (os.clock() - bootstrapStart)\nif remaining > 0 then\n\tlocal ControllersFolder = script:FindFirstChild(\"controllers\")\n\tif ControllersFolder and ControllersFolder:IsA(\"Folder\") then\n\t\t-- CameraShiftLockController preserved as inert reference; not initialized (normal camera temporarily)\n\n\t\tlocal InputCtrlModule = ControllersFolder:FindFirstChild(\"InputController\")\n\t\tlocal dribblePresentation = ControllersFolder:FindFirstChild(\"DribblePresentationController\")\n\t\tif dribblePresentation and dribblePresentation:IsA(\"ModuleScript\") then\n\t\t\trequire(dribblePresentation).Init()\n\t\tend\n\t\tif InputCtrlModule and InputCtrlModule:IsA(\"ModuleScript\") then\n\t\t\tlocal InputController = require(InputCtrlModule)\n\t\t\tInputController.Init()\n\t\tend\n\n\t\tlocal SprintCtrlModule = ControllersFolder:FindFirstChild(\"SprintController\")\n\t\tif SprintCtrlModule and SprintCtrlModule:IsA(\"ModuleScript\") then\n\t\t\tlocal SprintController = require(SprintCtrlModule)\n\t\t\tSprintController.Init()\n\t\tend\n\n\t\tlocal AirMovementModule = ControllersFolder:FindFirstChild(\"AirMovementController\")\n\t\tif AirMovementModule and AirMovementModule:IsA(\"ModuleScript\") then\n\t\t\tlocal AirMovementController = require(AirMovementModule)\n\t\t\tAirMovementController.Init()\n\t\tend\n\n\t\t-- Option A Cleanup: TrainingHUD is inert reference material; not initialized\n\tend\nend\n\n-- 5. Initialize CameraPreviewController & MovementHeadingPreviewController (Studio-only prototype for Owner review)\ntask.spawn(function()\n\tlocal SharedConfigs = Shared:WaitForChild(\"configs\", 5.0) :: Folder?\n\tlocal CamPreviewConfigModule = SharedConfigs and SharedConfigs:WaitForChild(\"CameraPreviewConfigs\", 5.0) :: ModuleScript?\n\tif CamPreviewConfigModule and CamPreviewConfigModule:IsA(\"ModuleScript\") then\n\t\tlocal CameraPreviewConfigs = require(CamPreviewConfigModule)\n\t\tif CameraPreviewConfigs.IsActiveInCurrentContext() then\n\t\t\tlocal ControllersFolder = script:WaitForChild(\"controllers\", 5.0) :: Folder?\n\t\t\tif ControllersFolder and ControllersFolder:IsA(\"Folder\") then\n\t\t\t\tlocal CamPreviewModule = ControllersFolder:WaitForChild(\"CameraPreviewController\", 5.0) :: ModuleScript?\n\t\t\t\tlocal MovePreviewModule = ControllersFolder:WaitForChild(\"MovementHeadingPreviewController\", 5.0) :: ModuleScript?\n\t\t\t\tif CamPreviewModule and CamPreviewModule:IsA(\"ModuleScript\") and MovePreviewModule and MovePreviewModule:IsA(\"ModuleScript\") then\n\t\t\t\t\tlocal CameraPreviewController = require(CamPreviewModule)\n\t\t\t\t\tlocal MovementHeadingPreviewController = require(MovePreviewModule)\n\t\t\t\t\tCameraPreviewController.Init()\n\t\t\t\t\tMovementHeadingPreviewController.Init()\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend)\n"},{"disk":"src/server/services/BallService.luau","studioPath":["ServerScriptService","Server","services","BallService"],"className":"ModuleScript","content":"--!strict\n-- src/server/services/BallService.luau\n-- Module 02: Server-Authoritative Ball Physics, Lifecycle & Ground Dribble/Receive\n-- Governed by RF02-DRIBBLE-RECEIVE Contract (Owner Checklist 7, 2026-10-27 Authoritative Grill Final)\n-- Server-authoritative custom position/velocity physics solver with bounded touch impulses,\n-- proximity/relative-speed receive gates, deterministic contention resolution, honest contact windows,\n-- 360 movement lead tracking, forward radial micro-touches (zero lateral sway), real ball rolling,\n-- and one-shot Jump Self-Lob (Scoop) with atomic server possession release and brief recapture protection.\n-- NO welds, NO attachments, NO teleport/snap follow, NO visual Touched dependencies.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Constants = require(Shared:WaitForChild(\"Constants\"))\nlocal Types = require(Shared:WaitForChild(\"Types\"))\nlocal Configs = Shared:WaitForChild(\"configs\")\nlocal DribbleConfigs = require(Configs:WaitForChild(\"DribbleConfigs\"))\nlocal JumpConfigs = require(Configs:WaitForChild(\"JumpConfigs\"))\nlocal DribbleGeometryHelper = require(Shared:WaitForChild(\"DribbleGeometryHelper\"))\nlocal DribbleControlRules = require(Shared:WaitForChild(\"DribbleControlRules\"))\nlocal DribbleActionConfigs = require(Configs:WaitForChild(\"DribbleActionConfigs\"))\nlocal SprintConfigs = require(Configs:WaitForChild(\"SprintConfigs\"))\nlocal Network = require(Shared:WaitForChild(\"Network\"))\n\nlocal Services = script.Parent\nlocal CagePhysicsService = require(Services:WaitForChild(\"CagePhysicsService\"))\n\nlocal BALL_PART_NAME = Constants.BALL_PART_NAME or \"CageMatchBall\"\n\nlocal ballState = {\n\tballId = \"BALL_01\",\n\tposition = Constants.BALL_SPAWN_POSITION or Vector3.new(0, Constants.BALL_RADIUS, 0),\n\tvelocity = Vector3.zero,\n\tstate = \"Free\" :: Types.BallPossessionState,\n\tpossessorUserId = nil :: number?,\n\tlastPossessingTeam = nil :: Types.TeamSide?,\n\tlastKickerUserId = nil :: number?,\n\tlastKickTime = 0,\n\tcurveImpulse = nil :: Vector3?,\n\tinFlightAction = nil :: Types.KickActionType?,\n}\n\nexport type PlayerMovementState = {\n\tuserId: number,\n\tteamSide: Types.TeamSide,\n}\n\nexport type TouchInfo = {\n\ttouchId: number,\n\townerUserId: number?,\n\ttouchTime: number,\n\taction: string,\n\ttouchCount: number,\n}\n\nlocal lastTouchInfo: TouchInfo = {\n\ttouchId = 0,\n\townerUserId = nil,\n\ttouchTime = 0,\n\taction = \"None\",\n\ttouchCount = 0,\n}\n\nlocal freeBallOnlyOverride: boolean? = nil\nlocal playerStates: { [number]: PlayerMovementState } = {}\nlocal lastTouchTimeByPlayer: { [number]: number } = {}\nlocal lastStealTimeByPlayer: { [number]: number } = {}\nlocal blockedStealPairs: { [number]: { [number]: boolean } } = {}\nlocal lastPlayerPositions: { [number]: Vector3 } = {}\nlocal playerGenerations: { [number]: number } = {}\nlocal activeCharacterConnections: { [number]: { RBXScriptConnection } } = {}\nlocal ballPart: Part? = nil\nlocal ballSpinRotation: CFrame = CFrame.identity\nlocal isInitialized = false\nlocal currentDribblePhase: string = \"Free\"\nlocal currentDribbleSpeedFactor: number = 1.0\nlocal controlledCarrierRoot: BasePart? = nil\nlocal previousPossessorUserId: number? = nil\n\n-- Jump Self-Lob state tracking\nlocal lastLobTimeByPlayer: { [number]: number } = {}\nlocal lastLobCarrierUserId: number? = nil\nlocal lobDischargedThisJump: { [number]: boolean } = {}\nlocal lastCameraLookByPlayer: { [number]: Vector3 } = {}\nlocal lastIntentTimeByPlayer: { [number]: number } = {}\nlocal goalDribbleRequests: {[number]: {character: Model, expires: number, lastStart: number}} = {}\nlocal lastGoalStartByPlayer: {[number]: number} = {}\nlocal dribbleTouchIntents: {[number]: {character: Model, foot: string, clip: string, isCut: boolean, startTime: number, expires: number}} = {}\nlocal lastDribbleTouchByPlayer: {[number]: number} = {}\n\nlocal BallService = {}\n\nlocal function applyGoalDribbleMode(player: Player, character: Model, humanoid: Humanoid)\n\tlocal request = goalDribbleRequests[player.UserId]\n\tlocal state = humanoid:GetState()\n\tlocal active = request ~= nil and request.character == character and request.expires > os.clock()\n\t\tand humanoid.Health > 0 and humanoid.FloorMaterial ~= Enum.Material.Air\n\t\tand (state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.RunningNoPhysics or state == Enum.HumanoidStateType.Landed)\n\tlocal wasActive = character:GetAttribute(\"GoalDribbleActive\") == true\n\tcharacter:SetAttribute(\"GoalDribbleActive\", active)\n\tif active then\n\t\thumanoid.WalkSpeed = DribbleActionConfigs.GOAL_SPEED\n\t\tcharacter:SetAttribute(\"IsSprinting\", false)\n\telseif wasActive then\n\t\thumanoid.WalkSpeed = if character:GetAttribute(\"IsSprinting\") == true then SprintConfigs.SPRINT_SPEED else SprintConfigs.NORMAL_WALK_SPEED\n\tend\nend\n\nfunction BallService.SetGoalDribbleIntent(player: Player, payload: any): boolean\n\tif typeof(payload) ~= \"table\" or typeof(payload.active) ~= \"boolean\" then return false end\n\tlocal character = player.Character\n\tif not character or payload.character ~= character or not character:IsDescendantOf(Workspace) then return false end\n\tlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\tif not humanoid or humanoid.Health <= 0 then return false end\n\tif payload.active then\n\t\tlocal now = os.clock()\n\t\tlocal lastStart = lastGoalStartByPlayer[player.UserId]\n\t\tif lastStart and now - lastStart < DribbleActionConfigs.INTENT_INTERVAL * 0.5 then return false end\n\t\tlastGoalStartByPlayer[player.UserId] = now\n\t\tgoalDribbleRequests[player.UserId] = {character = character, expires = now + DribbleActionConfigs.GOAL_INTENT_TIMEOUT, lastStart = now}\n\telse\n\t\t-- Stops are always accepted for the current character; never rate-limited.\n\t\tgoalDribbleRequests[player.UserId] = nil\n\tend\n\tapplyGoalDribbleMode(player, character, humanoid)\n\treturn true\nend\n\nfunction BallService.SetDribbleTouchIntent(player: Player, payload: any): boolean\n\tif typeof(payload) ~= \"table\" then return false end\n\tif payload.foot ~= \"L\" and payload.foot ~= \"R\" then return false end\n\tif typeof(payload.clip) ~= \"string\" or not DribbleActionConfigs.IsRecognizedClipName(payload.clip) then return false end\n\tlocal character = player.Character\n\tif not character or payload.character ~= character or not character:IsDescendantOf(Workspace) then return false end\n\tif ballState.state ~= \"Possessed\" or ballState.possessorUserId ~= player.UserId then return false end\n\tlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\tif not humanoid or humanoid.Health <= 0 or humanoid.FloorMaterial == Enum.Material.Air then return false end\n\tlocal state = humanoid:GetState()\n\tif state ~= Enum.HumanoidStateType.Running and state ~= Enum.HumanoidStateType.RunningNoPhysics and state ~= Enum.HumanoidStateType.Landed then\n\t\treturn false\n\tend\n\tif DribbleActionConfigs.IsGoalModeClipName(payload.clip) and character:GetAttribute(\"GoalDribbleActive\") ~= true then\n\t\treturn false\n\tend\n\tlocal now = os.clock()\n\tlocal lastTime = lastDribbleTouchByPlayer[player.UserId]\n\tif lastTime and (now - lastTime) < DribbleActionConfigs.TOUCH_INTENT_COOLDOWN_SEC then\n\t\treturn false\n\tend\n\tlastDribbleTouchByPlayer[player.UserId] = now\n\tdribbleTouchIntents[player.UserId] = {\n\t\tcharacter = character,\n\t\tfoot = payload.foot,\n\t\tclip = payload.clip,\n\t\tisCut = payload.isCut == true,\n\t\tstartTime = now,\n\t\texpires = now + DribbleActionConfigs.TOUCH_PULSE_DURATION_SEC,\n\t}\n\tcharacter:SetAttribute(\"ServerDribbleTouchFoot\", payload.foot)\n\tcharacter:SetAttribute(\"ServerDribbleTouchClip\", payload.clip)\n\tif ballPart then\n\t\tballPart:SetAttribute(\"LastDribbleTouchFoot\", payload.foot)\n\t\tballPart:SetAttribute(\"LastDribbleTouchClip\", payload.clip)\n\tend\n\treturn true\nend\n\nlocal function setStealPairBlocked(firstUserId: number, secondUserId: number, blocked: boolean)\n\tlocal firstPairs = blockedStealPairs[firstUserId]\n\tlocal secondPairs = blockedStealPairs[secondUserId]\n\tif blocked then\n\t\tif not firstPairs then\n\t\t\tfirstPairs = {}\n\t\t\tblockedStealPairs[firstUserId] = firstPairs\n\t\tend\n\t\tif not secondPairs then\n\t\t\tsecondPairs = {}\n\t\t\tblockedStealPairs[secondUserId] = secondPairs\n\t\tend\n\t\tfirstPairs[secondUserId] = true\n\t\tsecondPairs[firstUserId] = true\n\t\treturn\n\tend\n\n\tif firstPairs then\n\t\tfirstPairs[secondUserId] = nil\n\t\tif next(firstPairs) == nil then\n\t\t\tblockedStealPairs[firstUserId] = nil\n\t\tend\n\tend\n\tif secondPairs then\n\t\tsecondPairs[firstUserId] = nil\n\t\tif next(secondPairs) == nil then\n\t\t\tblockedStealPairs[secondUserId] = nil\n\t\tend\n\tend\nend\n\nlocal function clearStealPairsForPlayer(userId: number)\n\tlocal otherPairs = blockedStealPairs[userId]\n\tblockedStealPairs[userId] = nil\n\tif otherPairs then\n\t\tfor otherUserId in otherPairs do\n\t\t\tlocal pairsForOther = blockedStealPairs[otherUserId]\n\t\t\tif pairsForOther then\n\t\t\t\tpairsForOther[userId] = nil\n\t\t\t\tif next(pairsForOther) == nil then\n\t\t\t\t\tblockedStealPairs[otherUserId] = nil\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function getOrCreatePlayerState(userId: number): PlayerMovementState\n\tlocal st = playerStates[userId]\n\tif st then\n\t\treturn st\n\tend\n\tlocal team: Types.TeamSide = if (userId % 2 == 0) then \"South\" else \"North\"\n\tlocal newState: PlayerMovementState = {\n\t\tuserId = userId,\n\t\tteamSide = team,\n\t}\n\tplayerStates[userId] = newState\n\treturn newState\nend\n\nlocal function syncBallAttributes()\n\tif not ballPart then\n\t\treturn\n\tend\n\tballPart:SetAttribute(\"BallState\", ballState.state)\n\tballPart:SetAttribute(\"PossessorUserId\", ballState.possessorUserId or 0)\n\tballPart:SetAttribute(\"LastPossessingTeam\", ballState.lastPossessingTeam or \"\")\n\tballPart:SetAttribute(\"BallVelocity\", ballState.velocity)\n\tballPart:SetAttribute(\"BallPosition\", ballState.position)\n\tballPart:SetAttribute(\"LastTouchAction\", lastTouchInfo.action)\n\tballPart:SetAttribute(\"LastTouchTime\", lastTouchInfo.touchTime)\n\tballPart:SetAttribute(\"TouchCount\", lastTouchInfo.touchCount)\n\tballPart:SetAttribute(\"DribblePhase\", currentDribblePhase)\n\n\tlocal curUid = ballState.possessorUserId\n\tif curUid ~= previousPossessorUserId then\n\t\tif previousPossessorUserId ~= nil then\n\t\t\tlocal prevPlayer = Players:GetPlayerByUserId(previousPossessorUserId)\n\t\t\tlocal prevChar = prevPlayer and prevPlayer.Character\n\t\t\tif prevChar then\n\t\t\t\tprevChar:SetAttribute(\"IsBallCarrier\", false)\n\t\t\t\tprevChar:SetAttribute(\"DribblePhase\", \"Free\")\n\t\t\t\tprevChar:SetAttribute(\"DribbleSpeedFactor\", 1.0)\n\t\t\tend\n\t\tend\n\t\tpreviousPossessorUserId = curUid\n\tend\n\n\tif ballState.state ~= \"Possessed\" then\n\t\tcurrentDribbleSpeedFactor = 1.0\n\tend\n\n\tif curUid ~= nil then\n\t\tlocal curPlayer = Players:GetPlayerByUserId(curUid)\n\t\tlocal curChar = curPlayer and curPlayer.Character\n\t\tif curChar then\n\t\t\tcurChar:SetAttribute(\"IsBallCarrier\", true)\n\t\t\tcurChar:SetAttribute(\"DribblePhase\", currentDribblePhase)\n\t\t\tcurChar:SetAttribute(\"DribbleSpeedFactor\", currentDribbleSpeedFactor)\n\t\tend\n\tend\nend\n\nfunction BallService.EnsureBallInstance(): Part\n\tif ballPart and ballPart.Parent ~= nil then\n\t\tballPart.Size = Vector3.new(Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2)\n\t\treturn ballPart\n\tend\n\tlocal existing = Workspace:FindFirstChild(BALL_PART_NAME)\n\tif existing and existing:IsA(\"Part\") then\n\t\texisting.Material = Enum.Material.SmoothPlastic\n\t\texisting.Size = Vector3.new(Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2)\n\t\tballPart = existing\n\t\treturn existing\n\tend\n\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = BALL_PART_NAME\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.new(Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2)\n\tp.Color = Color3.fromRGB(245, 250, 255)\n\tp.Material = Enum.Material.SmoothPlastic\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanTouch = false\n\tp.CanQuery = false\n\tp.CFrame = CFrame.new(ballState.position)\n\tp:SetAttribute(\"IsMatchBall\", true)\n\tp.Parent = Workspace\n\tballPart = p\n\tsyncBallAttributes()\n\treturn p\nend\n\nfunction BallService.GetBallState(): Types.BallSnapshot\n\treturn {\n\t\tballId = ballState.ballId,\n\t\tposition = ballState.position,\n\t\tvelocity = ballState.velocity,\n\t\tstate = ballState.state,\n\t\tpossessorUserId = ballState.possessorUserId,\n\t\tlastPossessingTeam = ballState.lastPossessingTeam,\n\t\tlastKickerUserId = ballState.lastKickerUserId,\n\t\tcurveImpulse = nil,\n\t\tinFlightAction = nil,\n\t}\nend\n\nBallService.GetBallSnapshot = BallService.GetBallState\n\nfunction BallService.SetBallPositionAndVelocity(pos: Vector3, vel: Vector3)\n\tballState.position = pos\n\tballState.velocity = vel\n\tballState.state = \"Free\"\n\tballState.possessorUserId = nil\n\tballState.inFlightAction = nil\n\tballState.curveImpulse = nil\n\ttable.clear(blockedStealPairs)\n\tif not ballPart or ballPart.Parent == nil then\n\t\tBallService.EnsureBallInstance()\n\tend\n\tif ballPart then\n\t\tballPart.CFrame = CFrame.new(pos)\n\tend\n\tsyncBallAttributes()\nend\n\nfunction BallService.SetPossessor(userId: number?)\n\tif userId ~= nil then\n\t\tlocal st = getOrCreatePlayerState(userId)\n\t\tballState.possessorUserId = userId\n\t\tballState.state = \"Possessed\"\n\t\tballState.lastPossessingTeam = st.teamSide\n\t\tcurrentDribblePhase = \"Contact\"\n\t\tlastTouchInfo.touchId += 1\n\t\tlastTouchInfo.ownerUserId = userId\n\t\tlastTouchInfo.touchTime = os.clock()\n\t\tlastTouchInfo.action = \"DirectSet\"\n\t\tlastTouchInfo.touchCount += 1\n\telse\n\t\tballState.possessorUserId = nil\n\t\tballState.state = \"Free\"\n\t\tcurrentDribblePhase = \"Free\"\n\tend\n\tsyncBallAttributes()\nend\n\nfunction BallService.GetPossessorUserId(): number?\n\treturn ballState.possessorUserId\nend\n\nfunction BallService.GetLastPossessingTeam(): Types.TeamSide?\n\treturn ballState.lastPossessingTeam\nend\n\nfunction BallService.SetPlayerTeamSide(userId: number, teamSide: Types.TeamSide)\n\tlocal st = getOrCreatePlayerState(userId)\n\tst.teamSide = teamSide\n\tlocal player = Players:GetPlayerByUserId(userId)\n\tif player and player.Character then\n\t\tplayer.Character:SetAttribute(\"AttackGoalPosition\", DribbleControlRules.AttackGoal(teamSide, Constants.ARENA_HALF_LENGTH_Z, Constants.GOAL_BACK_ZONE_STUDS))\n\tend\nend\n\nfunction BallService.GetPlayerTeamSide(userId: number): Types.TeamSide\n\treturn getOrCreatePlayerState(userId).teamSide\nend\n\nfunction BallService.SetFreeBallOnly(enabled: boolean)\n\tfreeBallOnlyOverride = enabled\n\t-- RF-F31: FreeBallOnly explicitly revokes active possession immediately\n\tif enabled and ballState.possessorUserId ~= nil then\n\t\tballState.possessorUserId = nil\n\t\tballState.state = \"Free\"\n\t\tsyncBallAttributes()\n\tend\nend\n\nfunction BallService.IsFreeBallOnly(): boolean\n\tif freeBallOnlyOverride ~= nil then\n\t\treturn freeBallOnlyOverride\n\tend\n\treturn DribbleConfigs.FREE_BALL_ONLY_MODE\nend\n\nfunction BallService.GetLastTouchInfo(): TouchInfo\n\treturn {\n\t\ttouchId = lastTouchInfo.touchId,\n\t\townerUserId = lastTouchInfo.ownerUserId,\n\t\ttouchTime = lastTouchInfo.touchTime,\n\t\taction = lastTouchInfo.action,\n\t\ttouchCount = lastTouchInfo.touchCount,\n\t}\nend\n\nfunction BallService.ResetBall(customPos: Vector3?, initialPossessingTeam: Types.TeamSide?)\n\tlocal spawnPos = customPos or Constants.BALL_SPAWN_POSITION or Vector3.new(0, Constants.BALL_RADIUS, 0)\n\tballState.position = spawnPos\n\tballState.velocity = Vector3.zero\n\tballState.state = \"Free\"\n\tballState.possessorUserId = nil\n\tballState.lastPossessingTeam = initialPossessingTeam\n\tballState.lastKickerUserId = nil\n\tballState.lastKickTime = 0\n\tballState.curveImpulse = nil\n\tballState.inFlightAction = nil\n\tballSpinRotation = CFrame.identity\n\ttable.clear(blockedStealPairs)\n\ttable.clear(lastLobTimeByPlayer)\n\ttable.clear(lobDischargedThisJump)\n\ttable.clear(lastCameraLookByPlayer)\n\ttable.clear(lastIntentTimeByPlayer)\n\tlastLobCarrierUserId = nil\n\n\tlastTouchInfo.touchId += 1\n\tlastTouchInfo.ownerUserId = nil\n\tlastTouchInfo.touchTime = os.clock()\n\tlastTouchInfo.action = \"ResetBall\"\n\n\tif not ballPart or ballPart.Parent == nil then\n\t\tBallService.EnsureBallInstance()\n\tend\n\tif ballPart then\n\t\tballPart.Size = Vector3.new(Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2, Constants.BALL_RADIUS * 2)\n\t\tballPart.CFrame = CFrame.new(spawnPos)\n\tend\n\tsyncBallAttributes()\nend\n\n-- Camera look intent setter (from network remote or tests)\nfunction BallService.SetCameraLookIntent(userId: number, lookDir: Vector3)\n\tlocal hDir = Vector3.new(lookDir.X, 0, lookDir.Z)\n\tlocal mag = hDir.Magnitude\n\tif mag > 1e-4 and mag == mag and mag < math.huge then\n\t\tlastCameraLookByPlayer[userId] = hDir / mag\n\tend\nend\n\nfunction BallService.GetLastLobInfo(): { time: number, carrierUserId: number? }\n\treturn {\n\t\ttime = if lastLobCarrierUserId ~= nil then (lastLobTimeByPlayer[lastLobCarrierUserId] or 0) else 0,\n\t\tcarrierUserId = lastLobCarrierUserId,\n\t}\nend\n\n-- =============================================================================\n-- Jump Self-Lob (Scoop): Triggered by successful upward jump while carrier\n-- =============================================================================\nfunction BallService.TriggerSelfLob(player: Player, hrp: BasePart, humanoid: Humanoid): boolean\n\tif not DribbleConfigs.SELF_LOB_ENABLED then\n\t\treturn false\n\tend\n\tlocal uid = player.UserId\n\tif ballState.state ~= \"Possessed\" or ballState.possessorUserId ~= uid then\n\t\treturn false\n\tend\n\tif lobDischargedThisJump[uid] then\n\t\treturn false\n\tend\n\tlobDischargedThisJump[uid] = true\n\n\tlocal cVel = hrp.AssemblyLinearVelocity\n\tlocal horizVel = Vector3.new(cVel.X, 0, cVel.Z)\n\tlocal isMoving = horizVel.Magnitude > DribbleConfigs.MIN_PLAYER_MOVE_SPEED\n\n\tlocal launchDir: Vector3\n\tif isMoving then\n\t\t-- Verified horizontal movement snapshot\n\t\tlaunchDir = horizVel.Unit\n\telse\n\t\t-- Stationary: horizontal CAMERA look (fallback to body look if none)\n\t\tlocal camLook = lastCameraLookByPlayer[uid]\n\t\tif camLook and camLook.Magnitude > 0.01 then\n\t\t\tlaunchDir = camLook\n\t\telse\n\t\t\tlocal look = hrp.CFrame.LookVector\n\t\t\tlaunchDir = Vector3.new(look.X, 0, look.Z).Unit\n\t\tend\n\tend\n\n\tlocal lobVel = DribbleGeometryHelper.ComputeSelfLobVelocity(launchDir, cVel, isMoving)\n\tlocal sep = DribbleGeometryHelper.GetCarrierSeparationDistance()\n\tlocal launchPos = Vector3.new(hrp.Position.X, ballState.position.Y, hrp.Position.Z) + launchDir * sep\n\n\tlocal r = DribbleConfigs.BALL_COLLISION_RADIUS\n\tlocal mx = Constants.ARENA_HALF_WIDTH_X - r\n\tlocal mz = Constants.ARENA_HALF_LENGTH_Z - r\n\tlaunchPos = Vector3.new(math.clamp(launchPos.X, -mx, mx), launchPos.Y, math.clamp(launchPos.Z, -mz, mz))\n\n\tlocal now = os.clock()\n\tballState.position = launchPos\n\tballState.velocity = lobVel\n\tballState.state = \"Free\"\n\tballState.possessorUserId = nil\n\tcurrentDribblePhase = \"Free\"\n\n\tlastLobTimeByPlayer[uid] = now\n\tlastLobCarrierUserId = uid\n\n\tlastTouchInfo.touchId += 1\n\tlastTouchInfo.ownerUserId = uid\n\tlastTouchInfo.touchTime = now\n\tlastTouchInfo.action = \"SelfLob\"\n\tlastTouchInfo.touchCount += 1\n\n\tsyncBallAttributes()\n\treturn true\nend\n\n-- =============================================================================\n-- Ground Dribble & Receive Simulation (RF02-DRIBBLE-RECEIVE)\n-- =============================================================================\ntype PlayerCandidate = {\n\tplayer: Player,\n\tcharacter: Model,\n\thumanoid: Humanoid,\n\trootPart: BasePart,\n\tuserId: number,\n\tteamSide: Types.TeamSide,\n\tdist: number,\n\trelSpeed: number,\n\tisGrounded: boolean,\n\tvertGap: number,\n}\n\nlocal lastActiveCarrierCand: PlayerCandidate? = nil\nlocal carrierPrevRootPos: { [number]: Vector3 } = {}\n\n-- RF-F33: Strict transitive total order comparator\n-- Guarantees mathematically strict weak ordering with zero pairwise cycles across all permutations.\nlocal function compareCandidates(a: PlayerCandidate, b: PlayerCandidate): boolean\n\tif a.dist ~= b.dist then\n\t\treturn a.dist < b.dist\n\tend\n\treturn a.userId < b.userId\nend\n\nlocal function simulateDribbleAndReceive(dt: number, now: number)\n\tcontrolledCarrierRoot = nil\n\tlastActiveCarrierCand = nil\n\tif BallService.IsFreeBallOnly() then\n\t\treturn\n\tend\n\n\t-- 1. Candidate gathering and Teleport/Dead Carrier verification\n\tlocal candidates: { PlayerCandidate } = {}\n\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tlocal char = player.Character\n\t\tif char and char:IsDescendantOf(game) then\n\t\t\tlocal hum = char:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tlocal root = char:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\n\t\t\tif hum and hum.Health > 0 and root then\n\t\t\t\tlocal uid = player.UserId\n\n\t\t\t\t-- Teleport detection: sudden jump exceeding threshold revokes possession immediately\n\t\t\t\tlocal lastPos = lastPlayerPositions[uid]\n\t\t\t\tlocal invalidMovement = false\n\t\t\t\tif lastPos and (root.Position - lastPos).Magnitude > DribbleConfigs.MAX_TELEPORT_DISPLACEMENT then\n\t\t\t\t\tinvalidMovement = true\n\t\t\t\t\tif ballState.possessorUserId == uid then\n\t\t\t\t\t\tballState.possessorUserId = nil\n\t\t\t\t\t\tballState.state = \"Free\"\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tlastPlayerPositions[uid] = root.Position\n\t\t\t\tif invalidMovement then\n\t\t\t\t\t-- Revoke and skip this sample so a teleported player cannot reacquire this tick.\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\n\t\t\t\tlocal hState = hum:GetState()\n\t\t\t\tlocal isGrounded = hum.FloorMaterial ~= Enum.Material.Air\n\t\t\t\t\tand (\n\t\t\t\t\t\thState == Enum.HumanoidStateType.Running\n\t\t\t\t\t\t\tor hState == Enum.HumanoidStateType.RunningNoPhysics\n\t\t\t\t\t\t\tor hState == Enum.HumanoidStateType.Landed\n\t\t\t\t\t)\n\n\t\t\t\tlocal feetY = root.Position.Y - DribbleConfigs.PLAYER_FEET_OFFSET\n\t\t\t\tlocal vertGap = math.abs(ballState.position.Y - feetY)\n\t\t\t\tlocal horizDiff = Vector3.new(ballState.position.X - root.Position.X, 0, ballState.position.Z - root.Position.Z)\n\t\t\t\tlocal dist = horizDiff.Magnitude\n\t\t\t\tlocal pVel = root.AssemblyLinearVelocity\n\t\t\t\tlocal relSpeed = (ballState.velocity - pVel).Magnitude\n\t\t\t\tlocal team = getOrCreatePlayerState(uid).teamSide\n\n\t\t\t\ttable.insert(candidates, {\n\t\t\t\t\tplayer = player,\n\t\t\t\t\tcharacter = char,\n\t\t\t\t\thumanoid = hum,\n\t\t\t\t\trootPart = root,\n\t\t\t\t\tuserId = uid,\n\t\t\t\t\tteamSide = team,\n\t\t\t\t\tdist = dist,\n\t\t\t\t\trelSpeed = relSpeed,\n\t\t\t\t\tisGrounded = isGrounded,\n\t\t\t\t\tvertGap = vertGap,\n\t\t\t\t})\n\t\t\tend\n\t\tend\n\tend\n\n\t-- 2. State: FREE -> Check Reception Gate\n\tif ballState.state == \"Free\" then\n\t\tlocal eligibleReceivers: { PlayerCandidate } = {}\n\n\t\tfor _, cand in ipairs(candidates) do\n\t\t\t-- Former owner lob recapture protection guard\n\t\t\tlocal isFormerLobOwner = (cand.userId == lastLobCarrierUserId)\n\t\t\tlocal inLobCooldown = isFormerLobOwner\n\t\t\t\tand ((now - (lastLobTimeByPlayer[cand.userId] or 0)) < DribbleConfigs.SELF_LOB_RECAPTURE_COOLDOWN_SEC)\n\t\t\tif inLobCooldown then\n\t\t\t\tcontinue\n\t\t\tend\n\n\t\t\tlocal passGrounded = if DribbleConfigs.PLAYER_GROUNDED_REQUIRED then cand.isGrounded else true\n\t\t\tlocal passBallGrounded = ballState.position.Y <= DribbleConfigs.GROUNDED_MAX_BALL_Y\n\t\t\tlocal passVert = cand.vertGap <= DribbleConfigs.MAX_RECEIVE_VERTICAL_GAP\n\t\t\tlocal passDist = cand.dist <= DribbleConfigs.MAX_RECEIVE_DISTANCE\n\t\t\tlocal passSpeed = cand.relSpeed <= DribbleConfigs.MAX_RECEIVE_RELATIVE_SPEED\n\n\t\t\tif passGrounded and passBallGrounded and passVert and passDist and passSpeed then\n\t\t\t\ttable.insert(eligibleReceivers, cand)\n\t\t\tend\n\t\tend\n\n\t\tif #eligibleReceivers > 0 then\n\t\t\t-- RF-F33: Strict total order sort\n\t\t\ttable.sort(eligibleReceivers, compareCandidates)\n\n\t\t\tlocal winner = eligibleReceivers[1]\n\t\t\tlastActiveCarrierCand = winner\n\t\t\tballState.possessorUserId = winner.userId\n\t\t\tballState.state = \"Possessed\"\n\t\t\tballState.lastPossessingTeam = winner.teamSide\n\t\t\tcurrentDribblePhase = \"Contact\"\n\n\t\t\tlastTouchTimeByPlayer[winner.userId] = now\n\t\t\tlastTouchInfo.touchId += 1\n\t\t\tlastTouchInfo.ownerUserId = winner.userId\n\t\t\tlastTouchInfo.touchTime = now\n\t\t\tlastTouchInfo.action = \"Receive\"\n\t\t\tlastTouchInfo.touchCount += 1\n\n\t\t\t-- Reception cushion: guide ball along receiver's movement heading\n\t\t\tlocal moveDir = winner.humanoid.MoveDirection\n\t\t\tlocal forward = if moveDir.Magnitude > DribbleConfigs.TARGET_DIRECTION_THRESHOLD\n\t\t\t\tthen moveDir.Unit\n\t\t\t\telse Vector3.new(winner.rootPart.CFrame.LookVector.X, 0, winner.rootPart.CFrame.LookVector.Z).Unit\n\t\t\tlocal rootVelocity = winner.rootPart.AssemblyLinearVelocity\n\t\t\tlocal horizontalSpeed = Vector3.new(rootVelocity.X, 0, rootVelocity.Z).Magnitude\n\t\t\tlocal pSpeed = math.min(horizontalSpeed, DribbleConfigs.MAX_RECEIVE_CUSHION_SPEED)\n\t\t\tlocal initialLeadSpeed = math.max(pSpeed * 1.25, DribbleConfigs.MIN_RECEIVE_CUSHION_SPEED)\n\t\t\tballState.velocity = forward * initialLeadSpeed\n\t\t\tsyncBallAttributes()\n\t\t\treturn\n\t\tend\n\tend\n\n\t-- 3. State: POSSESSED -> Carrier validity, Opponent Steal, and Honest Touch Rhythm\n\tif ballState.state == \"Possessed\" then\n\t\tlocal currentCarrierId = ballState.possessorUserId\n\t\tlocal carrierCand: PlayerCandidate? = nil\n\n\t\tfor _, cand in ipairs(candidates) do\n\t\t\tif cand.userId == currentCarrierId then\n\t\t\t\tcarrierCand = cand\n\t\t\t\tlastActiveCarrierCand = carrierCand\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\n\t\t-- Carrier no longer valid (died, disconnected, or missing root part)\n\t\tif not carrierCand then\n\t\t\tlastActiveCarrierCand = nil\n\t\t\tballState.possessorUserId = nil\n\t\t\tballState.state = \"Free\"\n\t\t\tcurrentDribblePhase = \"Free\"\n\t\t\tsyncBallAttributes()\n\t\t\treturn\n\t\tend\n\n\t\t-- Check if carrier launched into an upward jump (authoritative liftoff detection)\n\t\tlocal cVel = carrierCand.rootPart.AssemblyLinearVelocity\n\t\tif not carrierCand.isGrounded and cVel.Y > DribbleConfigs.SELF_LOB_MIN_TAKEOFF_VY and not lobDischargedThisJump[currentCarrierId] then\n\t\t\tlocal scooped = BallService.TriggerSelfLob(carrierCand.player, carrierCand.rootPart, carrierCand.humanoid)\n\t\t\tif scooped then\n\t\t\t\treturn\n\t\t\tend\n\t\tend\n\n\t\t-- Check if ball got away (Loose Ball trigger: distance exceeds LOOSE_BALL_DISTANCE)\n\t\tif carrierCand.dist > DribbleConfigs.LOOSE_BALL_DISTANCE then\n\t\t\tlastActiveCarrierCand = nil\n\t\t\tballState.possessorUserId = nil\n\t\t\tballState.state = \"Free\"\n\t\t\tcurrentDribblePhase = \"Free\"\n\t\t\tsyncBallAttributes()\n\t\t\treturn\n\t\tend\n\n\t\t-- RF-F32: Opponent Interception / Steal with Team Check, Contest Cooldown & Valid Contact Gate\n\t\tlocal opponentsInStealRange: { PlayerCandidate } = {}\n\t\tfor _, cand in ipairs(candidates) do\n\t\t\tif cand.userId ~= currentCarrierId then\n\t\t\t\t-- Teammate Policy: Players on the same team cannot steal from each other\n\t\t\t\tlocal isTeammate = (carrierCand.teamSide ~= nil and cand.teamSide ~= nil and cand.teamSide == carrierCand.teamSide)\n\t\t\t\tif not isTeammate then\n\t\t\t\t\t-- Contest Debounce: Dispossessed player cannot immediately re-steal on adjacent frames\n\t\t\t\t\tlocal pairDistance = (cand.rootPart.Position - carrierCand.rootPart.Position).Magnitude\n\t\t\t\t\tlocal pairBlocked = blockedStealPairs[cand.userId] ~= nil\n\t\t\t\t\t\tand blockedStealPairs[cand.userId][currentCarrierId] == true\n\t\t\t\t\tif pairBlocked and pairDistance > DribbleConfigs.STEAL_REENTRY_DISTANCE then\n\t\t\t\t\t\tsetStealPairBlocked(cand.userId, currentCarrierId, false)\n\t\t\t\t\t\tpairBlocked = false\n\t\t\t\t\tend\n\n\t\t\t\t\tlocal lastSteal = lastStealTimeByPlayer[cand.userId] or 0\n\t\t\t\t\tif not pairBlocked and (now - lastSteal) >= DribbleConfigs.STEAL_CONTEST_COOLDOWN_SEC then\n\t\t\t\t\t\t-- Full Valid Contact Gate for Stealer\n\t\t\t\t\t\tlocal passGrounded = if DribbleConfigs.PLAYER_GROUNDED_REQUIRED then cand.isGrounded else true\n\t\t\t\t\t\tlocal passBallGrounded = ballState.position.Y <= DribbleConfigs.GROUNDED_MAX_BALL_Y\n\t\t\t\t\t\tlocal passVert = cand.vertGap <= DribbleConfigs.MAX_RECEIVE_VERTICAL_GAP\n\t\t\t\t\t\tlocal passStealDist = cand.dist <= DribbleConfigs.STEAL_INTERCEPT_DISTANCE\n\t\t\t\t\t\tlocal passSpeed = cand.relSpeed <= DribbleConfigs.MAX_RECEIVE_RELATIVE_SPEED\n\n\t\t\t\t\t\tif passGrounded and passBallGrounded and passVert and passStealDist and passSpeed then\n\t\t\t\t\t\t\ttable.insert(opponentsInStealRange, cand)\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif #opponentsInStealRange > 0 then\n\t\t\t-- RF-F33: Strict total order resolution for Steal\n\t\t\ttable.sort(opponentsInStealRange, compareCandidates)\n\n\t\t\tlocal stealer = opponentsInStealRange[1]\n\t\t\tlastActiveCarrierCand = stealer\n\t\t\tballState.possessorUserId = stealer.userId\n\t\t\tballState.lastPossessingTeam = stealer.teamSide\n\t\t\t-- Lock every opposing player already engaged in this close contest until\n\t\t\t-- they separate, preventing multi-player overlap from rotating possession.\n\t\t\tfor _, engagedCand in ipairs(candidates) do\n\t\t\t\tlocal isOpponent = engagedCand.teamSide ~= stealer.teamSide\n\t\t\t\tlocal isClose = (engagedCand.rootPart.Position - stealer.rootPart.Position).Magnitude\n\t\t\t\t\t<= DribbleConfigs.STEAL_REENTRY_DISTANCE\n\t\t\t\tif engagedCand.userId ~= stealer.userId and isOpponent and isClose then\n\t\t\t\t\tsetStealPairBlocked(engagedCand.userId, stealer.userId, true)\n\t\t\t\tend\n\t\t\tend\n\n\t\t\t-- Cool down both contest participants; the pair remains locked until separation.\n\t\t\tlastStealTimeByPlayer[currentCarrierId] = now\n\t\t\tlastStealTimeByPlayer[stealer.userId] = now\n\t\t\tlastTouchTimeByPlayer[stealer.userId] = now\n\t\t\tlastTouchInfo.touchId += 1\n\t\t\tlastTouchInfo.ownerUserId = stealer.userId\n\t\t\tlastTouchInfo.touchTime = now\n\t\t\tlastTouchInfo.action = \"Steal\"\n\t\t\tlastTouchInfo.touchCount += 1\n\n\t\t\tlocal moveDir = stealer.humanoid.MoveDirection\n\t\t\tlocal forward = if moveDir.Magnitude > DribbleConfigs.TARGET_DIRECTION_THRESHOLD\n\t\t\t\tthen moveDir.Unit\n\t\t\t\telse Vector3.new(stealer.rootPart.CFrame.LookVector.X, 0, stealer.rootPart.CFrame.LookVector.Z).Unit\n\t\t\tlocal rootVelocity = stealer.rootPart.AssemblyLinearVelocity\n\t\t\tlocal horizontalSpeed = Vector3.new(rootVelocity.X, 0, rootVelocity.Z).Magnitude\n\t\t\tlocal pSpeed = math.min(horizontalSpeed, DribbleConfigs.MAX_RECEIVE_CUSHION_SPEED)\n\t\t\tballState.velocity = forward * math.max(pSpeed, DribbleConfigs.MIN_STEAL_CUSHION_SPEED)\n\t\t\tsyncBallAttributes()\n\t\t\treturn\n\t\tend\n\n\t\t-- RF-F31: Require Real Contact Window for Carrier Touches & Cushion Damping\n\t\t-- If ball is outside contact range (e.g. 4.5 < dist <= 7.5 or ball overhead/high),\n\t\t-- carrier retains possession state but CANNOT touch or damp the ball!\n\t\t-- Ball continues traveling freely under autonomous physics solver.\n\t\tlocal carrierInContact = carrierCand.isGrounded\n\t\t\tand (ballState.position.Y <= DribbleConfigs.GROUNDED_MAX_BALL_Y)\n\t\t\tand (carrierCand.vertGap <= DribbleConfigs.MAX_RECEIVE_VERTICAL_GAP)\n\t\t\tand (carrierCand.dist <= DribbleConfigs.MAX_RECEIVE_DISTANCE)\n\n\t\tif not carrierInContact then\n\t\t\t-- Out of physical contact window: preserve free physics flight/roll without modification\n\t\t\treturn\n\t\tend\n\n\t\t-- Continuous front-foot control for valid current grounded carrier:\n\t\t-- 1. Moving: lead follows horizontal MoveDirection, independent of body/camera.\n\t\t-- 2. Idle: lead smoothly settles to body LookVector front.\n\t\t-- 3. Speed-related forward radial micro-touches (zero lateral sway).\n\t\tlocal isSprinting = (carrierCand.character:GetAttribute(\"IsSprinting\") == true)\n\t\tlocal moveDir = carrierCand.humanoid.MoveDirection\n\t\tlocal horizMove = Vector3.new(moveDir.X, 0, moveDir.Z)\n\t\tlocal isMoving = horizMove.Magnitude > DribbleConfigs.MOVE_DIRECTION_THRESHOLD\n\t\t-- Replicated velocity remains available when server Humanoid input is stale.\n\t\tif not isMoving then\n\t\t\tlocal velocityDirection = Vector3.new(cVel.X, 0, cVel.Z)\n\t\t\tif velocityDirection.Magnitude > DribbleConfigs.MIN_PLAYER_MOVE_SPEED then\n\t\t\t\thorizMove = velocityDirection.Unit\n\t\t\t\tisMoving = true\n\t\t\tend\n\t\tend\n\t\tlocal leadDir: Vector3\n\t\tif isMoving then\n\t\t\tleadDir = horizMove.Unit\n\t\telse\n\t\t\tlocal look = carrierCand.rootPart.CFrame.LookVector\n\t\t\tleadDir = Vector3.new(look.X, 0, look.Z).Unit\n\t\tend\n\n\t\tlocal cSpeed = Vector3.new(cVel.X, 0, cVel.Z).Magnitude\n\t\tlocal goalMode = carrierCand.character:GetAttribute(\"GoalDribbleActive\") == true\n\t\tlocal touchIntent = dribbleTouchIntents[currentCarrierId]\n\t\tlocal markerPulse = 0.0\n\t\tif touchIntent and touchIntent.character == carrierCand.character and touchIntent.expires > now then\n\t\t\tlocal progress = math.clamp((now - touchIntent.startTime) / DribbleActionConfigs.TOUCH_PULSE_DURATION_SEC, 0, 1)\n\t\t\tlocal boost = if goalMode\n\t\t\t\tthen DribbleActionConfigs.TOUCH_PULSE_BOOST_GOAL\n\t\t\t\telseif touchIntent.isCut then DribbleActionConfigs.TOUCH_PULSE_BOOST_CUT\n\t\t\t\telseif isSprinting then DribbleActionConfigs.TOUCH_PULSE_BOOST_RUN\n\t\t\t\telse DribbleActionConfigs.TOUCH_PULSE_BOOST_WALK\n\t\t\tmarkerPulse = boost * math.sin(progress * math.pi)\n\t\tend\n\t\tlocal hasRecentMarker = touchIntent ~= nil\n\t\t\tand touchIntent.character == carrierCand.character\n\t\t\tand (now - touchIntent.startTime) <= 0.65\n\t\tlocal microOffset = if goalMode\n\t\t\tthen 0\n\t\t\telseif hasRecentMarker then markerPulse\n\t\t\telse DribbleGeometryHelper.ComputeMicroTouchOffset(cSpeed, isSprinting, now)\n\t\tif goalMode then\n\t\t\tlocal goal = DribbleControlRules.AttackGoal(carrierCand.teamSide, Constants.ARENA_HALF_LENGTH_Z, Constants.GOAL_BACK_ZONE_STUDS)\n\t\t\tif goal then\n\t\t\t\tleadDir = DribbleControlRules.HorizontalDirection(goal - carrierCand.rootPart.Position)\n\t\t\tend\n\t\tend\n\n\t\tlocal target, flankDeg, infeasible = DribbleGeometryHelper.FeasibleFrontTarget(\n\t\t\tcarrierCand.rootPart.Position,\n\t\t\tleadDir,\n\t\t\tisSprinting,\n\t\t\tmicroOffset\n\t\t)\n\t\tif goalMode then\n\t\t\t-- Reuse the same joint-safe target search, with a close-control radius + bounded marker pulse.\n\t\t\tlocal baseDistance = if isSprinting then DribbleConfigs.FRONT_DISTANCE_SPRINT else DribbleConfigs.FRONT_DISTANCE_WALK\n\t\t\ttarget, flankDeg, infeasible = DribbleGeometryHelper.FeasibleFrontTarget(\n\t\t\t\tcarrierCand.rootPart.Position, leadDir, isSprinting,\n\t\t\t\t(DribbleActionConfigs.GOAL_BALL_DISTANCE - baseDistance) + markerPulse)\n\t\tend\n\t\tlocal v = DribbleGeometryHelper.ComputeFrontVelocity(\n\t\t\tcarrierCand.rootPart.Position,\n\t\t\tcVel,\n\t\t\tballState.position,\n\t\t\ttarget,\n\t\t\tdt\n\t\t)\n\t\tballState.velocity = Vector3.new(v.X, 0, v.Z)\n\t\tcurrentDribblePhase = \"Control\"\n\t\tcontrolledCarrierRoot = carrierCand.rootPart\n\t\tlastTouchInfo.action = \"DribbleControl\"\n\t\tif infeasible then\n\t\t\tcurrentDribbleSpeedFactor = DribbleConfigs.INFEASIBLE_SPEED_FACTOR\n\t\telseif flankDeg > DribbleConfigs.BLOCKED_FLANK_ANGLE_DEG then\n\t\t\tcurrentDribbleSpeedFactor = DribbleConfigs.BLOCKED_SPEED_FACTOR\n\t\telse\n\t\t\tcurrentDribbleSpeedFactor = 1.0\n\t\tend\n\tend\nend\n-- =============================================================================\n-- Autonomous Ball Physics & Trajectory Stepping\n-- =============================================================================\nfunction BallService.StepPhysics(dt: number)\n\t-- Clamp delta time to guard against physics explosion spikes\n\tlocal clampedDt = math.clamp(dt, 0.001, DribbleConfigs.MAX_DT_SIMULATION)\n\tlocal now = os.clock()\n\t-- Mode expiry must also run in free-ball-only mode, where receive simulation\n\t-- deliberately returns early. Otherwise a lost release packet could leave speed capped.\n\tfor uid, request in goalDribbleRequests do\n\t\tlocal player = Players:GetPlayerByUserId(uid)\n\t\tlocal hum = request.character:FindFirstChildOfClass(\"Humanoid\")\n\t\tif player and player.Character == request.character and hum then\n\t\t\tapplyGoalDribbleMode(player, request.character, hum)\n\t\tend\n\t\tif not player or player.Character ~= request.character or request.expires <= now then\n\t\t\tgoalDribbleRequests[uid] = nil\n\t\tend\n\tend\n\n\t-- 1. Server-authoritative Dribble & Receive simulation\n\tsimulateDribbleAndReceive(clampedDt, now)\n\n\t-- 2. Physical flight, Cage collision, and Turf rolling friction\n\tlocal r = Constants.BALL_RADIUS\n\tlocal isOnRamp = CagePhysicsService.IsPositionOnElevatingRamp(ballState.position)\n\tlocal onGround = not isOnRamp and (ballState.position.Y <= r + 0.08) and (math.abs(ballState.velocity.Y) < 3.0)\n\n\tlocal currentVel = ballState.velocity\n\tif onGround then\n\t\t-- Suppress downward velocity when resting on turf\n\t\tcurrentVel = Vector3.new(currentVel.X, 0, currentVel.Z)\n\t\tballState.position = Vector3.new(ballState.position.X, r, ballState.position.Z)\n\telse\n\t\t-- Baseline gravity\n\t\tlocal effGravity = Constants.GRAVITY_ACCELERATION_Y\n\t\tcurrentVel = currentVel + Vector3.new(0, effGravity * clampedDt, 0)\n\t\tcurrentVel = currentVel * math.max(0.0, 1.0 - (0.20 * clampedDt))\n\tend\n\n\tlocal prevPos = ballState.position\n\tlocal nextPos, nextVel = CagePhysicsService.StepBallCageCollision(prevPos, currentVel, clampedDt)\n\n\t-- Turf contact & rolling friction\n\tif onGround or (not isOnRamp and nextPos.Y <= (r + 0.08)) then\n\t\tif nextVel.Y > 1.5 then\n\t\t\t-- Preserve upward bounce velocity from floor collision\n\t\telseif nextVel.Y < -3.5 then\n\t\t\t-- High downward velocity before bounce sub-step\n\t\telse\n\t\t\t-- Low vertical velocity: settle cleanly on turf\n\t\t\tnextPos = Vector3.new(nextPos.X, r, nextPos.Z)\n\t\t\tnextVel = Vector3.new(nextVel.X, 0, nextVel.Z)\n\t\tend\n\n\t\tlocal rollFriction = Constants.GROUND_ROLLING_FRICTION\n\t\tlocal frictionDecel = math.max(0.0, 1.0 - (rollFriction * clampedDt))\n\t\tnextVel = Vector3.new(nextVel.X * frictionDecel, nextVel.Y, nextVel.Z * frictionDecel)\n\n\t\tif nextVel.Magnitude < Constants.BALL_REST_THRESHOLD_SPEED then\n\t\t\tnextVel = Vector3.zero\n\t\t\tnextPos = Vector3.new(nextPos.X, r, nextPos.Z)\n\t\tend\n\tend\n\n\t-- Joint swept body + cage clearance for the CURRENT valid carrier only (RF-F51)\n\tlocal carrierCand = lastActiveCarrierCand\n\tif\n\t\tcarrierCand\n\t\tand ballState.state == \"Possessed\"\n\t\tand ballState.possessorUserId == carrierCand.userId\n\t\tand carrierCand.rootPart.Parent\n\tthen\n\t\tlocal hrp = carrierCand.rootPart\n\t\tlocal p1 = hrp.Position\n\t\tlocal p0 = carrierPrevRootPos[carrierCand.userId] or p1\n\t\tcarrierPrevRootPos[carrierCand.userId] = p1\n\t\tlocal look = hrp.CFrame.LookVector\n\t\tlocal sepPos, sepVel, _adjusted, infeasible = DribbleGeometryHelper.ResolveBodyCage(\n\t\t\tp0,\n\t\t\tp1,\n\t\t\tprevPos,\n\t\t\tnextPos,\n\t\t\tnextVel,\n\t\t\thrp.AssemblyLinearVelocity,\n\t\t\tclampedDt,\n\t\t\tVector3.new(look.X, 0, look.Z)\n\t\t)\n\t\tnextPos = sepPos\n\t\tnextVel = sepVel\n\t\tif in